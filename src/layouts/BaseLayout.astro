---
import '../input.css';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import AmbientSubstrate from '../components/telemetry/AmbientSubstrate.astro';
import GutterArbor from '../components/telemetry/GutterArbor.astro';

interface Props {
  title: string;
  description?: string;
  theme?: 'light' | 'dark';
}

const {
  title,
  description = "Product Designer & NeuroHCI Researcher specializing in neural interfaces, biosignal computing (EEG/EMG), and high-complexity human-system operational workflows.",
  theme = 'light'
} = Astro.props;

const isDark = theme === 'dark';
const canonicalUrl = new URL(Astro.url.pathname, 'https://meghan.in').href;
const ogImageUrl = 'https://meghan.in/assets/og-image.png';
---

<!doctype html>
<html lang="en" class={isDark ? 'dark scroll-smooth' : 'scroll-smooth'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon: Santiago Ramón y Cajal Pyramidal Neuron -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Open Graph (LinkedIn, iMessage, Slack, Facebook) -->
    <meta property="og:site_name" content="Meghan Lendhe" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Meghan Lendhe: Product Designer & NeuroHCI Researcher" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=JetBrains+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&display=swap" rel="stylesheet" />
    <script is:inline>
      const loadClarity = () => {
        (function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y)})(window,document,"clarity","script","yfijkirjjz");
      };
      if ('requestIdleCallback' in window) {
        requestIdleCallback(loadClarity, { timeout: 3000 });
      } else {
        window.addEventListener('load', loadClarity, { once: true });
      }
    </script>
  </head>
  <body class={isDark ? "bg-[#111215] text-neutral-100 font-sans selection:bg-amber-400/20 selection:text-amber-200 antialiased" : "bg-neutral-50 text-black font-sans antialiased"}>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-black focus:text-white focus:px-4 focus:py-2 focus:outline-2 focus:outline-secondary">Skip to main content</a>
    
    <!-- Luminous Porcelain Gallery Substrate -->
    <AmbientSubstrate theme={theme} />

    <!-- Peaceful Gutter Neural Arbor & Living Drift (Strictly outside content column) -->
    <GutterArbor theme={theme} />

    <Navbar theme={theme} />
    <div aria-hidden="true" class="h-8 md:h-12"></div>
    <slot />
    <Footer theme={theme} />

    <!-- Shared Micro-Acoustics, Global Dendritic Cursor & Tactile Interactions -->
    <script is:inline src="/assets/js/neuro-audio.js"></script>
    <script is:inline src="/assets/js/dendritic-cursor.js"></script>
    <script is:inline src="/assets/js/contact.js"></script>

    <script is:inline>
      // Action-Potential Cursor Tracking on Underlines (Desktop fine pointer only)
      if (window.matchMedia && window.matchMedia('(pointer: fine)').matches) {
        document.addEventListener('pointermove', (e) => {
          const link = e.target && e.target.closest && e.target.closest('.action-potential-link');
          if (link) {
            const rect = link.getBoundingClientRect();
            const x = Math.max(0, Math.min(rect.width, e.clientX - rect.left));
            link.style.setProperty('--pulse-x', `${x}px`);
          }
        }, { passive: true });
      }
    </script>
  </body>
</html>
