---
import '../input.css';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';

interface Props {
  title: string;
  includeCaseStudyScript?: boolean;
  theme?: 'light' | 'dark';
}

const { title, includeCaseStudyScript = false, theme = 'light' } = Astro.props;
const isDark = theme === 'dark';
---

<!doctype html>
<html lang="en" class={isDark ? 'dark scroll-smooth' : 'scroll-smooth'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Libre+Franklin:wght@100..900&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&display=swap" rel="stylesheet" />
    <script is:inline>
      (function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y)})(window,document,"clarity","script","yfijkirjjz");
    </script>
  </head>
  <body class={isDark ? "bg-[#111215] text-neutral-100 font-sans selection:bg-amber-400/20 selection:text-amber-200 antialiased" : "bg-neutral-50 text-black font-sans antialiased"}>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-black focus:text-white focus:px-4 focus:py-2 focus:outline-2 focus:outline-secondary">Skip to main content</a>
    <Navbar theme={theme} />
    <div aria-hidden="true" class="h-8 md:h-12"></div>
    <slot />
    <Footer theme={theme} />
    <script is:inline src="/assets/js/contact.js"></script>
    {includeCaseStudyScript && <script is:inline src="/assets/js/case-study.js"></script>}
  </body>
</html>
