---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChapterMarker from '../components/case-study/ChapterMarker.astro';
import StepEyebrow from '../components/case-study/StepEyebrow.astro';
import Vitrine from '../components/case-study/Vitrine.astro';
import Caption from '../components/case-study/Caption.astro';
import BrowserFrame from '../components/case-study/BrowserFrame.astro';
import PhoneFrame from '../components/case-study/PhoneFrame.astro';
import RestingRule from '../components/case-study/RestingRule.astro';
---

<BaseLayout title="BulkMagic — Streamlining Multi-State Seller Onboarding" theme="light" includeCaseStudyScript>

<main id="main" class="relative max-w-page mx-auto px-6 md:px-16 lg:px-20 pb-72 pt-20 md:pt-32 font-sans text-neutral-800 selection:bg-amber-500/20 selection:text-neutral-900">

  <!-- HERO SECTION: Grounded Headline & Sprint Scope -->
  <section class="mb-32 md:mb-44 relative">
    <div class="max-w-6xl mb-16">
      <h1 class="font-serif text-5xl sm:text-7xl lg:text-[6.25rem] font-normal leading-[0.94] tracking-[-0.04em] text-neutral-950 mb-10 text-balance">
        Designing Multi-State Merchant Onboarding.
      </h1>
      <p class="text-2xl sm:text-3xl text-neutral-800 font-normal leading-snug tracking-tight mb-12 max-w-[50ch]">
        Simplifying legal compliance so new merchants can get approved and start selling, fast.
      </p>

      <div class="grid grid-cols-1 lg:grid-cols-[1.3fr_0.7fr] gap-12 lg:gap-24 items-start pt-6 border-t border-neutral-200">
        <div>
          <p class="text-xl sm:text-2xl text-neutral-800 font-normal leading-[1.75] max-w-[52ch] text-pretty">
            To get merchants selling quickly, onboarding needs to respect their time. In a rapid day-and-a-half sprint, I designed an adaptive onboarding flow that asks only for what is necessary for a seller's business structure, supports multi-session document collection, and built an AI-assisted prototype to validate the interaction model.
          </p>
        </div>

        <!-- Margin Ledger: Pure High-Signal Coordinates (Zero Redundancy) -->
        <div class="lg:pt-2 pl-0 lg:pl-10">
          <dl class="space-y-5 text-xs font-mono">
            <div>
              <dt class="text-neutral-500 text-[10px] tracking-[0.22em] uppercase mb-1 font-medium">MY ROLE</dt>
              <dd class="text-neutral-950 text-sm font-medium">Product &amp; Interaction Designer</dd>
            </div>
            <div>
              <dt class="text-neutral-500 text-[10px] tracking-[0.22em] uppercase mb-1 font-medium">DELIVERABLES</dt>
              <dd class="text-neutral-950 text-sm font-medium">Compliance Architecture &amp; AI-Generated Prototype</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>

    <!-- Hero Stepped Interaction Spread: 3-Stage Progression in Vitrine -->
    <div class="relative overflow-hidden pt-12">
      <Vitrine>
        <div
          id="hero-panorama-track"
          class="w-full overflow-x-auto lg:overflow-visible no-scrollbar flex items-center justify-start lg:justify-center gap-5 sm:gap-7 lg:gap-9 px-6 sm:px-10 lg:px-16 py-8 sm:py-12 lg:py-14 select-none"
        >
          <!-- Stage 01: Entity Classification -->
          <div class="flex-none w-[260px] sm:w-[280px] lg:w-[290px]">
            <PhoneFrame>
              <img
                src="/assets/bulkmagic/screen-business-type.png"
                alt="Entity classification screen asking for business structure"
                class="w-full h-auto block"
                loading="eager"
              />
            </PhoneFrame>
          </div>

          <!-- Stage 02: Adaptive Document Readiness -->
          <div class="flex-none w-[260px] sm:w-[280px] lg:w-[290px]">
            <PhoneFrame>
              <img
                src="/assets/bulkmagic/screen-checklist.png"
                alt="Adaptive document readiness checklist tailored to selected entity"
                class="w-full h-auto block"
                loading="eager"
              />
            </PhoneFrame>
          </div>

          <!-- Stage 03: Field-Level Validation & Submission -->
          <div class="flex-none w-[260px] sm:w-[280px] lg:w-[290px]">
            <PhoneFrame>
              <img
                src="/assets/bulkmagic/screen-ein-validation.png"
                alt="Field-level inline validation catching syntax errors immediately"
                class="w-full h-auto block"
                loading="eager"
              />
            </PhoneFrame>
          </div>
        </div>
      </Vitrine>
      <Caption>
        The 3-stage adaptive onboarding progression: business entity classification, dynamic document readiness checklist, and real-time inline compliance validation.
      </Caption>
    </div>
  </section>

  <!-- Architectural Section Divider -->
  <RestingRule class="mb-24 md:mb-36" />

  <!-- SECTION 01: SPRINT CONTEXT & COMPLIANCE ARCHITECTURE -->
  <section class="pt-8 pb-8 mb-36 md:mb-52">
    <ChapterMarker number="01" title="The Compliance Problem" class="mb-12" />

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1fr] gap-12 lg:gap-20 items-start">
      <div class="space-y-6">
        <h2 class="font-serif text-3xl sm:text-5xl text-neutral-950 leading-[1.08] tracking-tight font-normal text-balance">
          Different businesses require different rules.
        </h2>
        <p class="text-lg sm:text-xl text-neutral-700 font-normal leading-relaxed max-w-[54ch]">
          A sole proprietor selling handmade goods from one state faces radically different statutory requirements than a multi-state LLC with inventory in three fulfillment centers. Standard onboarding forms fail because they treat every merchant identically—bombarding sole proprietors with irrelevant tax questions while leaving enterprise sellers confused about physical versus economic nexus obligations.
        </p>
      </div>

      <!-- Architectural Rule Ledger -->
      <div class="border border-neutral-200/80 bg-neutral-100/50 p-6 sm:p-8 rounded-xs space-y-6">
        <div class="text-[10px] font-mono tracking-widest text-neutral-500 uppercase font-medium">
          Adaptive Rule Engine · Logic Matrix
        </div>
        <dl class="space-y-4 text-xs font-mono">
          <div class="border-b border-neutral-200/60 pb-3">
            <dt class="text-neutral-900 font-semibold mb-1">SOLE PROPRIETOR</dt>
            <dd class="text-neutral-600">SSN or single EIN · Basic home state business license · Single tax nexus confirmation</dd>
          </div>
          <div class="border-b border-neutral-200/60 pb-3">
            <dt class="text-neutral-900 font-semibold mb-1">DOMESTIC LLC / CORP</dt>
            <dd class="text-neutral-600">Federal EIN · Articles of Organization · Operating agreement · State sales tax permits per nexus</dd>
          </div>
          <div>
            <dt class="text-neutral-900 font-semibold mb-1">MULTI-STATE ENTERPRISE</dt>
            <dd class="text-neutral-600">Physical warehouse nexus declarations · Economic nexus threshold trackers · Resale exemptions</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Architectural Section Divider -->
  <RestingRule class="mb-24 md:mb-36" />

  <!-- SECTION 02: THE ADAPTIVE WALKTHROUGH -->
  <section class="pt-8 pb-8 mb-36 md:mb-52">
    <ChapterMarker number="02" title="The Adaptive Flow" class="mb-12" />

    <div class="space-y-32 md:space-y-44">
      
      <!-- STEP 01: PROGRESSIVE ENTITY CLASSIFICATION -->
      <article class="space-y-8">
        <div class="max-w-3xl space-y-4">
          <div class="space-y-2">
            <StepEyebrow number="01" />
            <h3 class="text-3xl font-serif text-neutral-950 font-normal">
              Progressive Entity Classification
            </h3>
          </div>
          <p class="text-lg sm:text-xl text-neutral-700 font-normal leading-relaxed max-w-[54ch]">
            By identifying the seller's legal structure upfront—sole proprietorship, LLC, or corporation—the interface prunes irrelevant tax schedules and questions before the merchant even encounters them.
          </p>
        </div>

        <figure>
          <BrowserFrame url="marketplace.com/seller-onboarding/entity-type">
            <img
              src="/assets/bulkmagic/entity-selection.png"
              alt="Entity classification selection interface with clear explanations of required tax documents"
              class="w-full h-auto block select-none"
              loading="lazy"
            />
          </BrowserFrame>
          <Caption>
            Clear entity radio cards with inline explanations of required documentation allow merchants to self-identify accurately.
          </Caption>
        </figure>
      </article>

      <!-- STEP 02: ADAPTIVE DOCUMENT READINESS CHECKLIST -->
      <article class="space-y-8">
        <div class="max-w-3xl space-y-4">
          <div class="space-y-2">
            <StepEyebrow number="02" />
            <h3 class="text-3xl font-serif text-neutral-950 font-normal">
              A Transparent Checklist Supporting Multi-Session Progress
            </h3>
          </div>
          <p class="text-lg sm:text-xl text-neutral-700 font-normal leading-relaxed max-w-[54ch]">
            Sellers rarely have every tax certificate or resale permit on hand right away. Instead of surprising them mid-flow with unexpected file requests, a structured checklist outlines the required documents, clearly tracks validation status (Ready, Pending, Missing), and lets sellers save and return across multiple sessions without losing progress.
          </p>
        </div>

        <figure>
          <BrowserFrame url="marketplace.com/seller-onboarding/documents">
            <img
              src="/assets/bulkmagic/document-checklist.png"
              alt="Dynamic document checklist adapting in real time to entity type and location"
              class="w-full h-auto block select-none"
              loading="lazy"
            />
          </BrowserFrame>
          <Caption>
            The adaptive document readiness checklist tracks real-time validation status (Ready, Pending, Missing) and supports multi-session completion.
          </Caption>
        </figure>
      </article>

      <!-- STEP 03: FIELD VALIDATION & ERROR PREVENTION -->
      <article class="space-y-8">
        <div class="max-w-3xl space-y-4">
          <div class="space-y-2">
            <StepEyebrow number="03" />
            <h3 class="text-3xl font-serif text-neutral-950 font-normal">
              Field-Level Validation to Catch Errors at the Source
            </h3>
          </div>
          <p class="text-lg sm:text-xl text-neutral-700 font-normal leading-relaxed max-w-[54ch]">
            Rather than letting typos in tax IDs or misformatted bank details trigger failed submissions days later, form fields validate syntax and formatting as the seller types. Clear inline prompts guide corrections immediately, ensuring the application is clean before final submission.
          </p>
        </div>

        <figure>
          <BrowserFrame url="marketplace.com/seller-onboarding/tax-nexus">
            <img
              src="/assets/bulkmagic/automated-validation.png"
              alt="Real-time inline syntax validation and economic nexus threshold checks"
              class="w-full h-auto block select-none"
              loading="lazy"
            />
          </BrowserFrame>
          <Caption>
            Inline field validation catches formatting errors and syntax mistakes as sellers type, preventing downstream application rejection.
          </Caption>
        </figure>
      </article>

      <!-- STEP 04: TRANSPARENT REVIEW & ACTIVATION -->
      <article class="space-y-8">
        <div class="max-w-3xl space-y-4">
          <div class="space-y-2">
            <StepEyebrow number="04" />
            <h3 class="text-3xl font-serif text-neutral-950 font-normal">
              In-Place Edits Before Final Activation
            </h3>
          </div>
          <p class="text-lg sm:text-xl text-neutral-700 font-normal leading-relaxed max-w-[54ch]">
            A single summary screen confirms registered details, tax nexuses, and bank payout information in a clean ledger. Sellers can edit details directly in place without clicking "back" through multiple screens, leading immediately into active selling.
          </p>
        </div>

        <figure>
          <BrowserFrame url="marketplace.com/seller-onboarding/activation">
            <img
              src="/assets/bulkmagic/onboarding-success.png"
              alt="Account activation confirmation and success screen"
              class="w-full h-auto block select-none"
              loading="lazy"
            />
          </BrowserFrame>
          <Caption>
            A single summary ledger enables in-place edits before activation, eliminating multi-screen back-navigation.
          </Caption>
        </figure>
      </article>

    </div>
  </section>

  <!-- Architectural Section Divider -->
  <RestingRule class="mb-24 md:mb-36" />

  <!-- SECTION 03: SPRINT REFLECTION -->
  <section class="pt-8 pb-8 mb-36 md:mb-48 relative overflow-hidden">
    <ChapterMarker number="03" title="Sprint Reflection" />

    <div class="max-w-4xl space-y-6">
      <h2 class="font-serif text-4xl sm:text-6xl text-neutral-950 leading-[1.05] tracking-tight font-normal text-balance">
        Rapid prototyping as a compliance stress-test.
      </h2>
      <div class="text-neutral-700 font-normal text-lg leading-[1.8] max-w-[54ch]">
        <p class="text-xl text-neutral-950 font-normal leading-relaxed">
          In a 36-hour sprint, generating a functional prototype allowed me to stress-test statutory edge cases and validate state transitions without waiting weeks for backend infrastructure. Moving toward production would focus on testing document drop-off with active merchants across multi-session collection flows.
        </p>
      </div>
    </div>
  </section>

  <!-- CHAPTER NAVIGATION -->
  <section class="pt-16 border-t border-neutral-200">
    <div class="flex flex-col sm:flex-row items-baseline justify-between gap-12 font-mono text-xs">
      <a href="/vitals" class="group flex flex-col gap-2 transition-luxury">
        <span class="text-[10px] tracking-widest uppercase text-neutral-600 group-hover:text-amber-800 font-medium">← PREVIOUS CASE STUDY</span>
        <span class="font-serif text-2xl font-normal text-neutral-950 group-hover:text-amber-800">Vitals: Digital Medical ID</span>
        <span class="font-sans text-xs text-neutral-600 font-normal">Overcoming the 92% drop-off barrier through trust-first onboarding</span>
      </a>

      <a href="/omara" class="group flex flex-col gap-2 sm:text-right transition-luxury">
        <span class="text-[10px] tracking-widest uppercase text-neutral-600 group-hover:text-amber-800 font-medium">NEXT CASE STUDY →</span>
        <span class="font-serif text-2xl font-normal text-neutral-950 group-hover:text-amber-800">Omara: GovTech Systems</span>
        <span class="font-sans text-xs text-neutral-600 font-normal">Caseworker triage portal &amp; agentic design-system verification</span>
      </a>
    </div>
  </section>

</main>

<script is:inline>
  // Hero Panorama Track Drag-to-Scroll
  function initPanoramaDrag() {
    const track = document.getElementById('hero-panorama-track');
    if (!track) return;
    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;

    track.addEventListener('mousedown', (e) => {
      isDown = true;
      track.classList.add('cursor-grabbing');
      track.classList.remove('cursor-grab');
      startX = e.pageX - track.offsetLeft;
      scrollLeft = track.scrollLeft;
    });

    window.addEventListener('mouseup', () => {
      if (!isDown) return;
      isDown = false;
      track.classList.remove('cursor-grabbing');
      track.classList.add('cursor-grab');
    });

    track.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - track.offsetLeft;
      const walk = (x - startX) * 1.6;
      track.scrollLeft = scrollLeft - walk;
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    initPanoramaDrag();
  });
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initPanoramaDrag();
  }
</script>

</BaseLayout>
