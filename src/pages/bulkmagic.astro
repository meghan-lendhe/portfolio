---
import BaseLayout from '../layouts/BaseLayout.astro';
import source from '../content/bulkmagic.html?raw';

const main = source.match(new RegExp('<main[\\s\\S]*?</main>'))?.[0].replaceAll('assets/', '/assets/') ?? '';
---

<BaseLayout title="BulkMagic — Seller Onboarding" includeCaseStudyScript>
  <Fragment set:html={main} />
</BaseLayout>
