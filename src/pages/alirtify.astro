---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Alirtify — Designing a Data-Driven UX for News Validation" theme="light" includeCaseStudyScript>
<!-- Luminous Gallery Atmosphere: Layered Warm Ambient Gradients -->
<div class="fixed inset-0 pointer-events-none -z-20 bg-[#FAF9F5]"></div>
<div class="fixed inset-0 pointer-events-none -z-20 bg-[radial-gradient(ellipse_75%_55%_at_70%_10%,rgba(217,119,6,0.045),transparent_65%)]"></div>
<div class="fixed inset-0 pointer-events-none -z-20 bg-[radial-gradient(ellipse_60%_45%_at_15%_25%,rgba(13,148,136,0.035),transparent_60%)]"></div>
<div class="fixed inset-0 pointer-events-none -z-20 bg-[radial-gradient(ellipse_55%_40%_at_85%_75%,rgba(217,119,6,0.03),transparent_70%)]"></div>

<main id="main" class="relative max-w-page mx-auto px-6 md:px-20 pb-72 pt-20 md:pt-32 font-sans text-neutral-800 selection:bg-amber-500/20 selection:text-neutral-900">

  <!-- CASE STUDY HEADER / FOLIO ARCHIVE DATELINE -->
  <header class="flex flex-wrap items-center justify-between gap-6 pb-6 mb-16 text-[9px] font-mono tracking-[0.36em] text-neutral-500 uppercase border-b border-neutral-200">
    <div class="flex items-center gap-3">
      <a href="/" class="text-neutral-950 hover:text-amber-700 transition-luxury font-medium">MEGHAN LENDHE</a>
      <span class="text-neutral-300">/</span>
      <span>CASE STUDY 06</span>
    </div>
    <div class="flex items-center gap-6 text-neutral-500">
      <span>COGNITIVE ERGONOMICS</span>
      <span class="text-neutral-300">/</span>
      <span class="text-neutral-700">INFORMATION CREDIBILITY &amp; ETHICAL UX</span>
    </div>
  </header>

  <!-- HERO SECTION: Monumental Headline & Narrative Scale Bridge -->
  <section class="mb-32 md:mb-48">
    <div class="max-w-6xl mb-20">
      <span class="text-[9px] font-mono tracking-[0.36em] text-amber-700 uppercase block mb-6 font-medium">
        ETHICAL INTERACTION DESIGN // 5-WEEK RESEARCH SPRINT
      </span>
      <h1 class="font-serif text-5xl sm:text-7xl lg:text-[6.5rem] font-normal leading-[0.94] tracking-[-0.04em] text-neutral-950 mb-10 text-balance">
        Designing Data-Driven UX for Information Credibility.
      </h1>
      <p class="text-2xl sm:text-3xl text-neutral-700 font-light leading-snug tracking-tight mb-14 max-w-[50ch]">
        Translating empirical user research into ethical interaction signals to help readers validate news without algorithmic manipulation.
      </p>

      <div class="grid grid-cols-1 lg:grid-cols-[1.3fr_0.7fr] gap-12 lg:gap-24 items-start pt-6 border-t border-neutral-200">
        <div>
          <p class="text-xl sm:text-2xl text-neutral-600 font-light leading-[1.75] max-w-[52ch] text-pretty mb-8">
            News aggregator Alirtify was founded on the hypothesis that social engagement counts could indicate article credibility. However, viral metrics often amplify sensationalism rather than veracity. <span class="text-neutral-950 font-normal underline decoration-neutral-300 underline-offset-8">Our research team partnered with the CEO</span> to dismantle this assumption and design provenance-based validation affordances.
          </p>
          <div class="font-serif italic text-2xl sm:text-3xl text-neutral-800 leading-relaxed max-w-[46ch]">
            “In an era of hyper-sensationalism, credibility cannot be manufactured through engagement volume—it must be grounded in transparency, provenance, and neutral framing.”
          </div>
        </div>

        <!-- Margin Ledger: Project Specifications (Pure Broadsheet Typography) -->
        <div class="space-y-8 lg:pt-2 pl-0 lg:pl-10">
          <div class="text-[9px] font-mono uppercase tracking-[0.36em] text-neutral-500">PROJECT COORDINATES</div>
          <dl class="space-y-6 text-xs font-mono">
            <div>
              <dt class="text-neutral-500 text-[9px] tracking-[0.25em] uppercase mb-1">CORE PROBLEM</dt>
              <dd class="text-neutral-950 text-base font-medium">Algorithmic Sensationalism</dd>
              <dd class="text-neutral-500 text-[11px] font-sans mt-0.5">Misalignment between likes and veracity</dd>
            </div>
            <div>
              <dt class="text-neutral-500 text-[9px] tracking-[0.25em] uppercase mb-1">RESEARCH SPRINT</dt>
              <dd class="text-neutral-950 text-base font-medium">5 Weeks Discovery</dd>
              <dd class="text-neutral-500 text-[11px] font-sans mt-0.5">Direct collaboration with founder &amp; CEO</dd>
            </div>
            <div>
              <dt class="text-neutral-500 text-[9px] tracking-[0.25em] uppercase mb-1">ROLE &amp; TEAM</dt>
              <dd class="text-neutral-950 text-base font-medium">UX Researcher &amp; Designer</dd>
              <dd class="text-neutral-500 text-[11px] font-sans mt-0.5">Five-person product design research group</dd>
            </div>
            <div>
              <dt class="text-neutral-500 text-[9px] tracking-[0.25em] uppercase mb-1">KEY DELIVERABLES</dt>
              <dd class="text-neutral-950 text-base font-medium">5 Ethical UX Interventions</dd>
              <dd class="text-neutral-500 text-[11px] font-sans mt-0.5">Neutral headlines, provenance &amp; verified data</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>

    <!-- Monumental Hero Image Spread -->
    <div class="relative overflow-hidden pt-8 border-t border-neutral-200">
      <div class="aspect-[16/10] overflow-hidden bg-white/90 border border-neutral-200/90 shadow-xs flex items-center justify-center p-6 md:p-12">
        <img
          src="/assets/alirtify/cover.png"
          alt="Alirtify news validation and engagement interface"
          class="w-full h-full object-contain hover:scale-[1.01] transition-luxury duration-700"
        />
      </div>
      <div class="flex items-center justify-between text-[10px] font-mono tracking-[0.36em] text-neutral-500 uppercase mt-4 border-t border-neutral-200 pt-3">
        <span>News Credibility Platform</span>
        <span>Real-Time Validation &amp; Provenance Interface</span>
      </div>
    </div>
  </section>

  <!-- SECTION 01: RESEARCH SCOPE & METHODOLOGY -->
  <section class="py-24 border-y border-neutral-200 mb-36 md:mb-52">
    <div class="text-[9px] font-mono tracking-[0.36em] text-neutral-500 uppercase mb-16">
      01 / Research Scope &amp; Methodology
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-16 md:gap-12">
      <div class="space-y-4">
        <div class="font-serif text-6xl sm:text-7xl lg:text-8xl font-light text-neutral-950 tracking-tight">
          7<span class="text-amber-700 font-sans text-4xl sm:text-5xl"> Cohorts</span>
        </div>
        <div class="text-[10px] font-mono uppercase tracking-[0.32em] text-neutral-600 font-medium">IN-DEPTH USER INTERVIEWS</div>
        <p class="text-sm text-neutral-600 font-light leading-relaxed max-w-[32ch]">
          Recruited across diverse professions and age groups to isolate psychological markers of trust and skepticism.
        </p>
      </div>

      <div class="space-y-4">
        <div class="font-serif text-6xl sm:text-7xl lg:text-8xl font-light text-neutral-950 tracking-tight">
          5<span class="text-amber-700 font-sans text-4xl sm:text-5xl"> Wks</span>
        </div>
        <div class="text-[10px] font-mono uppercase tracking-[0.32em] text-neutral-600 font-medium">DISCOVERY SPRINT DURATION</div>
        <p class="text-sm text-neutral-600 font-light leading-relaxed max-w-[32ch]">
          High-velocity investigation testing fundamental assumptions directly against executive hypotheses.
        </p>
      </div>

      <div class="space-y-4">
        <div class="font-serif text-6xl sm:text-7xl lg:text-8xl font-light text-neutral-950 tracking-tight">
          5<span class="text-amber-700 font-sans text-4xl sm:text-5xl"> Interventions</span>
        </div>
        <div class="text-[10px] font-mono uppercase tracking-[0.32em] text-neutral-600 font-medium">ETHICAL DESIGN AFFORDANCES</div>
        <p class="text-sm text-neutral-600 font-light leading-relaxed max-w-[32ch]">
          Proven UX patterns replacing superficial popularity counts with verifiable multi-source provenance.
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION 02: THE CREDIBILITY DILEMMA -->
  <section class="mb-48 md:mb-60">
    <div class="pb-5 mb-20 border-b border-neutral-200">
      <div class="text-[9px] font-mono tracking-[0.36em] text-neutral-500 uppercase">
        02 / Why Engagement Counts Mislead Readers
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1.2fr_0.8fr] gap-16 lg:gap-24 items-start">
      <div class="space-y-8">
        <h2 class="font-serif text-4xl sm:text-6xl text-neutral-950 leading-[1.05] tracking-tight">
          Understanding how readers genuinely validate news in real time.
        </h2>
        <div class="space-y-6 text-neutral-600 font-light text-lg leading-[1.85] max-w-[54ch]">
          <p class="text-neutral-900 font-normal text-xl leading-relaxed">
            Our research goal was to uncover how individuals make trust determinations—without an algorithm prescriptively telling them what to believe.
          </p>
          <p class="text-neutral-500">
            Across qualitative interviews, readers reported that raw engagement numbers frequently correlated with rage-bait rather than truth. Instead, participants relied on institutional source reputation, social-circle endorsements, and third-party verified datasets.
          </p>
        </div>
      </div>

      <div class="space-y-6 font-mono text-xs text-neutral-600 pt-2 border-t border-neutral-200">
        <div class="text-[9px] uppercase tracking-[0.36em] text-neutral-500">QUALITATIVE FINDINGS</div>
        <div class="space-y-4">
          <div class="flex items-start gap-4">
            <span class="text-amber-700 font-medium">01</span>
            <span>Sensational headlines destroy source credibility at first glance.</span>
          </div>
          <div class="flex items-start gap-4">
            <span class="text-amber-700 font-medium">02</span>
            <span>Endorsements from known social circles outweigh abstract global counts.</span>
          </div>
          <div class="flex items-start gap-4">
            <span class="text-amber-700 font-medium">03</span>
            <span>Civic stories require direct links to government or verified public data.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 03: FIVE ETHICAL UX INTERVENTIONS -->
  <section class="mb-48 md:mb-60">
    <div class="pb-5 mb-20 border-b border-neutral-200">
      <div class="text-[9px] font-mono tracking-[0.36em] text-neutral-500 uppercase">
        03 / Five Core Design Interventions
      </div>
    </div>

    <div class="max-w-4xl mb-24">
      <h2 class="font-serif text-4xl sm:text-6xl text-neutral-950 mb-6">
        Replacing vanity metrics with cognitive validation signals.
      </h2>
      <p class="text-xl text-neutral-600 font-light leading-[1.7] max-w-[52ch]">
        We architected five distinct UX interventions designed to empower reader skepticism, provide multi-perspective context, and restore provenance.
      </p>
    </div>

    <div class="space-y-48">
      
      <!-- Feature 01: Social Circle Validation -->
      <article class="grid grid-cols-1 lg:grid-cols-[1.3fr_0.7fr] gap-16 items-start group">
        <div class="relative overflow-hidden">
          <div class="aspect-[16/10] overflow-hidden bg-white/90 border border-neutral-200/90 shadow-xs flex items-center justify-center p-6">
            <img
              src="/assets/alirtify/news-feed.svg"
              alt="Social-circle validation signals surfaced alongside global counts"
              class="w-full max-w-[22rem] max-h-[85%] h-auto object-contain group-hover:scale-[1.01] transition-luxury duration-700"
            />
          </div>
          <div class="flex items-center justify-between text-[10px] font-mono tracking-[0.36em] text-neutral-500 uppercase mt-4 border-t border-neutral-200 pt-3">
            <span>Social Provenance</span>
            <span>Circle Endorsements vs. Global Counts</span>
          </div>
        </div>

        <div class="space-y-5 lg:pt-2">
          <span class="text-[9px] font-mono text-amber-700 uppercase tracking-[0.36em] block font-medium">INTERVENTION 01</span>
          <h3 class="text-3xl font-serif text-neutral-950 group-hover:text-amber-800 transition-colors">
            Social-Circle Validation
          </h3>
          <p class="text-base text-neutral-600 font-light leading-[1.75]">
            Surfaced engagement from a reader's trusted connections (friends, domain experts, verified colleagues) alongside broader platform counts, transforming arbitrary numbers into meaningful human context.
          </p>
        </div>
      </article>

      <!-- Feature 02: AI Neutral Headlines -->
      <article class="grid grid-cols-1 lg:grid-cols-[0.7fr_1.3fr] gap-16 items-start group">
        <div class="space-y-5 order-2 lg:order-1 lg:pt-2">
          <span class="text-[9px] font-mono text-amber-700 uppercase tracking-[0.36em] block font-medium">INTERVENTION 02</span>
          <h3 class="text-3xl font-serif text-neutral-950 group-hover:text-amber-800 transition-colors">
            AI Neutral Headline Toggle
          </h3>
          <p class="text-base text-neutral-600 font-light leading-[1.75]">
            Introduced an optional, client-side neural summarizer that re-renders sensationalized clickbait titles into factual, emotion-neutral executive summaries before opening the story.
          </p>
        </div>

        <div class="order-1 lg:order-2 relative overflow-hidden">
          <div class="aspect-[16/10] overflow-hidden bg-white/90 border border-neutral-200/90 shadow-xs flex items-center justify-center p-6">
            <img
              src="/assets/alirtify/news-feed.svg"
              alt="AI-generated neutral headline alternative reducing sensationalism"
              class="w-full max-w-[22rem] max-h-[85%] h-auto object-contain group-hover:scale-[1.01] transition-luxury duration-700"
            />
          </div>
          <div class="flex items-center justify-between text-[10px] font-mono tracking-[0.36em] text-neutral-500 uppercase mt-4 border-t border-neutral-200 pt-3">
            <span>AI Neutral Headlines</span>
            <span>De-Escalating Clickbait Titles</span>
          </div>
        </div>
      </article>

      <!-- Feature 03: Publisher Prominence -->
      <article class="grid grid-cols-1 lg:grid-cols-[1.3fr_0.7fr] gap-16 items-start group">
        <div class="relative overflow-hidden">
          <div class="aspect-[16/10] overflow-hidden bg-white/90 border border-neutral-200/90 shadow-xs flex items-center justify-center p-6">
            <img
              src="/assets/alirtify/news-feed.svg"
              alt="Prominent publisher branding and credibility badges"
              class="w-full max-w-[22rem] max-h-[85%] h-auto object-contain group-hover:scale-[1.01] transition-luxury duration-700"
            />
          </div>
          <div class="flex items-center justify-between text-[10px] font-mono tracking-[0.36em] text-neutral-500 uppercase mt-4 border-t border-neutral-200 pt-3">
            <span>Provenance Signaling</span>
            <span>Publisher Branding &amp; Governance</span>
          </div>
        </div>

        <div class="space-y-5 lg:pt-2">
          <span class="text-[9px] font-mono text-amber-700 uppercase tracking-[0.36em] block font-medium">INTERVENTION 03</span>
          <h3 class="text-3xl font-serif text-neutral-950 group-hover:text-amber-800 transition-colors">
            Publisher Prominence &amp; Standards
          </h3>
          <p class="text-base text-neutral-600 font-light leading-[1.75]">
            Elevated the primary publishing organization from fine-print metadata into the primary card masthead, displaying verified journalistic standards, corrections policies, and ownership structures.
          </p>
        </div>
      </article>

      <!-- Feature 04: Multi-Perspective Related Articles -->
      <article class="grid grid-cols-1 lg:grid-cols-[0.7fr_1.3fr] gap-16 items-start group">
        <div class="space-y-5 order-2 lg:order-1 lg:pt-2">
          <span class="text-[9px] font-mono text-amber-700 uppercase tracking-[0.36em] block font-medium">INTERVENTION 04</span>
          <h3 class="text-3xl font-serif text-neutral-950 group-hover:text-amber-800 transition-colors">
            Multi-Perspective Cross-Checking
          </h3>
          <p class="text-base text-neutral-600 font-light leading-[1.75]">
            Integrated direct lateral reading rails immediately below article conclusions, linking alternative perspectives and fact-checking reviews to prevent echo-chamber polarization.
          </p>
        </div>

        <div class="order-1 lg:order-2 relative overflow-hidden">
          <div class="aspect-[16/10] overflow-hidden bg-white/90 border border-neutral-200/90 shadow-xs flex items-center justify-center p-6">
            <img
              src="/assets/alirtify/related-articles.svg"
              alt="Contextual cross-checking with related multi-perspective coverage"
              class="w-full max-w-[22rem] max-h-[85%] h-auto object-contain group-hover:scale-[1.01] transition-luxury duration-700"
            />
          </div>
          <div class="flex items-center justify-between text-[10px] font-mono tracking-[0.36em] text-neutral-500 uppercase mt-4 border-t border-neutral-200 pt-3">
            <span>Lateral Discovery</span>
            <span>Multi-Perspective Coverage Rails</span>
          </div>
        </div>
      </article>

      <!-- Feature 05: Verified Public Datasets -->
      <article class="grid grid-cols-1 lg:grid-cols-[1.3fr_0.7fr] gap-16 items-start group">
        <div class="relative overflow-hidden">
          <div class="aspect-[16/10] overflow-hidden bg-white/90 border border-neutral-200/90 shadow-xs flex items-center justify-center p-6">
            <img
              src="/assets/alirtify/verified-data.svg"
              alt="Authoritative public data feeds embedded for civic transparency"
              class="w-full max-w-[22rem] max-h-[85%] h-auto object-contain group-hover:scale-[1.01] transition-luxury duration-700"
            />
          </div>
          <div class="flex items-center justify-between text-[10px] font-mono tracking-[0.36em] text-neutral-500 uppercase mt-4 border-t border-neutral-200 pt-3">
            <span>Primary Sources</span>
            <span>Verified Public Civic Datasets</span>
          </div>
        </div>

        <div class="space-y-5 lg:pt-2">
          <span class="text-[9px] font-mono text-amber-700 uppercase tracking-[0.36em] block font-medium">INTERVENTION 05</span>
          <h3 class="text-3xl font-serif text-neutral-950 group-hover:text-amber-800 transition-colors">
            Verified Civic &amp; Public Datasets
          </h3>
          <p class="text-base text-neutral-600 font-light leading-[1.75]">
            Directly embedded official government and academic primary data feeds beneath stories addressing civic policy, public health, or economic trends—allowing users to examine raw records without editorial distortion.
          </p>
        </div>
      </article>

    </div>
  </section>

  <!-- CHAPTER NAVIGATION: Architectural Broadsheet Links -->
  <section class="pt-16 border-t border-neutral-200">
    <div class="flex flex-col sm:flex-row items-baseline justify-between gap-12 font-mono text-xs">
      <a href="/cool-school" class="group flex flex-col gap-2 transition-luxury">
        <span class="text-[9px] tracking-[0.36em] uppercase text-neutral-500 group-hover:text-amber-700">← PREVIOUS CHAPTER</span>
        <span class="action-potential-link font-serif text-2xl font-light text-neutral-950 group-hover:text-amber-700 pb-1 w-fit">Cool School: Game Architecture</span>
        <span class="font-sans text-xs text-neutral-500 font-light">Pediatric conflict-resolution &amp; participatory co-design</span>
      </a>

      <a href="/vitals" class="group flex flex-col gap-2 sm:text-right transition-luxury">
        <span class="text-[9px] tracking-[0.36em] uppercase text-neutral-500 group-hover:text-amber-700">NEXT CHAPTER →</span>
        <span class="action-potential-link font-serif text-2xl font-light text-neutral-950 group-hover:text-amber-700 pb-1 w-fit sm:ml-auto">Vitals: Digital Medical ID</span>
        <span class="font-sans text-xs text-neutral-500 font-light">Overcoming the 92% drop-off barrier through trust-first onboarding</span>
      </a>
    </div>
  </section>

</main>
</BaseLayout>
