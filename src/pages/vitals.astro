---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChapterMarker from '../components/case-study/ChapterMarker.astro';
import StepEyebrow from '../components/case-study/StepEyebrow.astro';
import Vitrine from '../components/case-study/Vitrine.astro';
import Caption from '../components/case-study/Caption.astro';
import PhoneFrame from '../components/case-study/PhoneFrame.astro';
import RestingRule from '../components/case-study/RestingRule.astro';
---

<BaseLayout title="Vitals — Trust-First Onboarding for Emergency Medical ID" theme="light" includeCaseStudyScript>

<main id="main" class="relative max-w-page mx-auto px-6 md:px-20 pb-72 pt-20 md:pt-32 font-sans text-neutral-800 selection:bg-amber-500/20 selection:text-neutral-900">

  <!-- HERO SECTION: Monumental Headline & Narrative Scale Bridge -->
  <section class="mb-32 md:mb-48 relative">
    <div class="max-w-6xl mb-20">
      <h1 class="font-serif text-5xl sm:text-7xl lg:text-[6.5rem] font-normal leading-[0.94] tracking-[-0.04em] text-neutral-950 mb-10 text-balance">
        Overcoming the 92% Drop-off Barrier.
      </h1>
      <p class="text-2xl sm:text-3xl text-neutral-800 font-normal leading-snug tracking-tight mb-14 max-w-[50ch]">
        Re-architecting emergency medical ID onboarding to build foundational trust before asking for sensitive medical details.
      </p>

      <div class="grid grid-cols-1 lg:grid-cols-[1.3fr_0.7fr] gap-12 lg:gap-24 items-start pt-6 border-t border-neutral-200">
        <div>
          <p class="text-xl sm:text-2xl text-neutral-800 font-normal leading-[1.75] max-w-[52ch] text-pretty">
            Vitals provides first responders with instant, non-verbal medical profiles during emergencies. Yet despite strong demand from families, <span class="text-neutral-950 font-normal underline decoration-neutral-300 underline-offset-8">92% of new signups abandoned the onboarding flow</span> before completing their profile.
          </p>
        </div>

        <!-- Margin Ledger: Project Specifications -->
        <div class="lg:pt-2 pl-0 lg:pl-10">
          <dl class="space-y-5 text-xs font-mono">
            <div>
              <dt class="text-neutral-500 text-[10px] tracking-[0.22em] uppercase mb-1 font-medium">TIMELINE</dt>
              <dd class="text-neutral-950 text-sm font-medium tabular-nums">14 Weeks</dd>
            </div>
            <div>
              <dt class="text-neutral-500 text-[10px] tracking-[0.22em] uppercase mb-1 font-medium">MY ROLE</dt>
              <dd class="text-neutral-950 text-sm font-medium">Lead Product Designer</dd>
            </div>
            <div>
              <dt class="text-neutral-500 text-[10px] tracking-[0.22em] uppercase mb-1 font-medium">COLLABORATION</dt>
              <dd class="text-neutral-950 text-sm font-medium">Executive Team &amp; Medical Advisors</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>

    <!-- Hero Image Spread -->
    <div class="relative overflow-hidden pt-12">
      <Vitrine>
        <img
          src="/assets/vitals/cover.png"
          alt="Vitals digital medical ID 4-step onboarding journey progression"
          class="w-full h-auto object-contain hover:scale-[1.008] transition-luxury duration-700"
        />
      </Vitrine>
      <Caption as="p">
        The redesigned onboarding sequence establishes emergency responder visibility and local coverage before asking for sensitive medical details.
      </Caption>
    </div>
  </section>

  <!-- Architectural Section Divider -->
  <RestingRule class="mb-32 md:mb-44" />

  <!-- SECTION 01: THE FIRST RESPONDER REALITY (CONTEXT) -->
  <section class="mb-48 md:mb-60">
    <ChapterMarker number="01" title="The Emergency Context" />

    <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-16 lg:gap-24 items-start">
      <div class="space-y-8">
        <h2 class="font-serif text-4xl sm:text-6xl text-neutral-950 leading-[1.05] tracking-tight font-normal text-balance">
          Bridging information gaps when seconds determine outcomes.
        </h2>
        <div class="text-neutral-700 font-normal text-lg leading-[1.8] max-w-[54ch]">
          <p class="text-xl text-neutral-950 leading-relaxed">
            Vitals gives first responders non-verbal access to medical profiles and de-escalation tips during crises. Instead of stressful verbal questioning, responders see calming instructions and emergency contacts before physical intervention begins.
          </p>
        </div>
      </div>

      <div class="relative overflow-hidden">
        <Vitrine padded class="p-6 sm:p-10 flex items-center justify-center">
          <PhoneFrame class="w-[240px] sm:w-[270px] lg:w-[290px] h-[435px] sm:h-[490px] lg:h-[525px]">
            <img
              src="/assets/vitals/sample-id-screen.png"
              alt="Sample emergency medical profile accessed by first responders"
              class="w-full h-full object-contain block pointer-events-none select-none"
              loading="lazy"
            />
          </PhoneFrame>
        </Vitrine>
        <Caption as="p">
          The emergency beacon profile gives first responders immediate de-escalation protocols and critical medical history on dispatch.
        </Caption>
      </div>
    </div>
  </section>

  <!-- Architectural Section Divider -->
  <RestingRule class="mb-24 md:mb-36" />

  <!-- SECTION 02: THE OPERATIONAL BARRIER -->
  <section class="pt-8 pb-8 mb-36 md:mb-52">
    <ChapterMarker number="02" title="The Operational Barrier" class="mb-12" />

    <div class="grid grid-cols-1 lg:grid-cols-[0.8fr_1.2fr] gap-12 lg:gap-20 items-baseline">
      <div class="space-y-3">
        <div class="font-serif text-7xl sm:text-8xl lg:text-9xl font-normal text-neutral-950 tracking-tight tabular-nums leading-none">
          92<span class="text-amber-800 font-sans text-4xl sm:text-5xl font-medium">%</span>
        </div>
        <div class="text-[10px] font-mono uppercase tracking-[0.28em] text-neutral-600 font-medium">
          INITIAL ONBOARDING ABANDONMENT
        </div>
      </div>

      <div class="text-neutral-700 font-normal text-lg leading-[1.8] max-w-[54ch]">
        <p class="text-xl sm:text-2xl text-neutral-950 font-normal leading-snug">
          The original signup treated onboarding like an administrative form. It demanded medical diagnoses and paid subscriptions upfront, before ever explaining who could view the data or how it would be protected.
        </p>
      </div>
    </div>
  </section>

  <!-- Architectural Section Divider -->
  <RestingRule class="mb-24 md:mb-36" />

  <!-- SECTION 03: RESEARCH FINDINGS -->
  <section class="mb-48 md:mb-60">
    <ChapterMarker number="03" title="What We Learned from Users" />

    <div class="max-w-4xl mb-24 space-y-6">
      <h2 class="font-serif text-4xl sm:text-6xl text-neutral-950 font-normal text-balance">
        Diagnosing why 92% of users left without subscribing.
      </h2>
      <div class="text-lg text-neutral-700 font-normal leading-relaxed max-w-[56ch]">
        <p class="text-xl text-neutral-950 leading-relaxed">
          Auditing the signup flow showed where users dropped off, but talking directly with caregivers and patients revealed why. People weren't overwhelmed by the number of steps—they hesitated to share sensitive medical conditions without knowing if their local 911 dispatchers could even use the service.
        </p>
      </div>
    </div>

    <div class="space-y-40">
      
      <!-- Finding 01: Premature Data Collection -->
      <article class="grid grid-cols-1 lg:grid-cols-[1.3fr_0.7fr] gap-16 items-start group">
        <div class="relative overflow-hidden">
          <Vitrine>
            <img
              src="/assets/vitals/findings/trust-issue.png"
              alt="Legacy signup flow demanding personal details immediately after splash"
              class="w-full h-auto object-contain group-hover:scale-[1.01] transition-luxury duration-700"
            />
          </Vitrine>
          <Caption as="p">
            The original sign-up flow demanded intimate medical diagnoses immediately after registration, before establishing responder protocols.
          </Caption>
        </div>

        <div class="space-y-6 lg:pt-2">
          <div class="space-y-2">
            <StepEyebrow label="DIAGNOSTIC" number="01" accent />
            <h3 class="text-3xl font-serif text-neutral-950 font-normal">
              Premature personal questions broke trust
            </h3>
          </div>

          <div class="flex items-baseline gap-3 pt-1">
            <span class="font-serif text-4xl sm:text-5xl font-normal text-amber-800 tabular-nums">70%</span>
            <span class="text-xs font-mono uppercase tracking-widest text-neutral-600 font-medium">DISCLOSURE RESISTANCE</span>
          </div>

          <p class="text-base text-neutral-700 font-normal leading-[1.75]">
            Seven in ten interviewed caregivers expressed acute hesitation disclosing neurological conditions, medications, or behavioral triggers before understanding how data was protected or who held authority to view it.
          </p>

          <blockquote class="font-serif italic text-xl text-neutral-900 leading-snug">
            “Why do you need my daughter’s diagnosis before you’ve even shown me how a police officer will see it?”
          </blockquote>
        </div>
      </article>

      <!-- Finding 02: Plan Selection Cognitive Load -->
      <article class="grid grid-cols-1 lg:grid-cols-[0.7fr_1.3fr] gap-16 items-start group">
        <div class="space-y-6 order-2 lg:order-1 lg:pt-2">
          <div class="space-y-2">
            <StepEyebrow label="DIAGNOSTIC" number="02" accent />
            <h3 class="text-3xl font-serif text-neutral-950 font-normal">
              Geographic coverage ambiguity
            </h3>
          </div>

          <p class="text-base text-neutral-700 font-normal leading-[1.75]">
            Users faced a dense pricing table without knowing whether the service functioned in their specific county or city. Caregivers worried they would pay for an emergency ID that local first responders couldn't actually scan.
          </p>

          <blockquote class="font-serif italic text-xl text-neutral-900 leading-snug">
            “I don't know what 'Standard Statewide' vs 'Regional' means if my dad travels across state lines.”
          </blockquote>
        </div>

        <div class="order-1 lg:order-2 relative overflow-hidden">
          <Vitrine>
            <img
              src="/assets/vitals/findings/plan-confusion.png"
              alt="Legacy pricing buttons lacking geographic verification"
              class="w-full h-auto object-contain group-hover:scale-[1.01] transition-luxury duration-700"
            />
          </Vitrine>
          <Caption as="p">
            The legacy pricing screen forced users to choose statewide vs. regional plans without confirming whether local responders supported the beacon.
          </Caption>
        </div>
      </article>

      <!-- Finding 03: Buried Reassurance -->
      <article class="grid grid-cols-1 lg:grid-cols-[1.3fr_0.7fr] gap-16 items-start group">
        <div class="relative overflow-hidden">
          <Vitrine>
            <img
              src="/assets/vitals/findings/visual-hierarchy.png"
              alt="Legacy screen hiding free trial and cancellation terms below the fold"
              class="w-full h-auto object-contain group-hover:scale-[1.01] transition-luxury duration-700"
            />
          </Vitrine>
          <Caption as="p">
            Crucial trial terms, cancellation policies, and ID card previews were buried below the fold, creating fear of financial commitment.
          </Caption>
        </div>

        <div class="space-y-6 lg:pt-2">
          <div class="space-y-2">
            <StepEyebrow label="DIAGNOSTIC" number="03" accent />
            <h3 class="text-3xl font-serif text-neutral-950 font-normal">
              Concealed safety nets
            </h3>
          </div>

          <p class="text-base text-neutral-700 font-normal leading-[1.75]">
            Essential reassurances—including a 30-day trial, sample ID previews, and cancel-anytime policies—were buried in fine print below the fold. Users assumed they were locking into an immediate, irreversible financial trap.
          </p>
        </div>
      </article>

    </div>
  </section>

  <!-- EDITORIAL INTERLUDE -->
  <section class="py-24 md:py-32 my-16 text-center relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-6 space-y-6">
      <span class="text-[10px] font-mono tracking-[0.28em] text-amber-800 uppercase font-medium">DESIGN PRINCIPLE</span>
      <blockquote class="font-serif italic text-3xl sm:text-5xl text-neutral-950 font-normal leading-[1.25] text-balance">
        “In emergency healthcare software, trust is not an aesthetic afterthought—it is the prerequisite for clinical disclosure.”
      </blockquote>
      <div class="text-[10px] font-mono tracking-widest text-neutral-600 uppercase pt-2 font-medium">
        Trust First · Transparent Plans · Clear Questions
      </div>
    </div>
  </section>

  <!-- Architectural Section Divider -->
  <RestingRule class="mb-24 md:mb-36" />

  <!-- SECTION 04: THE REDESIGNED EXPERIENCE -->
  <section class="mb-48 md:mb-60">
    <ChapterMarker number="04" title="The Redesigned Experience" />

    <div class="max-w-4xl mb-24">
      <h2 class="font-serif text-4xl sm:text-6xl text-neutral-950 mb-6 font-normal text-balance">
        Inverting the funnel: value before commitment.
      </h2>
      <p class="text-xl text-neutral-800 font-normal leading-[1.7] max-w-[52ch]">
        We reversed the onboarding sequence so users first see how the system protects them, preview what responders will see, choose transparent coverage, and only then fill in personal medical details.
      </p>
    </div>

    <div class="space-y-48">
      
      <!-- Feature 01: Value-First Landing Page -->
      <article class="grid grid-cols-1 lg:grid-cols-[1.15fr_0.85fr] gap-16 items-start group">
        <div class="space-y-6 lg:pt-8">
          <div class="space-y-2">
            <StepEyebrow label="INTERVENTION" number="01" />
            <h3 class="text-3xl font-serif text-neutral-950 font-normal">
              Showing the beacon in action before signup
            </h3>
          </div>
          <p class="text-base text-neutral-700 font-normal leading-[1.75]">
            Before asking for an email or password, the revised landing experience demonstrates how local police and paramedics scan the digital ID card. Families immediately see how their vulnerable loved ones are safeguarded, replacing mystery with tangible relief.
          </p>
        </div>

        <div class="relative overflow-hidden">
          <Vitrine padded class="p-6 sm:p-10">
            <img
              src="/assets/vitals/solutions/trust-screen.png"
              alt="Trust-centered welcome screen with sample profile preview and security assurances"
              class="max-h-[560px] w-auto object-contain group-hover:scale-[1.01] transition-luxury duration-700"
            />
          </Vitrine>
          <Caption as="p">
            Caregivers preview exactly what first responders will see during a call, removing ambiguity around data access.
          </Caption>
        </div>
      </article>

      <!-- Feature 02: Geographic Verification & Plan Selection -->
      <article class="grid grid-cols-1 lg:grid-cols-[0.8fr_1.2fr] gap-16 items-start group">
        <div class="space-y-6 order-2 lg:order-1 lg:pt-8">
          <div class="space-y-2">
            <StepEyebrow label="INTERVENTION" number="02" />
            <h3 class="text-3xl font-serif text-neutral-950 font-normal">
              Transparent plans with local verification
            </h3>
          </div>
          <p class="text-base text-neutral-700 font-normal leading-[1.75]">
            Plan selection now begins with entering the user's primary zip code to immediately verify local 911 coverage. Transparent card tiers outline regional versus statewide capabilities, with sample responder previews and clear 30-day trial assurances directly beside the action button.
          </p>
        </div>

        <div class="order-1 lg:order-2 relative overflow-hidden">
          <Vitrine>
            <img
              src="/assets/vitals/solutions/plan-selection.png"
              alt="Zip code coverage verification and clear transparent plan tiers"
              class="w-full h-auto object-contain group-hover:scale-[1.01] transition-luxury duration-700"
            />
          </Vitrine>
          <Caption as="p">
            Zip-code verification confirms active first-responder partnerships before users commit to a subscription.
          </Caption>
        </div>
      </article>

      <!-- Feature 03: Progressive Clinical Disclosure -->
      <article class="grid grid-cols-1 lg:grid-cols-[1.15fr_0.85fr] gap-16 items-start group">
        <div class="relative overflow-hidden">
          <Vitrine>
            <img
              src="/assets/vitals/solutions/data-collection.png"
              alt="Focused single-question registration steps with clear purpose explanation"
              class="w-full h-auto object-contain group-hover:scale-[1.01] transition-luxury duration-700"
            />
          </Vitrine>
          <Caption as="p">
            Single-question progressive disclosure cards explain why each data field is needed and who is authorized to view it.
          </Caption>
        </div>

        <div class="space-y-6 lg:pt-8">
          <div class="space-y-2">
            <StepEyebrow label="INTERVENTION" number="03" />
            <h3 class="text-3xl font-serif text-neutral-950 font-normal">
              Progressive disclosure for personal data
            </h3>
          </div>
          <p class="text-base text-neutral-700 font-normal leading-[1.75]">
            We divided lengthy registration forms into focused, single-question steps. Each input field explicitly explains why the data is requested—distinguishing between urgent security verification and plan management notifications—so users never wonder why their contact details are needed.
          </p>
        </div>
      </article>

      <!-- Feature 04: Persistent Contextual Support -->
      <article class="grid grid-cols-1 lg:grid-cols-[0.8fr_1.2fr] gap-16 items-start group">
        <div class="space-y-6 order-2 lg:order-1 lg:pt-8">
          <div class="space-y-2">
            <StepEyebrow label="INTERVENTION" number="04" />
            <h3 class="text-3xl font-serif text-neutral-950 font-normal">
              Persistent contextual support
            </h3>
          </div>
          <p class="text-base text-neutral-700 font-normal leading-[1.75]">
            Persistent in-flow help triggers—including "Get Help" and "Contact Support"—are anchored directly into every step. Caregivers can clarify questions or verify details without abandoning the flow or losing their place in the enrollment journey.
          </p>
        </div>

        <div class="order-1 lg:order-2 relative overflow-hidden">
          <Vitrine>
            <img
              src="/assets/vitals/solutions/help-access.png"
              alt="Persistent in-flow help triggers reducing drop-off anxiety"
              class="w-full h-auto object-contain group-hover:scale-[1.01] transition-luxury duration-700"
            />
          </Vitrine>
          <Caption as="p">
            Persistent 'Get Help' and 'Contact Support' actions allow caregivers to resolve questions without losing their progress.
          </Caption>
        </div>
      </article>

    </div>
  </section>

  <!-- Architectural Section Divider -->
  <RestingRule class="mb-24 md:mb-36" />

  <!-- SECTION 05: PROJECTED OUTCOME -->
  <section class="pt-8 pb-12 mb-32 md:mb-48">
    <ChapterMarker number="05" title="Projected Outcome" />

    <!-- The Business Payoff -->
    <div class="grid grid-cols-1 lg:grid-cols-[0.8fr_1.2fr] gap-12 lg:gap-20 items-baseline">
      <div class="space-y-3">
        <div class="font-serif text-7xl sm:text-8xl lg:text-9xl font-normal text-amber-800 tracking-tight tabular-nums leading-none">
          +16<span class="text-neutral-950 font-sans text-4xl sm:text-5xl font-medium">%</span>
        </div>
        <div class="text-[10px] font-mono uppercase tracking-[0.28em] text-neutral-600 font-medium">
          PROJECTED CONVERSION LIFT
        </div>
      </div>

      <div class="text-neutral-700 font-normal text-lg leading-[1.8] max-w-[54ch]">
        <p class="text-xl sm:text-2xl text-neutral-950 font-normal leading-snug">
          By showing emergency protection and verified 911 coverage before asking for personal details, the redesign proved that building trust directly restores conversion.
        </p>
      </div>
    </div>
  </section>

  <!-- CHAPTER NAVIGATION -->
  <section class="pt-16 border-t border-neutral-200">
    <div class="flex flex-col sm:flex-row items-baseline justify-between gap-12 font-mono text-xs">
      <a href="/cool-school" class="group flex flex-col gap-2 transition-luxury">
        <span class="text-[10px] tracking-widest uppercase text-neutral-600 group-hover:text-amber-800 font-medium">← PREVIOUS CASE STUDY</span>
        <span class="font-serif text-2xl font-normal text-neutral-950 group-hover:text-amber-800">Cool School: Game Architecture</span>
        <span class="font-sans text-xs text-neutral-600 font-normal">Playful conflict-resolution for pediatric environments</span>
      </a>

      <a href="/bulkmagic" class="group flex flex-col gap-2 sm:text-right transition-luxury">
        <span class="text-[10px] tracking-widest uppercase text-neutral-600 group-hover:text-amber-800 font-medium">NEXT CASE STUDY →</span>
        <span class="font-serif text-2xl font-normal text-neutral-950 group-hover:text-amber-800">BulkMagic: Merchant Onboarding</span>
        <span class="font-sans text-xs text-neutral-600 font-normal">36-hour compliance onboarding sprint &amp; adaptive disclosure</span>
      </a>
    </div>
  </section>

</main>
</BaseLayout>
