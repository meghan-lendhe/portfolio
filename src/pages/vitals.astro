---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Vitals — Trust-First Onboarding for Emergency Medical ID" theme="light" includeCaseStudyScript>
<!-- Luminous Gallery Atmosphere: Layered Warm Ambient Gradients -->
<div class="fixed inset-0 pointer-events-none -z-20 bg-[#FAF9F5]"></div>
<div class="fixed inset-0 pointer-events-none -z-20 bg-[radial-gradient(ellipse_75%_55%_at_70%_10%,rgba(217,119,6,0.045),transparent_65%)]"></div>
<div class="fixed inset-0 pointer-events-none -z-20 bg-[radial-gradient(ellipse_60%_45%_at_15%_25%,rgba(13,148,136,0.035),transparent_60%)]"></div>
<div class="fixed inset-0 pointer-events-none -z-20 bg-[radial-gradient(ellipse_55%_40%_at_85%_75%,rgba(217,119,6,0.03),transparent_70%)]"></div>

<main id="main" class="relative max-w-page mx-auto px-6 md:px-20 pb-72 pt-20 md:pt-32 font-sans text-neutral-800 selection:bg-amber-500/20 selection:text-neutral-900">

  <!-- CASE STUDY HEADER / FOLIO ARCHIVE DATELINE -->
  <header class="flex flex-wrap items-center justify-between gap-6 pb-6 mb-16 text-[9px] font-mono tracking-[0.36em] text-neutral-500 uppercase border-b border-neutral-200">
    <div class="flex items-center gap-3">
      <a href="/" class="text-neutral-950 hover:text-amber-700 transition-luxury font-medium">MEGHAN LENDHE</a>
      <span class="text-neutral-300">/</span>
      <span>CASE STUDY 03</span>
    </div>
    <div class="flex items-center gap-6 text-neutral-500">
      <span>DIGITAL MEDICAL ID</span>
      <span class="text-neutral-300">/</span>
      <span class="text-neutral-700">CLINICAL ONBOARDING REDESIGN</span>
    </div>
  </header>

  <!-- HERO SECTION: Monumental Headline & Narrative Scale Bridge -->
  <section class="mb-32 md:mb-48">
    <div class="max-w-6xl mb-20">
      <span class="text-[9px] font-mono tracking-[0.36em] text-amber-700 uppercase block mb-6 font-medium">
        HEALTHTECH INTERACTION DESIGN // 14 WEEKS
      </span>
      <h1 class="font-serif text-5xl sm:text-7xl lg:text-[6.5rem] font-normal leading-[0.94] tracking-[-0.04em] text-neutral-950 mb-10 text-balance">
        Overcoming the 92% Drop-off Barrier.
      </h1>
      <p class="text-2xl sm:text-3xl text-neutral-700 font-light leading-snug tracking-tight mb-14 max-w-[50ch]">
        Re-architecting emergency medical ID onboarding to establish foundational trust before demanding sensitive clinical disclosure.
      </p>

      <div class="grid grid-cols-1 lg:grid-cols-[1.3fr_0.7fr] gap-12 lg:gap-24 items-start pt-6 border-t border-neutral-200">
        <div>
          <p class="text-xl sm:text-2xl text-neutral-600 font-light leading-[1.75] max-w-[52ch] text-pretty mb-8">
            Vitals provides first responders with instant, life-saving context for vulnerable individuals who cannot communicate in crises. Yet despite high demand, <span class="text-neutral-950 font-normal underline decoration-neutral-300 underline-offset-8">92% of new signups abandoned the flow</span> before purchasing a profile subscription.
          </p>
          <div class="font-serif italic text-2xl sm:text-3xl text-neutral-800 leading-relaxed max-w-[46ch]">
            “In healthcare systems, asking for intimate medical history before demonstrating value doesn't just reduce conversion—it destroys user trust.”
          </div>
        </div>

        <!-- Margin Ledger: Project Specifications (Pure Broadsheet Typography) -->
        <div class="space-y-8 lg:pt-2 pl-0 lg:pl-10">
          <div class="text-[9px] font-mono uppercase tracking-[0.36em] text-neutral-500">PROJECT COORDINATES</div>
          <dl class="space-y-6 text-xs font-mono">
            <div>
              <dt class="text-neutral-500 text-[9px] tracking-[0.25em] uppercase mb-1">CORE CHALLENGE</dt>
              <dd class="text-neutral-950 text-base font-medium">92% Signup Abandonment</dd>
              <dd class="text-neutral-500 text-[11px] font-sans mt-0.5">Friction during sensitive data intake</dd>
            </div>
            <div>
              <dt class="text-neutral-500 text-[9px] tracking-[0.25em] uppercase mb-1">TIMELINE &amp; CADENCE</dt>
              <dd class="text-neutral-950 text-base font-medium">14 Weeks</dd>
              <dd class="text-neutral-500 text-[11px] font-sans mt-0.5">Discovery, Usability Testing, Full UI</dd>
            </div>
            <div>
              <dt class="text-neutral-500 text-[9px] tracking-[0.25em] uppercase mb-1">ROLE &amp; OWNERSHIP</dt>
              <dd class="text-neutral-950 text-base font-medium">Lead Product Designer</dd>
              <dd class="text-neutral-500 text-[11px] font-sans mt-0.5">End-to-end research, IA &amp; interaction</dd>
            </div>
            <div>
              <dt class="text-neutral-500 text-[9px] tracking-[0.25em] uppercase mb-1">KEY STAKEHOLDERS</dt>
              <dd class="text-neutral-950 text-base font-medium">C-Suite &amp; Medical Advisors</dd>
              <dd class="text-neutral-500 text-[11px] font-sans mt-0.5">Clinical governance alignment</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>

    <!-- Monumental Hero Image Spread -->
    <div class="relative overflow-hidden pt-8 border-t border-neutral-200">
      <div class="aspect-[16/10] overflow-hidden bg-white/90 border border-neutral-200/90 shadow-xs">
        <img
          src="/assets/vitals/cover.png"
          alt="Vitals digital medical ID mobile experience"
          class="w-full h-full object-contain p-6 md:p-12 hover:scale-[1.01] transition-luxury duration-700"
        />
      </div>
      <div class="flex items-center justify-between text-[10px] font-mono tracking-[0.36em] text-neutral-500 uppercase mt-4 border-t border-neutral-200 pt-3">
        <span>PLATE 01 · EMERGENCY PROFILE PLATFORM</span>
        <span>MOBILE ONBOARDING REDESIGN</span>
      </div>
    </div>
  </section>

  <!-- SECTION 01: MONUMENTAL METRICS LEDGER (Zero-Box Scale Contrast) -->
  <section class="py-24 border-y border-neutral-200 mb-36 md:mb-52">
    <div class="text-[9px] font-mono tracking-[0.36em] text-neutral-500 uppercase mb-16">
      01 / THE CONVERSION IMPEDANCE LEDGER
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-16 md:gap-12">
      <div class="space-y-4">
        <div class="font-serif text-6xl sm:text-7xl lg:text-8xl font-light text-neutral-950 tracking-tight">
          92<span class="text-amber-700 font-sans text-4xl sm:text-5xl">%</span>
        </div>
        <div class="text-[10px] font-mono uppercase tracking-[0.32em] text-neutral-600 font-medium">INITIAL DROP-OFF RATE</div>
        <p class="text-sm text-neutral-600 font-light leading-relaxed max-w-[32ch]">
          Account creators who abandoned the journey before completing their emergency profile subscription.
        </p>
      </div>

      <div class="space-y-4">
        <div class="font-serif text-6xl sm:text-7xl lg:text-8xl font-light text-neutral-950 tracking-tight">
          70<span class="text-amber-700 font-sans text-4xl sm:text-5xl">%</span>
        </div>
        <div class="text-[10px] font-mono uppercase tracking-[0.32em] text-neutral-600 font-medium">TRUST BARRIER REPORTED</div>
        <p class="text-sm text-neutral-600 font-light leading-relaxed max-w-[32ch]">
          Participants who felt uncomfortable sharing sensitive diagnostic medical data prior to understanding value.
        </p>
      </div>

      <div class="space-y-4">
        <div class="font-serif text-6xl sm:text-7xl lg:text-8xl font-light text-neutral-950 tracking-tight">
          +16<span class="text-amber-700 font-sans text-4xl sm:text-5xl">%</span>
        </div>
        <div class="text-[10px] font-mono uppercase tracking-[0.32em] text-neutral-600 font-medium">PROJECTED CONVERSION LIFT</div>
        <p class="text-sm text-neutral-600 font-light leading-relaxed max-w-[32ch]">
          Validated increase in paid subscription completions following the trust-centered sequence architecture.
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION 02: THE CLINICAL MISSION & EMERGENCY CONTEXT -->
  <section class="mb-48 md:mb-60">
    <div class="pb-5 mb-20 border-b border-neutral-200">
      <div class="text-[9px] font-mono tracking-[0.36em] text-neutral-500 uppercase">
        02 / CLINICAL SYSTEM &amp; EMERGENCY CONTEXT
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1.2fr_0.8fr] gap-16 lg:gap-24 items-start">
      <div class="space-y-8">
        <h2 class="font-serif text-4xl sm:text-6xl text-neutral-950 leading-[1.05] tracking-tight">
          Bridging information gaps when seconds determine outcomes.
        </h2>
        <div class="space-y-6 text-neutral-600 font-light text-lg leading-[1.85] max-w-[54ch]">
          <p class="text-neutral-900 font-normal text-xl leading-relaxed">
            Vitals equips first responders with instant, non-verbal access to crucial medical profiles. When interacting with individuals experiencing cognitive distress, autism, dementia, or severe physical trauma, paramedics can instantly scan a beacon or look up an ID to retrieve vital diagnoses, de-escalation protocols, and emergency contacts.
          </p>
          <p class="text-neutral-500">
            However, the original application front-loaded all clinical friction onto the user: immediately after creating an account, users were asked to input intimate health conditions and commit to a paid subscription before ever seeing what their emergency profile would actually look like to a paramedic.
          </p>
        </div>
      </div>

      <div class="relative overflow-hidden">
        <div class="aspect-[4/5] overflow-hidden bg-white/90 border border-neutral-200/90 shadow-xs flex items-center justify-center p-6">
          <img
            src="/assets/vitals/sample-id.png"
            alt="Sample emergency medical profile accessed by first responders"
            class="max-h-[90%] w-auto object-contain hover:scale-[1.02] transition-luxury duration-700"
          />
        </div>
        <div class="flex items-center justify-between text-[10px] font-mono tracking-[0.36em] text-neutral-500 uppercase mt-4 border-t border-neutral-200 pt-3">
          <span>PLATE 02 · FIRST RESPONDER INTERFACE</span>
          <span>EMERGENCY BEACON VIEW</span>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 03: QUALITATIVE RESEARCH & THE THREE ANXIETY PILLARS -->
  <section class="mb-48 md:mb-60">
    <div class="pb-5 mb-20 border-b border-neutral-200">
      <div class="text-[9px] font-mono tracking-[0.36em] text-neutral-500 uppercase">
        03 / EMPIRICAL INVESTIGATION · THREE ANXIETY PILLARS
      </div>
    </div>

    <div class="max-w-4xl mb-24">
      <h2 class="font-serif text-4xl sm:text-6xl text-neutral-950 mb-6">
        Diagnosing why 92% of users left without subscribing.
      </h2>
      <p class="text-xl text-neutral-600 font-light leading-[1.7] max-w-[52ch]">
        Through think-aloud usability sessions and in-depth interviews with patients and caregivers, we uncovered three systemic breakdown points in the legacy onboarding journey.
      </p>
    </div>

    <div class="space-y-40">
      
      <!-- Finding 01: Lack of Trust -->
      <article class="grid grid-cols-1 lg:grid-cols-[1.3fr_0.7fr] gap-16 items-start group">
        <div class="relative overflow-hidden">
          <div class="aspect-[16/10] overflow-hidden bg-white/90 border border-neutral-200/90 shadow-xs">
            <img
              src="/assets/vitals/findings/trust-issue.png"
              alt="Legacy signup screen asking for sensitive medical data prematurely"
              class="w-full h-full object-contain p-6 group-hover:scale-[1.01] transition-luxury duration-700"
            />
          </div>
          <div class="flex items-center justify-between text-[10px] font-mono tracking-[0.36em] text-neutral-500 uppercase mt-4 border-t border-neutral-200 pt-3">
            <span>PLATE 03A · LEGACY AUDIT</span>
            <span>PREMATURE DISCLOSURE</span>
          </div>
        </div>

        <div class="space-y-5 lg:pt-2">
          <span class="text-[9px] font-mono text-amber-700 uppercase tracking-[0.36em] block font-medium">BREAKDOWN 01</span>
          <h3 class="text-3xl font-serif text-neutral-950 group-hover:text-amber-800 transition-colors">
            Premature Clinical Disclosure
          </h3>
          <p class="text-base text-neutral-600 font-light leading-[1.75]">
            70% of interviewed participants expressed acute discomfort disclosing neurological conditions, medications, or behavioral triggers before understanding how data is safeguarded or who has access. The legacy interface lacked visible encryption assurances or clear governance policies.
          </p>
          <div class="font-mono text-xs text-neutral-500 pt-2 border-t border-neutral-200">
            USER VERBATIM: "Why do you need my daughter’s diagnosis before you’ve even shown me how a police officer will see it?"
          </div>
        </div>
      </article>

      <!-- Finding 02: Plan Selection Cognitive Load -->
      <article class="grid grid-cols-1 lg:grid-cols-[0.7fr_1.3fr] gap-16 items-start group">
        <div class="space-y-5 order-2 lg:order-1 lg:pt-2">
          <span class="text-[9px] font-mono text-amber-700 uppercase tracking-[0.36em] block font-medium">BREAKDOWN 02</span>
          <h3 class="text-3xl font-serif text-neutral-950 group-hover:text-amber-800 transition-colors">
            Pricing Opacity &amp; Choice Paralysis
          </h3>
          <p class="text-base text-neutral-600 font-light leading-[1.75]">
            Users faced a dense, jargon-laden pricing matrix without knowing that certain subscription tiers were restricted to specific state jurisdictions. Users feared paying for a service that emergency personnel in their county could not even scan.
          </p>
          <div class="font-mono text-xs text-neutral-500 pt-2 border-t border-neutral-200">
            USER VERBATIM: "I don't know what 'Standard Statewide' vs 'Regional' means if my dad travels across state lines."
          </div>
        </div>

        <div class="order-1 lg:order-2 relative overflow-hidden">
          <div class="aspect-[16/10] overflow-hidden bg-white/90 border border-neutral-200/90 shadow-xs">
            <img
              src="/assets/vitals/findings/plan-confusion.png"
              alt="Legacy pricing table causing decision paralysis"
              class="w-full h-full object-contain p-6 group-hover:scale-[1.01] transition-luxury duration-700"
            />
          </div>
          <div class="flex items-center justify-between text-[10px] font-mono tracking-[0.36em] text-neutral-500 uppercase mt-4 border-t border-neutral-200 pt-3">
            <span>PLATE 03B · LEGACY AUDIT</span>
            <span>JARGON &amp; AMBIGUITY</span>
          </div>
        </div>
      </article>

      <!-- Finding 03: Buried Reassurance -->
      <article class="grid grid-cols-1 lg:grid-cols-[1.3fr_0.7fr] gap-16 items-start group">
        <div class="relative overflow-hidden">
          <div class="aspect-[16/10] overflow-hidden bg-white/90 border border-neutral-200/90 shadow-xs">
            <img
              src="/assets/vitals/findings/visual-hierarchy.png"
              alt="Weak visual hierarchy obscuring free trial messaging"
              class="w-full h-full object-contain p-6 group-hover:scale-[1.01] transition-luxury duration-700"
            />
          </div>
          <div class="flex items-center justify-between text-[10px] font-mono tracking-[0.36em] text-neutral-500 uppercase mt-4 border-t border-neutral-200 pt-3">
            <span>PLATE 03C · LEGACY AUDIT</span>
            <span>HIERARCHICAL WEAKNESS</span>
          </div>
        </div>

        <div class="space-y-5 lg:pt-2">
          <span class="text-[9px] font-mono text-amber-700 uppercase tracking-[0.36em] block font-medium">BREAKDOWN 03</span>
          <h3 class="text-3xl font-serif text-neutral-950 group-hover:text-amber-800 transition-colors">
            Concealed Value &amp; Trial Affordances
          </h3>
          <p class="text-base text-neutral-600 font-light leading-[1.75]">
            Critical reassurance mechanisms—including a 30-day no-risk trial, sample responder profile previews, and cancel-anytime guarantees—were buried below the fold in low-contrast typography, causing users to believe they were entering an immediate, irreversible billing commitment.
          </p>
        </div>
      </article>

    </div>
  </section>

  <!-- MONUMENTAL EDITORIAL INTERLUDE: Cartier-Grade Silence & Immense Scale Contrast -->
  <section class="py-36 md:py-48 my-28 border-y border-neutral-200 text-center relative overflow-hidden">
    <div class="max-w-5xl mx-auto px-6 space-y-8">
      <span class="text-[9px] font-mono tracking-[0.36em] text-amber-700 uppercase font-medium">THE ARCHITECTURAL MANIFESTO</span>
      <blockquote class="font-serif italic text-3xl sm:text-5xl lg:text-6xl text-neutral-950 font-light leading-[1.12] text-balance">
        “In emergency healthcare software, trust is not an aesthetic afterthought—it is the prerequisite for clinical disclosure.”
      </blockquote>
      <div class="text-[10px] font-mono tracking-[0.36em] text-neutral-500 uppercase pt-2">
        TRUST · SUBSCRIBE · SIGN UP // THE INVERTED ONBOARDING FUNNEL
      </div>
    </div>
  </section>

  <!-- SECTION 04: THE REDESIGNED ARCHITECTURE (Four Systematic Solution Plates) -->
  <section class="mb-48 md:mb-60">
    <div class="pb-5 mb-20 border-b border-neutral-200">
      <div class="text-[9px] font-mono tracking-[0.36em] text-neutral-500 uppercase">
        04 / THE REDESIGNED EXPERIENCE · 4 ARCHITECTURAL PILLARS
      </div>
    </div>

    <div class="max-w-4xl mb-24">
      <h2 class="font-serif text-4xl sm:text-6xl text-neutral-950 mb-6">
        Inverting the funnel: value before commitment.
      </h2>
      <p class="text-xl text-neutral-600 font-light leading-[1.7] max-w-[52ch]">
        We dismantled the legacy onboarding flow, reversing the sequence so that users first understand the system, preview their emergency ID, choose transparent coverage, and only then input personal medical data.
      </p>
    </div>

    <div class="space-y-48">
      
      <!-- Plate 04: Building Foundational Trust -->
      <article class="grid grid-cols-1 lg:grid-cols-[1.3fr_0.7fr] gap-16 items-start group">
        <div class="relative overflow-hidden">
          <div class="aspect-[16/10] overflow-hidden bg-white/90 border border-neutral-200/90 shadow-xs">
            <img
              src="/assets/vitals/solutions/trust-screen.png"
              alt="Trust-centered welcome screen with security assurances"
              class="w-full h-full object-contain p-6 group-hover:scale-[1.01] transition-luxury duration-700"
            />
          </div>
          <div class="flex items-center justify-between text-[10px] font-mono tracking-[0.36em] text-neutral-500 uppercase mt-4 border-t border-neutral-200 pt-3">
            <span>PLATE 04 · TRUST ARCHITECTURE</span>
            <span>SECURITY ASSURANCES &amp; GOVERNANCE</span>
          </div>
        </div>

        <div class="space-y-5 lg:pt-2">
          <span class="text-[9px] font-mono text-neutral-500 uppercase tracking-[0.36em] block">PILLAR 01</span>
          <h3 class="text-3xl font-serif text-neutral-950 group-hover:text-amber-800 transition-colors">
            Foundational Trust &amp; Governance
          </h3>
          <p class="text-base text-neutral-600 font-light leading-[1.75]">
            The new entry screen anchors the experience with an explicit statement of data custody: who sees the profile, how beacons trigger access, and explicit HIPAA-compliant encryption standards. Direct links to governance documentation are surfaced before registration.
          </p>
        </div>
      </article>

      <!-- Plate 05: Transparent Plan Selection -->
      <article class="grid grid-cols-1 lg:grid-cols-[0.7fr_1.3fr] gap-16 items-start group">
        <div class="space-y-5 order-2 lg:order-1 lg:pt-2">
          <span class="text-[9px] font-mono text-neutral-500 uppercase tracking-[0.36em] block">PILLAR 02</span>
          <h3 class="text-3xl font-serif text-neutral-950 group-hover:text-amber-800 transition-colors">
            Plain-Language Plan Comparison
          </h3>
          <p class="text-base text-neutral-600 font-light leading-[1.75]">
            Replaced technical insurance terminology with simple, side-by-side tier cards. Dynamic geo-location automatically confirms whether the user’s local first responder jurisdiction participates, removing cross-border uncertainty.
          </p>
        </div>

        <div class="order-1 lg:order-2 relative overflow-hidden">
          <div class="aspect-[16/10] overflow-hidden bg-white/90 border border-neutral-200/90 shadow-xs">
            <img
              src="/assets/vitals/solutions/plan-selection.png"
              alt="Side-by-side plan comparison with transparent pricing"
              class="w-full h-full object-contain p-6 group-hover:scale-[1.01] transition-luxury duration-700"
            />
          </div>
          <div class="flex items-center justify-between text-[10px] font-mono tracking-[0.36em] text-neutral-500 uppercase mt-4 border-t border-neutral-200 pt-3">
            <span>PLATE 05 · TARIFF TRANSPARENCY</span>
            <span>JURISDICTION VERIFICATION</span>
          </div>
        </div>
      </article>

      <!-- Plate 06: Progressive Clinical Data Collection -->
      <article class="grid grid-cols-1 lg:grid-cols-[1.3fr_0.7fr] gap-16 items-start group">
        <div class="relative overflow-hidden">
          <div class="aspect-[16/10] overflow-hidden bg-white/90 border border-neutral-200/90 shadow-xs">
            <img
              src="/assets/vitals/solutions/data-collection.png"
              alt="Step-by-step form progression with clinical rationale"
              class="w-full h-full object-contain p-6 group-hover:scale-[1.01] transition-luxury duration-700"
            />
          </div>
          <div class="flex items-center justify-between text-[10px] font-mono tracking-[0.36em] text-neutral-500 uppercase mt-4 border-t border-neutral-200 pt-3">
            <span>PLATE 06 · PROGRESSIVE INTAKE</span>
            <span>CLINICAL RATIONALE CALLOUTS</span>
          </div>
        </div>

        <div class="space-y-5 lg:pt-2">
          <span class="text-[9px] font-mono text-neutral-500 uppercase tracking-[0.36em] block">PILLAR 03</span>
          <h3 class="text-3xl font-serif text-neutral-950 group-hover:text-amber-800 transition-colors">
            Progressive Clinical Disclosure
          </h3>
          <p class="text-base text-neutral-600 font-light leading-[1.75]">
            Divided extensive medical questionnaires into discrete, bite-sized cognitive modules. Each field features a micro-callout explaining precisely why paramedics need the detail (e.g., “Knowing non-verbal triggers allows responders to avoid sensory overload”).
          </p>
        </div>
      </article>

      <!-- Plate 07: Contextual Assurance Drawer -->
      <article class="grid grid-cols-1 lg:grid-cols-[0.7fr_1.3fr] gap-16 items-start group">
        <div class="space-y-5 order-2 lg:order-1 lg:pt-2">
          <span class="text-[9px] font-mono text-neutral-500 uppercase tracking-[0.36em] block">PILLAR 04</span>
          <h3 class="text-3xl font-serif text-neutral-950 group-hover:text-amber-800 transition-colors">
            Contextual Reassurance Drawer
          </h3>
          <p class="text-base text-neutral-600 font-light leading-[1.75]">
            Integrated a persistent, zero-friction help drawer across all onboarding steps. Caregivers can trigger instant chat assistance, review security FAQs, or preview exactly how their emergency profile appears to emergency teams.
          </p>
        </div>

        <div class="order-1 lg:order-2 relative overflow-hidden">
          <div class="aspect-[16/10] overflow-hidden bg-white/90 border border-neutral-200/90 shadow-xs">
            <img
              src="/assets/vitals/solutions/help-access.png"
              alt="Persistent help drawer reducing user drop-off anxiety"
              class="w-full h-full object-contain p-6 group-hover:scale-[1.01] transition-luxury duration-700"
            />
          </div>
          <div class="flex items-center justify-between text-[10px] font-mono tracking-[0.36em] text-neutral-500 uppercase mt-4 border-t border-neutral-200 pt-3">
            <span>PLATE 07 · PERSISTENT HELP</span>
            <span>CAREGIVER REASSURANCE DRAWER</span>
          </div>
        </div>
      </article>

    </div>
  </section>

  <!-- SECTION 05: RESEARCH METHODOLOGY ARCHIVE -->
  <section class="py-24 border-t border-neutral-200 mb-32 md:mb-48">
    <div class="pb-5 mb-16 border-b border-neutral-200">
      <div class="text-[9px] font-mono tracking-[0.36em] text-neutral-500 uppercase">
        05 / RESEARCH METHODOLOGY &amp; PARTICIPANT SAMPLE
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-16">
      <div class="space-y-4">
        <span class="text-[9px] font-mono text-neutral-500 uppercase tracking-[0.36em] block font-medium">PROTOCOL 01</span>
