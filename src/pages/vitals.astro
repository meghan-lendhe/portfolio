---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Vitals — Trust-First Onboarding for Emergency Medical ID" theme="light" includeCaseStudyScript>
<!-- Luminous Gallery Atmosphere: Layered Warm Ambient Gradients -->
<div class="fixed inset-0 pointer-events-none -z-20 bg-[#FAF9F5]"></div>
<div class="fixed inset-0 pointer-events-none -z-20 bg-[radial-gradient(ellipse_75%_55%_at_70%_10%,rgba(217,119,6,0.045),transparent_65%)]"></div>
<div class="fixed inset-0 pointer-events-none -z-20 bg-[radial-gradient(ellipse_60%_45%_at_15%_25%,rgba(13,148,136,0.035),transparent_60%)]"></div>
<div class="fixed inset-0 pointer-events-none -z-20 bg-[radial-gradient(ellipse_55%_40%_at_85%_75%,rgba(217,119,6,0.03),transparent_70%)]"></div>

<main id="main" class="relative max-w-page mx-auto px-6 md:px-20 pb-72 pt-20 md:pt-32 font-sans text-neutral-800 selection:bg-amber-500/20 selection:text-neutral-900">

  <!-- CASE STUDY HEADER / FOLIO ARCHIVE DATELINE -->
  <header class="flex flex-wrap items-center justify-between gap-6 pb-6 mb-16 text-[9px] font-mono tracking-[0.36em] text-neutral-500 uppercase border-b border-neutral-200">
    <div class="flex items-center gap-3">
      <a href="/" class="text-neutral-950 hover:text-amber-700 transition-luxury font-medium">MEGHAN LENDHE</a>
      <span class="text-neutral-300">/</span>
      <span>CASE STUDY 03</span>
    </div>
    <div class="flex items-center gap-6 text-neutral-500">
      <span>HEALTHCARE UX</span>
      <span class="text-neutral-300">/</span>
      <span class="text-neutral-700">CLINICAL ONBOARDING REDESIGN</span>
    </div>
  </header>

  <!-- HERO SECTION: Monumental Headline & Narrative Scale Bridge -->
  <section class="mb-32 md:mb-48">
    <div class="max-w-6xl mb-20">
      <span class="text-[9px] font-mono tracking-[0.36em] text-amber-700 uppercase block mb-6 font-medium">
        HEALTHTECH PRODUCT DESIGN // 14-WEEK REDESIGN
      </span>
      <h1 class="font-serif text-5xl sm:text-7xl lg:text-[6.5rem] font-normal leading-[0.94] tracking-[-0.04em] text-neutral-950 mb-10 text-balance">
        Overcoming the 92% Drop-off Barrier.
      </h1>
      <p class="text-2xl sm:text-3xl text-neutral-700 font-light leading-snug tracking-tight mb-14 max-w-[50ch]">
        Re-architecting emergency medical ID onboarding to build foundational trust before asking for sensitive medical details.
      </p>

      <div class="grid grid-cols-1 lg:grid-cols-[1.3fr_0.7fr] gap-12 lg:gap-24 items-start pt-6 border-t border-neutral-200">
        <div>
          <p class="text-xl sm:text-2xl text-neutral-600 font-light leading-[1.75] max-w-[52ch] text-pretty mb-8">
            Vitals provides first responders with instant, life-saving context for vulnerable individuals who cannot communicate in crises. Yet despite high demand, <span class="text-neutral-950 font-normal underline decoration-neutral-300 underline-offset-8">92% of new signups abandoned the flow</span> before purchasing a profile subscription.
          </p>
          <div class="font-serif italic text-2xl sm:text-3xl text-neutral-800 leading-relaxed max-w-[46ch]">
            “In healthcare systems, asking for intimate medical history before demonstrating value doesn't just reduce conversion—it destroys user trust.”
          </div>
        </div>

        <!-- Margin Ledger: Project Specifications -->
        <div class="space-y-8 lg:pt-2 pl-0 lg:pl-10">
          <div class="text-[9px] font-mono uppercase tracking-[0.36em] text-neutral-500">PROJECT OVERVIEW</div>
          <dl class="space-y-6 text-xs font-mono">
            <div>
              <dt class="text-neutral-500 text-[9px] tracking-[0.25em] uppercase mb-1">CORE CHALLENGE</dt>
              <dd class="text-neutral-950 text-base font-medium">92% Signup Abandonment</dd>
              <dd class="text-neutral-500 text-[11px] font-sans mt-0.5">High friction during medical data intake</dd>
            </div>
            <div>
              <dt class="text-neutral-500 text-[9px] tracking-[0.25em] uppercase mb-1">TIMELINE</dt>
              <dd class="text-neutral-950 text-base font-medium">14 Weeks</dd>
              <dd class="text-neutral-500 text-[11px] font-sans mt-0.5">Research, usability testing, and full UI redesign</dd>
            </div>
            <div>
              <dt class="text-neutral-500 text-[9px] tracking-[0.25em] uppercase mb-1">MY ROLE</dt>
              <dd class="text-neutral-950 text-base font-medium">Lead Product Designer</dd>
              <dd class="text-neutral-500 text-[11px] font-sans mt-0.5">End-to-end UX research, interaction, and testing</dd>
            </div>
            <div>
              <dt class="text-neutral-500 text-[9px] tracking-[0.25em] uppercase mb-1">COLLABORATION</dt>
              <dd class="text-neutral-950 text-base font-medium">Executive Team &amp; Medical Advisors</dd>
              <dd class="text-neutral-500 text-[11px] font-sans mt-0.5">Aligning clinical requirements with user trust</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>

    <!-- Hero Image -->
    <div class="relative overflow-hidden pt-8 border-t border-neutral-200">
      <div class="aspect-[16/10] overflow-hidden bg-white/90 border border-neutral-200/90 shadow-xs">
        <img
          src="/assets/vitals/cover.png"
          alt="Vitals digital medical ID mobile experience"
          class="w-full h-full object-contain p-6 md:p-12 hover:scale-[1.01] transition-luxury duration-700"
        />
      </div>
      <div class="flex items-center justify-between text-[10px] font-mono tracking-widest text-neutral-500 uppercase mt-4 border-t border-neutral-200 pt-3">
        <span>Vitals Mobile Experience</span>
        <span>Emergency Profile &amp; Onboarding Flow</span>
      </div>
    </div>
  </section>

  <!-- SECTION 01: METRICS -->
  <section class="py-24 border-y border-neutral-200 mb-36 md:mb-52">
    <div class="text-[9px] font-mono tracking-[0.36em] text-neutral-500 uppercase mb-16">
      01 / The Drop-Off Problem
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-16 md:gap-12">
      <div class="space-y-4">
        <div class="font-serif text-6xl sm:text-7xl lg:text-8xl font-light text-neutral-950 tracking-tight">
          92<span class="text-amber-700 font-sans text-4xl sm:text-5xl">%</span>
        </div>
        <div class="text-[10px] font-mono uppercase tracking-[0.32em] text-neutral-600 font-medium">INITIAL DROP-OFF RATE</div>
        <p class="text-sm text-neutral-600 font-light leading-relaxed max-w-[32ch]">
          Account creators who abandoned the sign-up process before finishing their profile subscription.
        </p>
      </div>

      <div class="space-y-4">
        <div class="font-serif text-6xl sm:text-7xl lg:text-8xl font-light text-neutral-950 tracking-tight">
          70<span class="text-amber-700 font-sans text-4xl sm:text-5xl">%</span>
        </div>
        <div class="text-[10px] font-mono uppercase tracking-[0.32em] text-neutral-600 font-medium">REPORTED TRUST HESITATION</div>
        <p class="text-sm text-neutral-600 font-light leading-relaxed max-w-[32ch]">
          Participants who felt uncomfortable sharing diagnoses before understanding how the service worked.
        </p>
      </div>

      <div class="space-y-4">
        <div class="font-serif text-6xl sm:text-7xl lg:text-8xl font-light text-neutral-950 tracking-tight">
          +16<span class="text-amber-700 font-sans text-4xl sm:text-5xl">%</span>
        </div>
        <div class="text-[10px] font-mono uppercase tracking-[0.32em] text-neutral-600 font-medium">PROJECTED CONVERSION LIFT</div>
        <p class="text-sm text-neutral-600 font-light leading-relaxed max-w-[32ch]">
          Estimated increase in paid subscriptions from putting trust and clear expectations first.
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION 02: THE EMERGENCY CONTEXT -->
  <section class="mb-48 md:mb-60">
    <div class="pb-5 mb-20 border-b border-neutral-200">
      <div class="text-[9px] font-mono tracking-[0.36em] text-neutral-500 uppercase">
        02 / The Emergency Context
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1.2fr_0.8fr] gap-16 lg:gap-24 items-start">
      <div class="space-y-8">
        <h2 class="font-serif text-4xl sm:text-6xl text-neutral-950 leading-[1.05] tracking-tight">
          Bridging information gaps when seconds determine outcomes.
        </h2>
        <div class="space-y-6 text-neutral-600 font-light text-lg leading-[1.85] max-w-[54ch]">
          <p class="text-neutral-900 font-normal text-xl leading-relaxed">
            Vitals equips first responders with instant, non-verbal access to critical medical profiles. When interacting with individuals experiencing cognitive distress, autism, dementia, or severe trauma, responders can scan a beacon or look up an ID to see de-escalation tips, medications, and emergency contacts.
          </p>
          <p class="text-neutral-500">
            However, the original app front-loaded all clinical friction onto the user: immediately after creating an account, users were asked to input intimate health conditions and commit to a paid subscription before ever seeing what their emergency profile would actually look like to a paramedic.
          </p>
        </div>
      </div>

      <div class="relative overflow-hidden">
        <div class="aspect-[4/5] overflow-hidden bg-white/90 border border-neutral-200/90 shadow-xs flex items-center justify-center p-6">
          <img
            src="/assets/vitals/sample-id.png"
            alt="Sample emergency medical profile accessed by first responders"
            class="max-h-[90%] w-auto object-contain hover:scale-[1.02] transition-luxury duration-700"
          />
        </div>
        <div class="flex items-center justify-between text-[10px] font-mono tracking-widest text-neutral-500 uppercase mt-4 border-t border-neutral-200 pt-3">
          <span>First Responder View</span>
          <span>Emergency Beacon Profile</span>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 03: RESEARCH FINDINGS -->
  <section class="mb-48 md:mb-60">
    <div class="pb-5 mb-20 border-b border-neutral-200">
      <div class="text-[9px] font-mono tracking-[0.36em] text-neutral-500 uppercase">
        03 / What We Learned from Users
      </div>
    </div>

    <div class="max-w-4xl mb-24">
      <h2 class="font-serif text-4xl sm:text-6xl text-neutral-950 mb-6">
        Diagnosing why 92% of users left without subscribing.
      </h2>
      <p class="text-xl text-neutral-600 font-light leading-[1.7] max-w-[52ch]">
        Through think-aloud usability sessions and in-depth interviews with patients and caregivers, we uncovered three distinct friction points in the original onboarding journey.
      </p>
    </div>

    <div class="space-y-40">
      
      <!-- Finding 01: Lack of Trust -->
      <article class="grid grid-cols-1 lg:grid-cols-[1.3fr_0.7fr] gap-16 items-start group">
        <div class="relative overflow-hidden">
          <div class="aspect-[16/10] overflow-hidden bg-white/90 border border-neutral-200/90 shadow-xs">
            <img
              src="/assets/vitals/findings/trust-issue.png"
              alt="Legacy signup screen asking for sensitive medical data prematurely"
              class="w-full h-full object-contain p-6 group-hover:scale-[1.01] transition-luxury duration-700"
            />
          </div>
          <div class="flex items-center justify-between text-[10px] font-mono tracking-widest text-neutral-500 uppercase mt-4 border-t border-neutral-200 pt-3">
            <span>Legacy Screen Audit</span>
            <span>Asking for personal diagnoses too early</span>
          </div>
        </div>

        <div class="space-y-5 lg:pt-2">
          <span class="text-[9px] font-mono text-amber-700 uppercase tracking-widest block font-medium">INSIGHT 01</span>
          <h3 class="text-3xl font-serif text-neutral-950 group-hover:text-amber-800 transition-colors">
            Premature personal questions broke trust
          </h3>
          <p class="text-base text-neutral-600 font-light leading-[1.75]">
            70% of participants expressed discomfort disclosing neurological conditions, medications, or behavioral triggers before understanding how their data was protected or who could view it. The old interface had no visible privacy guarantees or clear governance policies.
          </p>
          <div class="font-mono text-xs text-neutral-500 pt-2 border-t border-neutral-200">
            USER QUOTE: "Why do you need my daughter’s diagnosis before you’ve even shown me how a police officer will see it?"
          </div>
        </div>
      </article>

      <!-- Finding 02: Plan Selection Cognitive Load -->
      <article class="grid grid-cols-1 lg:grid-cols-[0.7fr_1.3fr] gap-16 items-start group">
        <div class="space-y-5 order-2 lg:order-1 lg:pt-2">
          <span class="text-[9px] font-mono text-amber-700 uppercase tracking-widest block font-medium">INSIGHT 02</span>
          <h3 class="text-3xl font-serif text-neutral-950 group-hover:text-amber-800 transition-colors">
            Pricing ambiguity created hesitation
          </h3>
          <p class="text-base text-neutral-600 font-light leading-[1.75]">
            Users faced a dense pricing table without knowing whether the service worked in their specific county or state. Many worried they would pay for an ID that local first responders couldn't actually scan.
          </p>
          <div class="font-mono text-xs text-neutral-500 pt-2 border-t border-neutral-200">
            USER QUOTE: "I don't know what 'Standard Statewide' vs 'Regional' means if my dad travels across state lines."
          </div>
        </div>

        <div class="order-1 lg:order-2 relative overflow-hidden">
          <div class="aspect-[16/10] overflow-hidden bg-white/90 border border-neutral-200/90 shadow-xs">
            <img
              src="/assets/vitals/findings/plan-confusion.png"
              alt="Legacy pricing table causing decision paralysis"
              class="w-full h-full object-contain p-6 group-hover:scale-[1.01] transition-luxury duration-700"
            />
          </div>
          <div class="flex items-center justify-between text-[10px] font-mono tracking-widest text-neutral-500 uppercase mt-4 border-t border-neutral-200 pt-3">
            <span>Legacy Pricing Table</span>
            <span>Unclear coverage boundaries</span>
          </div>
        </div>
      </article>

      <!-- Finding 03: Buried Reassurance -->
      <article class="grid grid-cols-1 lg:grid-cols-[1.3fr_0.7fr] gap-16 items-start group">
        <div class="relative overflow-hidden">
          <div class="aspect-[16/10] overflow-hidden bg-white/90 border border-neutral-200/90 shadow-xs">
            <img
              src="/assets/vitals/findings/visual-hierarchy.png"
              alt="Weak visual hierarchy obscuring free trial messaging"
              class="w-full h-full object-contain p-6 group-hover:scale-[1.01] transition-luxury duration-700"
            />
          </div>
          <div class="flex items-center justify-between text-[10px] font-mono tracking-widest text-neutral-500 uppercase mt-4 border-t border-neutral-200 pt-3">
            <span>Legacy Hierarchy</span>
            <span>Hidden trial &amp; guarantee details</span>
          </div>
        </div>

        <div class="space-y-5 lg:pt-2">
          <span class="text-[9px] font-mono text-amber-700 uppercase tracking-widest block font-medium">INSIGHT 03</span>
          <h3 class="text-3xl font-serif text-neutral-950 group-hover:text-amber-800 transition-colors">
            Key reassurances were hidden
          </h3>
          <p class="text-base text-neutral-600 font-light leading-[1.75]">
            Important reassurances—including a 30-day trial, sample ID previews, and cancel-anytime policies—were buried below the fold in small, low-contrast text. Users assumed they were locking into an immediate, irreversible commitment.
          </p>
        </div>
      </article>

    </div>
  </section>

  <!-- EDITORIAL INTERLUDE -->
  <section class="py-28 md:py-36 my-20 border-y border-neutral-200 text-center relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-6 space-y-6">
      <span class="text-[9px] font-mono tracking-[0.35em] text-amber-700 uppercase font-medium">DESIGN PRINCIPLE</span>
      <blockquote class="font-serif italic text-3xl sm:text-5xl text-neutral-950 font-light leading-[1.2] text-balance">
        “In emergency healthcare software, trust is not an aesthetic afterthought—it is the prerequisite for clinical disclosure.”
      </blockquote>
      <div class="text-[10px] font-mono tracking-widest text-neutral-500 uppercase pt-2">
        Trust First · Transparent Plans · Clear Questions
      </div>
    </div>
  </section>

  <!-- SECTION 04: THE REDESIGNED EXPERIENCE -->
  <section class="mb-48 md:mb-60">
    <div class="pb-5 mb-20 border-b border-neutral-200">
      <div class="text-[9px] font-mono tracking-[0.36em] text-neutral-500 uppercase">
        04 / The Redesigned Experience
      </div>
    </div>

    <div class="max-w-4xl mb-24">
      <h2 class="font-serif text-4xl sm:text-6xl text-neutral-950 mb-6">
        Inverting the funnel: value before commitment.
      </h2>
      <p class="text-xl text-neutral-600 font-light leading-[1.7] max-w-[52ch]">
        We reversed the onboarding sequence so users first see how the system protects them, preview what responders will see, choose transparent coverage, and only then fill in personal medical details.
      </p>
    </div>

    <div class="space-y-48">
      
      <!-- Feature 01: Building Foundational Trust -->
      <article class="grid grid-cols-1 lg:grid-cols-[1.3fr_0.7fr] gap-16 items-start group">
        <div class="relative overflow-hidden">
          <div class="aspect-[16/10] overflow-hidden bg-white/90 border border-neutral-200/90 shadow-xs">
            <img
              src="/assets/vitals/solutions/trust-screen.png"
              alt="Trust-centered welcome screen with security assurances"
              class="w-full h-full object-contain p-6 group-hover:scale-[1.01] transition-luxury duration-700"
            />
          </div>
          <div class="flex items-center justify-between text-[10px] font-mono tracking-widest text-neutral-500 uppercase mt-4 border-t border-neutral-200 pt-3">
            <span>Welcome &amp; Privacy Screen</span>
            <span>Clear security policies upfront</span>
          </div>
        </div>

        <div class="space-y-5 lg:pt-2">
          <span class="text-[9px] font-mono text-neutral-500 uppercase tracking-widest block">FEATURE 01</span>
          <h3 class="text-3xl font-serif text-neutral-950 group-hover:text-amber-800 transition-colors">
            Clear privacy and governance upfront
          </h3>
          <p class="text-base text-neutral-600 font-light leading-[1.75]">
            The new entry screen explains clearly who sees the profile, how beacons trigger access, and how HIPAA encryption safeguards data. Links to privacy policies and security documentation are front and center before sign-up begins.
          </p>
        </div>
      </article>

      <!-- Feature 02: Transparent Plan Selection -->
      <article class="grid grid-cols-1 lg:grid-cols-[0.7fr_1.3fr] gap-16 items-start group">
        <div class="space-y-5 order-2 lg:order-1 lg:pt-2">
          <span class="text-[9px] font-mono text-neutral-500 uppercase tracking-widest block">FEATURE 02</span>
          <h3 class="text-3xl font-serif text-neutral-950 group-hover:text-amber-800 transition-colors">
            Plain-language plan comparison
          </h3>
          <p class="text-base text-neutral-600 font-light leading-[1.75]">
            We replaced confusing insurance jargon with clear, side-by-side plan options. Location confirmation lets users verify in real time whether their local police and paramedics participate in the Vitals network.
          </p>
        </div>

        <div class="order-1 lg:order-2 relative overflow-hidden">
          <div class="aspect-[16/10] overflow-hidden bg-white/90 border border-neutral-200/90 shadow-xs">
            <img
              src="/assets/vitals/solutions/plan-selection.png"
              alt="Side-by-side plan comparison with transparent pricing"
              class="w-full h-full object-contain p-6 group-hover:scale-[1.01] transition-luxury duration-700"
            />
          </div>
          <div class="flex items-center justify-between text-[10px] font-mono tracking-widest text-neutral-500 uppercase mt-4 border-t border-neutral-200 pt-3">
            <span>Plan Selection Screen</span>
            <span>Transparent pricing &amp; coverage check</span>
          </div>
        </div>
      </article>

      <!-- Feature 03: Progressive Clinical Data Collection -->
      <article class="grid grid-cols-1 lg:grid-cols-[1.3fr_0.7fr] gap-16 items-start group">
        <div class="relative overflow-hidden">
          <div class="aspect-[16/10] overflow-hidden bg-white/90 border border-neutral-200/90 shadow-xs">
            <img
              src="/assets/vitals/solutions/data-collection.png"
              alt="Step-by-step form progression with clinical rationale"
              class="w-full h-full object-contain p-6 group-hover:scale-[1.01] transition-luxury duration-700"
            />
          </div>
          <div class="flex items-center justify-between text-[10px] font-mono tracking-widest text-neutral-500 uppercase mt-4 border-t border-neutral-200 pt-3">
            <span>Medical Intake Form</span>
            <span>Short steps with clear explanations</span>
          </div>
        </div>

        <div class="space-y-5 lg:pt-2">
          <span class="text-[9px] font-mono text-neutral-500 uppercase tracking-widest block">FEATURE 03</span>
          <h3 class="text-3xl font-serif text-neutral-950 group-hover:text-amber-800 transition-colors">
            Step-by-step questions with clear context
          </h3>
          <p class="text-base text-neutral-600 font-light leading-[1.75]">
            We divided lengthy medical forms into short, focused steps. Each question includes a short note explaining why responders need this information (e.g., “Knowing non-verbal cues helps officers avoid sensory overload in an emergency”).
          </p>
        </div>
      </article>

      <!-- Feature 04: Contextual Assurance Drawer -->
      <article class="grid grid-cols-1 lg:grid-cols-[0.7fr_1.3fr] gap-16 items-start group">
        <div class="space-y-5 order-2 lg:order-1 lg:pt-2">
          <span class="text-[9px] font-mono text-neutral-500 uppercase tracking-widest block">FEATURE 04</span>
          <h3 class="text-3xl font-serif text-neutral-950 group-hover:text-amber-800 transition-colors">
            Always-accessible help and preview
          </h3>
          <p class="text-base text-neutral-600 font-light leading-[1.75]">
            A persistent help drawer is available on every step. Caregivers can quickly preview what their responder profile will look like, check security FAQs, or reach support without losing their place in the form.
          </p>
        </div>

        <div class="order-1 lg:order-2 relative overflow-hidden">
          <div class="aspect-[16/10] overflow-hidden bg-white/90 border border-neutral-200/90 shadow-xs">
            <img
              src="/assets/vitals/solutions/help-access.png"
              alt="Persistent help drawer reducing user drop-off anxiety"
              class="w-full h-full object-contain p-6 group-hover:scale-[1.01] transition-luxury duration-700"
            />
          </div>
          <div class="flex items-center justify-between text-[10px] font-mono tracking-widest text-neutral-500 uppercase mt-4 border-t border-neutral-200 pt-3">
            <span>Persistent Help Drawer</span>
            <span>Caregiver FAQ &amp; profile preview</span>
          </div>
        </div>
      </article>

    </div>
  </section>

  <!-- SECTION 05: RESEARCH METHODOLOGY -->
  <section class="py-24 border-t border-neutral-200 mb-32 md:mb-48">
    <div class="pb-5 mb-16 border-b border-neutral-200">
      <div class="text-[9px] font-mono tracking-[0.36em] text-neutral-500 uppercase">
        05 / How We Researched This
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-16">
      <div class="space-y-4">
        <span class="text-[9px] font-mono text-neutral-500 uppercase tracking-widest block font-medium">METHOD 01</span>
        <h4 class="text-lg font-medium text-neutral-950">Heuristic Onboarding Audit</h4>
        <p class="text-sm text-neutral-600 font-light leading-relaxed">
          Evaluated user flow friction, disclosure timing, and privacy transparency across 18 unique sign-up paths.
        </p>
      </div>

      <div class="space-y-4">
        <span class="text-[9px] font-mono text-neutral-500 uppercase tracking-widest block font-medium">METHOD 02</span>
        <h4 class="text-lg font-medium text-neutral-950">Usability Testing &amp; Interviews</h4>
        <p class="text-sm text-neutral-600 font-light leading-relaxed">
          Conducted remote think-aloud sessions with caregivers, patients, and legal guardians to pinpoint where and why they felt hesitant to proceed.
        </p>
      </div>

      <div class="space-y-4">
        <span class="text-[9px] font-mono text-neutral-500 uppercase tracking-widest block font-medium">METHOD 03</span>
        <h4 class="text-lg font-medium text-neutral-950">Leadership Alignment</h4>
        <p class="text-sm text-neutral-600 font-light leading-relaxed">
          Translated qualitative findings into clear business metrics, demonstrating to leadership how solving user trust leads to higher paid subscription completions.
