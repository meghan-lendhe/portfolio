---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Cool School — Reimagining a Conflict-Resolution Game" theme="light" includeCaseStudyScript>
<!-- Luminous Gallery Atmosphere: Layered Warm Ambient Gradients -->
<div class="fixed inset-0 pointer-events-none -z-20 bg-[#FAF9F5]"></div>
<div class="fixed inset-0 pointer-events-none -z-20 bg-[radial-gradient(ellipse_75%_55%_at_70%_10%,rgba(217,119,6,0.045),transparent_65%)]"></div>
<div class="fixed inset-0 pointer-events-none -z-20 bg-[radial-gradient(ellipse_60%_45%_at_15%_25%,rgba(13,148,136,0.035),transparent_60%)]"></div>
<div class="fixed inset-0 pointer-events-none -z-20 bg-[radial-gradient(ellipse_55%_40%_at_85%_75%,rgba(217,119,6,0.03),transparent_70%)]"></div>

<main id="main" class="relative max-w-page mx-auto px-6 md:px-20 pb-72 pt-20 md:pt-32 font-sans text-neutral-800 selection:bg-amber-500/20 selection:text-neutral-900">

  <!-- HERO SECTION: Monumental Headline & Narrative Scale Bridge -->
  <section class="mb-32 md:mb-48">
    <div class="max-w-6xl mb-20">
      <h1 class="font-serif text-5xl sm:text-7xl lg:text-[6.5rem] font-normal leading-[0.94] tracking-[-0.04em] text-neutral-950 mb-10 text-balance">
        A School Game Made for Today's Kids.
      </h1>
      <p class="text-2xl sm:text-3xl text-neutral-800 font-normal leading-snug tracking-tight mb-14 max-w-[50ch]">
        Reimagining an evidence-based conflict-resolution game for ages 4–7 as an open, exploratory world children can shape, personalize, and return to.
      </p>

      <div class="grid grid-cols-1 lg:grid-cols-[1.3fr_0.7fr] gap-12 lg:gap-24 items-start pt-6 border-t border-neutral-200">
        <div>
          <p class="text-xl sm:text-2xl text-neutral-800 font-normal leading-[1.75] max-w-[52ch] text-pretty mb-8">
            Cool School was originally designed to teach young children evidence-based strategies for navigating interpersonal conflicts. While its educational foundation was robust, the linear A-to-Z gameplay felt dated to contemporary children. <span class="text-neutral-950 font-normal underline decoration-neutral-300 underline-offset-8">Our team transformed the experience</span> into an expansive, agency-driven school campus.
          </p>
          <div class="font-serif italic text-2xl sm:text-3xl text-neutral-900 leading-relaxed max-w-[46ch]">
            “Teaching young children social-emotional resilience works best not through moral lecturing, but by granting agency within an environment that rewards exploration.”
          </div>
        </div>

        <!-- Margin Ledger: Project Specifications (Pure Broadsheet Typography) -->
        <div class="space-y-6 lg:pt-2 pl-0 lg:pl-10">
          <div class="text-[10px] font-mono uppercase tracking-[0.28em] text-neutral-500 font-medium">PROJECT OVERVIEW</div>
          <dl class="space-y-5 text-xs font-mono">
            <div>
              <dt class="text-neutral-500 text-[10px] tracking-[0.22em] uppercase mb-1 font-medium">AUDIENCE</dt>
              <dd class="text-neutral-950 text-sm font-medium">Children Ages 4–7</dd>
            </div>
            <div>
              <dt class="text-neutral-500 text-[10px] tracking-[0.22em] uppercase mb-1 font-medium">MY ROLE</dt>
              <dd class="text-neutral-950 text-sm font-medium">Co-Design Lead &amp; Environment UX</dd>
            </div>
            <div>
              <dt class="text-neutral-500 text-[10px] tracking-[0.22em] uppercase mb-1 font-medium">METHOD</dt>
              <dd class="text-neutral-950 text-sm font-medium">Participatory Co-Design</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>

    <!-- Monumental Hero Image Spread -->
    <div class="relative overflow-hidden pt-8 border-t border-neutral-200">
      <div class="aspect-[16/10] overflow-hidden bg-white/90 border border-neutral-200/90 shadow-xs flex items-center justify-center p-6 md:p-12">
        <img
          src="/assets/cool-school/music-room-npc.png"
          alt="Characters interacting in the Cool School music room"
          class="w-full h-full object-contain hover:scale-[1.01] transition-luxury duration-700"
        />
      </div>
      <div class="flex items-center justify-between text-[10px] font-mono tracking-widest text-neutral-600 uppercase mt-4 border-t border-neutral-200 pt-3 font-medium">
        <span>Music Room &amp; Campus Exploration</span>
        <span>Interactive NPC Dialog &amp; Discovery</span>
      </div>
    </div>
  </section>

  <!-- SECTION 01: AUDIENCE & PROJECT SCOPE -->
  <section class="py-24 border-y border-neutral-200 mb-36 md:mb-52">
    <div class="text-[10px] font-mono tracking-[0.28em] text-neutral-600 uppercase mb-16 font-medium">
      01 / Audience &amp; Project Scope
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-16 md:gap-12">
      <div class="space-y-4">
        <div class="font-serif text-6xl sm:text-7xl lg:text-8xl font-normal text-neutral-950 tracking-tight tabular-nums">
          4–7<span class="text-amber-800 font-sans text-4xl sm:text-5xl font-medium"> Yrs</span>
        </div>
        <div class="text-[10px] font-mono uppercase tracking-[0.28em] text-neutral-600 font-medium">DEVELOPMENTAL AGE BAND</div>
        <p class="text-sm text-neutral-700 font-normal leading-relaxed max-w-[32ch]">
          Tailored to early childhood cognition, prioritizing visual-spatial guidance and voice-assisted micro-prompts.
        </p>
      </div>

      <div class="space-y-4">
        <div class="font-serif text-6xl sm:text-7xl lg:text-8xl font-normal text-neutral-950 tracking-tight tabular-nums">
          26<span class="text-amber-800 font-sans text-4xl sm:text-5xl font-medium"> Units</span>
        </div>
        <div class="text-[10px] font-mono uppercase tracking-[0.28em] text-neutral-600 font-medium">CONFLICT RESOLUTION SCENARIOS</div>
        <p class="text-sm text-neutral-700 font-normal leading-relaxed max-w-[32ch]">
          Extensively researched behavioral science challenges re-anchored into natural, open-world campus locations.
        </p>
      </div>

      <div class="space-y-4">
        <div class="font-serif text-6xl sm:text-7xl lg:text-8xl font-normal text-neutral-950 tracking-tight tabular-nums">
          100<span class="text-amber-800 font-sans text-4xl sm:text-5xl font-medium">%</span>
        </div>
        <div class="text-[10px] font-mono uppercase tracking-[0.28em] text-neutral-600 font-medium">PEDAGOGICAL FIDELITY PRESERVED</div>
        <p class="text-sm text-neutral-700 font-normal leading-relaxed max-w-[32ch]">
          Maintained clinical learning efficacy while replacing rigid linear rail progression with exploratory agency.
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION 02: THE LEARNING SHIFT · BEYOND THE FIXED RAIL -->
  <section class="mb-48 md:mb-60">
    <div class="pb-5 mb-20 border-b border-neutral-200">
      <div class="text-[10px] font-mono tracking-[0.28em] text-neutral-600 uppercase font-medium">
        02 / The Shift: From Rigid Rail to Open Play
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1.2fr_0.8fr] gap-16 lg:gap-24 items-start">
      <div class="space-y-8">
        <h2 class="font-serif text-4xl sm:text-6xl text-neutral-950 leading-[1.05] tracking-tight font-normal text-balance">
          Giving young learners reasons to explore between lessons.
        </h2>
        <div class="space-y-6 text-neutral-700 font-normal text-lg leading-[1.8] max-w-[54ch]">
          <p class="text-neutral-950 font-normal text-xl leading-relaxed">
            In the original game, resolving 26 conflicts meant collecting A through Z trophies in a strict linear rail. Once finished, children had zero incentive to replay or deepen their emotional mastery.
          </p>
          <p class="text-neutral-700">
            We expanded the world beyond isolated tests: children freely explore school buildings, initiate spontaneous interactions with quirky peers, and unlock cosmetic avatar accessories through active empathy and conflict de-escalation.
          </p>
        </div>
      </div>

      <div class="space-y-6 font-mono text-xs text-neutral-700 pt-2 border-t border-neutral-200">
        <div class="text-[10px] uppercase tracking-[0.28em] text-neutral-600 font-medium">REDESIGN PILLARS</div>
        <div class="space-y-4">
          <div class="flex items-start gap-4">
            <span class="text-amber-800 font-semibold tabular-nums">01</span>
            <span>Unconstrained campus navigation with playful micro-interactions.</span>
          </div>
          <div class="flex items-start gap-4">
            <span class="text-amber-800 font-semibold tabular-nums">02</span>
            <span>Self-directed avatar customization establishing personal investment.</span>
          </div>
          <div class="flex items-start gap-4">
            <span class="text-amber-800 font-semibold tabular-nums">03</span>
            <span>Open-ended achievement economy replacing the finite A-to-Z rail.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 03: PLAY ARCHITECTURE (Core Experience Features) -->
  <section class="mb-48 md:mb-60">
    <div class="pb-5 mb-20 border-b border-neutral-200">
      <div class="text-[10px] font-mono tracking-[0.28em] text-neutral-600 uppercase font-medium">
        03 / Core Gameplay &amp; Exploration Features
      </div>
    </div>

    <div class="max-w-4xl mb-24">
      <h2 class="font-serif text-4xl sm:text-6xl text-neutral-950 mb-6 font-normal text-balance">
        A world to explore. A character to make your own.
      </h2>
      <p class="text-xl text-neutral-800 font-normal leading-[1.7] max-w-[52ch]">
        The new system pairs emotional learning with expressive agency, giving children autonomy over how they present themselves and navigate school spaces.
      </p>
    </div>

    <div class="space-y-48">
      
      <!-- Feature 01: Avatar Customization -->
      <article class="grid grid-cols-1 lg:grid-cols-[1.3fr_0.7fr] gap-16 items-start group">
        <div class="relative overflow-hidden">
          <div class="aspect-[16/10] overflow-hidden bg-white/90 border border-neutral-200/90 shadow-xs">
            <img
              src="/assets/cool-school/avatar-customization.png"
              alt="Avatar customization screen with clothing and appearance options"
              class="w-full h-full object-contain p-6 group-hover:scale-[1.01] transition-luxury duration-700"
            />
          </div>
          <div class="flex items-center justify-between text-[10px] font-mono tracking-widest text-neutral-600 uppercase mt-4 border-t border-neutral-200 pt-3 font-medium">
            <span>Avatar Customization</span>
            <span>Identity &amp; Self-Expression</span>
          </div>
        </div>

        <div class="space-y-5 lg:pt-2">
          <span class="text-[10px] font-mono text-amber-800 uppercase tracking-widest block font-medium">FEATURE 01</span>
          <h3 class="text-3xl font-serif text-neutral-950 group-hover:text-amber-800 transition-colors font-normal">
            A Character to Make Their Own
          </h3>
          <p class="text-base text-neutral-700 font-normal leading-[1.75]">
            Customizable avatars allow young children to express their unique identities. Earning shirts, hats, and glasses through de-escalation achievements extends their emotional investment in their digital surrogate.
          </p>
        </div>
      </article>

      <!-- Feature 02: Daily Achievements & Continuous Goals -->
      <article class="grid grid-cols-1 lg:grid-cols-[0.7fr_1.3fr] gap-16 items-start group">
        <div class="space-y-5 order-2 lg:order-1 lg:pt-2">
          <span class="text-[10px] font-mono text-amber-800 uppercase tracking-widest block font-medium">FEATURE 02</span>
          <h3 class="text-3xl font-serif text-neutral-950 group-hover:text-amber-800 transition-colors font-normal">
            Daily Goals &amp; Open Progress
          </h3>
          <p class="text-base text-neutral-700 font-normal leading-[1.75]">
            Dynamic daily challenges replace the static 26-step finish line. Players earn XP and coins by demonstrating empathy, listening skills, and cooperative sharing across different campus zones.
          </p>
        </div>

        <div class="order-1 lg:order-2 relative overflow-hidden">
          <div class="aspect-[16/10] overflow-hidden bg-white/90 border border-neutral-200/90 shadow-xs">
            <img
              src="/assets/cool-school/achievements.png"
              alt="Cool School achievements screen showing goals and rewards"
              class="w-full h-full object-contain p-6 group-hover:scale-[1.01] transition-luxury duration-700"
            />
          </div>
          <div class="flex items-center justify-between text-[10px] font-mono tracking-widest text-neutral-600 uppercase mt-4 border-t border-neutral-200 pt-3 font-medium">
            <span>Daily Achievements</span>
            <span>Continuous Goal Tracking</span>
          </div>
        </div>
      </article>

      <!-- Feature 03: In-Game Accessories Shop -->
      <article class="grid grid-cols-1 lg:grid-cols-[1.3fr_0.7fr] gap-16 items-start group">
        <div class="relative overflow-hidden">
          <div class="aspect-[16/10] overflow-hidden bg-white/90 border border-neutral-200/90 shadow-xs">
            <img
              src="/assets/cool-school/accessories-shop.png"
              alt="In-game shop where players can spend coins on avatar accessories"
              class="w-full h-full object-contain p-6 group-hover:scale-[1.01] transition-luxury duration-700"
            />
          </div>
          <div class="flex items-center justify-between text-[10px] font-mono tracking-widest text-neutral-600 uppercase mt-4 border-t border-neutral-200 pt-3 font-medium">
            <span>In-Game Boutique</span>
            <span>Ethical Pro-Social Rewards</span>
          </div>
        </div>

        <div class="space-y-5 lg:pt-2">
          <span class="text-[10px] font-mono text-amber-800 uppercase tracking-widest block font-medium">FEATURE 03</span>
          <h3 class="text-3xl font-serif text-neutral-950 group-hover:text-amber-800 transition-colors font-normal">
            Incentive Loop &amp; Reinforcement
          </h3>
          <p class="text-base text-neutral-700 font-normal leading-[1.75]">
            A kid-friendly virtual boutique lets learners spend earned currency on animated accessories. This creates an ethical, rewarding loop where pro-social resolution translates directly into delightful self-expression.
          </p>
        </div>
      </article>

    </div>
  </section>

  <!-- SECTION 04: INTERACTIVE FIGMA PROTOTYPE EMBED -->
  <section class="py-24 border-y border-neutral-200 mb-36 md:mb-52">
    <div class="pb-5 mb-16 border-b border-neutral-200">
      <div class="text-[10px] font-mono tracking-[0.28em] text-neutral-600 uppercase font-medium">
        04 / Interactive Figma Prototype
      </div>
    </div>

    <div class="bg-white/90 border border-neutral-200/90 shadow-xs p-8 md:p-12">
      <div data-prototype-placeholder class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h3 class="font-serif text-3xl text-neutral-950 mb-2 font-normal">Experience the Cool School Campus Prototype</h3>
          <p class="text-sm text-neutral-700 font-normal max-w-prose">
            This interactive prototype includes full environment navigation, audio assets, and avatar styling.
          </p>
        </div>
        <div class="flex shrink-0 flex-col items-start gap-3 sm:items-end">
          <button type="button" data-load-prototype
            class="inline-flex items-center gap-2 px-6 py-3 bg-neutral-950 text-white font-mono text-xs uppercase tracking-wider hover:bg-amber-800 transition-luxury shadow-xs font-medium">
            <span>▶</span> Load Interactive Prototype
          </button>
          <a href="https://www.figma.com/proto/KvYJ7MyuaJeb8vZejYV0XJ/Sprint-5-Final-Prototype-Copy?node-id=202-27991&amp;t=xEFnCj4QRz8vnQLv-0&amp;scaling=scale-down&amp;content-scaling=fixed&amp;starting-point-node-id=202%3A27991&amp;show-proto-sidebar=1"
            target="_blank" rel="noopener noreferrer"
            class="action-potential-link text-xs font-mono text-neutral-700 hover:text-amber-800 pb-0.5 transition-colors font-medium">
            Open in Figma ↗
          </a>
        </div>
      </div>
      <div data-prototype-frame class="aspect-video w-full mt-6" hidden></div>
    </div>
  </section>

  <!-- SECTION 05: CO-DESIGN RESEARCH PROTOCOLS -->
  <section class="py-24 border-t border-neutral-200 mb-32 md:mb-48">
    <div class="pb-5 mb-16 border-b border-neutral-200">
      <div class="text-[10px] font-mono tracking-[0.28em] text-neutral-600 uppercase font-medium">
        05 / Participatory Research with Children
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-16">
      <div class="space-y-4">
        <span class="text-[10px] font-mono text-neutral-600 uppercase tracking-widest block font-medium">METHOD 01</span>
        <h4 class="text-lg font-medium text-neutral-950">Pediatric Game Pattern Heuristics</h4>
        <p class="text-sm text-neutral-700 font-normal leading-relaxed">
          Benchmarking interaction patterns, navigation clarity, and reward cadence across premier kids' gaming titles to isolate friction points.
        </p>
      </div>

      <div class="space-y-4">
        <span class="text-[10px] font-mono text-neutral-600 uppercase tracking-widest block font-medium">METHOD 02</span>
        <h4 class="text-lg font-medium text-neutral-950">KidsTeam Participatory Sessions</h4>
        <p class="text-sm text-neutral-700 font-normal leading-relaxed">
          Facilitated co-design workshops with young children and developmental experts, testing paper prototypes and avatar sketches to align with natural play behaviors.
        </p>
      </div>

      <div class="space-y-4">
        <span class="text-[10px] font-mono text-neutral-600 uppercase tracking-widest block font-medium">METHOD 03</span>
        <h4 class="text-lg font-medium text-neutral-950">Tangible Environment Prototyping</h4>
        <p class="text-sm text-neutral-700 font-normal leading-relaxed">
          Constructed multi-room campus environments and interactive NPC dialog branches within Figma, validating smooth navigation and cognitive accessibility.
        </p>
      </div>
    </div>
  </section>

  <!-- CHAPTER NAVIGATION: Architectural Broadsheet Links -->
  <section class="pt-16 border-t border-neutral-200">
    <div class="flex flex-col sm:flex-row items-baseline justify-between gap-12 font-mono text-xs">
      <a href="/omara" class="group flex flex-col gap-2 transition-luxury">
        <span class="text-[10px] tracking-widest uppercase text-neutral-600 group-hover:text-amber-800 font-medium">← PREVIOUS CASE STUDY</span>
        <span class="font-serif text-2xl font-normal text-neutral-950 group-hover:text-amber-800">Omara: GovTech Systems</span>
        <span class="font-sans text-xs text-neutral-600 font-normal">Caseworker triage workflows &amp; design-system automation</span>
      </a>

      <a href="/alirtify" class="group flex flex-col gap-2 sm:text-right transition-luxury">
        <span class="text-[10px] tracking-widest uppercase text-neutral-600 group-hover:text-amber-800 font-medium">NEXT CASE STUDY →</span>
        <span class="font-serif text-2xl font-normal text-neutral-950 group-hover:text-amber-800">Alirtify: Real-Time Alerting</span>
        <span class="font-sans text-xs text-neutral-600 font-normal">Data-driven credibility signals &amp; triage heuristics</span>
      </a>
    </div>
  </section>

</main>
</BaseLayout>

<script>
  const loadButton = document.querySelector<HTMLButtonElement>('[data-load-prototype]');
  const placeholder = document.querySelector<HTMLElement>('[data-prototype-placeholder]');
  const frameContainer = document.querySelector<HTMLElement>('[data-prototype-frame]');

  if (loadButton && placeholder && frameContainer) {
    loadButton.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      const prototypeUrl =
        'https://www.figma.com/proto/KvYJ7MyuaJeb8vZejYV0XJ/Sprint-5-Final-Prototype-Copy?node-id=202-27991&t=xEFnCj4QRz8vnQLv-0&scaling=scale-down&content-scaling=fixed&starting-point-node-id=202%3A27991&show-proto-sidebar=1';
      iframe.src = `https://www.figma.com/embed?embed_host=share&url=${encodeURIComponent(prototypeUrl)}`;
      iframe.title = 'Interactive Cool School Figma prototype';
      iframe.className = 'h-full w-full border-0';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.loading = 'eager';

      frameContainer.replaceChildren(iframe);
      frameContainer.hidden = false;
      placeholder.hidden = true;
    }, { once: true });
  }
</script>
