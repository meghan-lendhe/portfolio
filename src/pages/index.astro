---
import BaseLayout from '../layouts/BaseLayout.astro';
import RestingRule from '../components/case-study/RestingRule.astro';
---

<BaseLayout title="Meghan Lendhe — Product Designer & NeuroHCI Researcher" theme="light">

<!-- Theatrical Global Ignition Aura (Single simple ambient blur, centered dynamically at trigger point) -->
<div id="ignition-aura" class="absolute pointer-events-none -z-15 w-[90vw] max-w-5xl h-[420px] rounded-full blur-3xl opacity-0 transition-opacity duration-1000 bg-[radial-gradient(ellipse_at_center,rgba(245,158,11,0.18),rgba(13,148,136,0.12),transparent_70%)]" style="top: 350px; left: 50%; transform: translate(-50%, -50%);"></div>

<!-- Interactive Histological Neural Simulation Canvas (Thought Scribing, Cascades & Ignition) -->
<canvas id="synaptic-field" class="absolute top-0 inset-x-0 w-full pointer-events-none -z-10"></canvas>

<main id="main" class="relative max-w-page mx-auto px-6 md:px-20 pb-72 pt-28 md:pt-40 font-sans text-neutral-800 selection:bg-amber-500/20 selection:text-neutral-900">

    <!-- HERO SECTION: Luminous & Grounded Career Opening -->
    <section id="hero" aria-labelledby="hero-title" class="relative mb-32 md:mb-48">
      <!-- Monumental Career Headline -->
      <div class="max-w-6xl mb-16 relative">
        <h1 id="hero-title" class="font-serif text-5xl sm:text-7xl lg:text-[6.75rem] font-normal leading-[0.93] tracking-[-0.04em] text-neutral-950 mb-8 text-balance transition-all duration-700">
          Designing for the era of neural interfaces.
        </h1>

        <!-- Intermediate Scale Bridge -->
        <p class="text-2xl sm:text-3xl text-neutral-800 font-normal leading-snug tracking-tight mb-14 max-w-[50ch]">
          I’m Meghan Lendhe—a product designer building technical depth in NeuroHCI.
        </p>

        <div class="grid grid-cols-1 lg:grid-cols-[1.35fr_0.65fr] gap-12 lg:gap-20 items-start">
          <div>
            <p class="text-lg sm:text-xl text-neutral-700 font-normal leading-[1.8] max-w-[52ch] text-pretty">
              While my foundation is in end-to-end product design, my focus is set on what comes next: defining the neural interfaces that will make interaction between humans and computers genuinely seamless.
            </p>
          </div>

          <!-- Section Roadmap (Clear, Human, Zero Boxes) -->
          <div class="space-y-6 lg:pt-1">
            <div class="text-[10px] font-mono uppercase tracking-[0.28em] text-neutral-600 font-medium">EXPLORE WORK</div>
            <nav aria-label="Page navigation" class="flex flex-col gap-3 font-mono text-xs tracking-wider">
              <a href="#research" class="group flex items-center justify-between border-b border-neutral-200 pb-2.5 text-neutral-900 transition-luxury hover:text-amber-700 hover:border-amber-500 font-medium">
                <span>01. NEUROHCI &amp; BIOSIGNALS</span>
                <span class="text-neutral-500 group-hover:text-amber-700 group-hover:translate-x-1.5 transition-luxury">→</span>
              </a>
              <a href="#product-design" class="group flex items-center justify-between border-b border-neutral-200 pb-2.5 text-neutral-700 transition-luxury hover:text-neutral-950 hover:border-neutral-400 font-medium">
                <span>02. PRODUCT DESIGN CASE STUDIES</span>
                <span class="text-neutral-500 group-hover:text-neutral-950 group-hover:translate-x-1.5 transition-luxury">→</span>
              </a>
            </nav>
          </div>
        </div>
      </div>

    </section>

    <!-- Architectural Section Divider -->
    <RestingRule class="mb-32 md:mb-40" />

    <!-- SECTION 01: NEUROHCI EXPLORATION -->
    <section id="research" aria-labelledby="monograph-title" class="mb-36 md:mb-48 scroll-mt-32">
      
      <!-- Broadsheet Spread: Cortical Topography Map (Left) & Distilled Monograph Narrative (Right) -->
      <div class="grid grid-cols-1 lg:grid-cols-[1.05fr_0.95fr] gap-12 lg:gap-20 items-center">
        
        <!-- Left: The Cortical Topography Scalp Field (Object of Intrigue) -->
        <div class="relative flex flex-col items-center">
          <div class="relative w-full aspect-square max-w-[420px] mx-auto cursor-crosshair">
            <canvas id="cortical-topography" class="w-full h-full block"></canvas>
          </div>
        </div>

        <!-- Right: Distilled Narrative & Archival Specimen Link -->
        <div class="space-y-8 relative">
          <div>
            <h2 id="monograph-title" class="font-serif text-3xl sm:text-5xl lg:text-[3.35rem] font-normal text-neutral-950 leading-[1.02] tracking-[-0.035em] text-balance">
              Zero-Calibration Neural Decoding
            </h2>
          </div>

          <div class="space-y-5 text-neutral-800 font-normal text-base sm:text-lg leading-[1.75] max-w-[48ch]">
            <p class="text-neutral-950 text-xl leading-relaxed">
              Classifying three distinct cognitive modalities—motor imagery, mental arithmetic, and speech—from raw electrophysiology across unseen subjects and sessions without pre-session calibration.
            </p>
            <p class="text-neutral-600 text-base leading-relaxed">
              A full, dedicated case study detailing my process and artifacts is in progress.
            </p>
          </div>
        </div>

      </div>

    </section>

    <!-- Architectural Section Divider -->
    <RestingRule class="mb-24 md:mb-32" />

    <!-- SECTION 02: PRODUCT DESIGN & COMPLEX WORKFLOWS -->
    <section id="product-design" aria-labelledby="product-title" class="pt-8">
      
      <div class="max-w-4xl mb-24">
        <h2 id="product-title" class="font-serif text-4xl sm:text-6xl font-normal text-neutral-950 mb-6 tracking-[-0.035em]">
          Product Design
        </h2>
        <p class="text-xl text-neutral-700 font-normal leading-[1.75] max-w-[52ch]">
          I spent the past few years designing digital products across e-commerce, government services, and healthcare.
        </p>
      </div>

      <!-- CASE STUDY SPREADS -->
      <div class="space-y-36 md:space-y-48">
        
        <!-- Case Study 01: Omara Technologies -->
        <article class="flex flex-col gap-8 lg:gap-10 group">
          <div class="relative overflow-hidden bg-neutral-100 rounded-xs border border-neutral-200/80">
            <a href="/omara" class="block aspect-[16/9.5] overflow-hidden">
              <img
                src="/assets/experience/omara-cover.png"
                alt="Omara welfare application review and design-system tooling"
                class="w-full h-full object-cover group-hover:scale-[1.012] transition-luxury duration-700"
              />
            </a>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.35fr] gap-6 lg:gap-16 items-start pt-2">
            <h3 class="text-3xl sm:text-4xl lg:text-[2.6rem] font-serif font-normal text-neutral-950 tracking-[-0.03em] leading-[1.1] group-hover:text-amber-800 transition-colors">
              Omara: Public Welfare Systems &amp; Design Automation
            </h3>
            <div class="space-y-4">
              <p class="text-base sm:text-lg text-neutral-700 font-normal leading-[1.75]">
                Designed synchronized citizen and caseworker platforms for welfare schemes while engineering agentic Figma skills for GIGW-compliant governance.
              </p>
              <div>
                <a href="/omara" class="action-potential-link inline-flex items-center gap-1.5 text-xs font-mono text-neutral-900 hover:text-amber-800 pb-1 transition-luxury group font-medium">
                  <span>View Operational Retrospective</span>
                  <span class="group-hover:translate-x-1 transition-luxury">→</span>
                </a>
              </div>
            </div>
          </div>
        </article>

        <!-- Case Study 02: BulkMagic -->
        <article class="flex flex-col gap-8 lg:gap-10 group">
          <div class="relative overflow-hidden bg-neutral-100 rounded-xs border border-neutral-200/80">
            <a href="/bulkmagic" class="block aspect-[16/9.5] overflow-hidden">
              <img
                src="/assets/bulkmagic/cover-vitrine.png"
                alt="BulkMagic multi-state merchant onboarding interface suite overview"
                class="w-full h-full object-cover group-hover:scale-[1.012] transition-luxury duration-700"
              />
            </a>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.35fr] gap-6 lg:gap-16 items-start pt-2">
            <h3 class="text-3xl sm:text-4xl lg:text-[2.6rem] font-serif font-normal text-neutral-950 tracking-[-0.03em] leading-[1.1] group-hover:text-amber-800 transition-colors">
              BulkMagic: Merchant Onboarding Sprint
            </h3>
            <div class="space-y-4">
              <p class="text-base sm:text-lg text-neutral-700 font-normal leading-[1.75]">
                In a rapid sprint spanning just over a day, translated statutory tax compliance, entity structures, and economic nexus rules into an adaptive, progressive disclosure onboarding journey for marketplace sellers.
              </p>
              <div>
                <a href="/bulkmagic" class="action-potential-link inline-flex items-center gap-1.5 text-xs font-mono text-neutral-900 hover:text-amber-800 pb-1 transition-luxury group font-medium">
                  <span>View BulkMagic Sprint</span>
                  <span class="group-hover:translate-x-1 transition-luxury">→</span>
                </a>
              </div>
            </div>
          </div>
        </article>

        <!-- Case Study 03: Vitals Digital Medical ID -->
        <article class="flex flex-col gap-8 lg:gap-10 group">
          <div class="relative overflow-hidden bg-neutral-100 rounded-xs border border-neutral-200/80">
            <a href="/vitals" class="block aspect-[16/9.5] overflow-hidden">
              <img
                src="/assets/vitals/cover.png"
                alt="Vitals medical ID onboarding"
                class="w-full h-full object-cover group-hover:scale-[1.012] transition-luxury duration-700"
              />
            </a>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.35fr] gap-6 lg:gap-16 items-start pt-2">
            <h3 class="text-3xl sm:text-4xl lg:text-[2.6rem] font-serif font-normal text-neutral-950 tracking-[-0.03em] leading-[1.1] group-hover:text-amber-800 transition-colors">
              Vitals: Digital Medical ID
            </h3>
            <div class="space-y-4">
              <p class="text-base sm:text-lg text-neutral-700 font-normal leading-[1.75]">
                Redesigned emergency medical onboarding to solve a 92% drop-off barrier for vulnerable patients, establishing foundational trust and clear privacy control before requesting sensitive medical history.
              </p>
              <div>
                <a href="/vitals" class="action-potential-link inline-flex items-center gap-1.5 text-xs font-mono text-neutral-900 hover:text-amber-800 pb-1 transition-luxury group font-medium">
                  <span>View Vitals Case Study</span>
                  <span class="group-hover:translate-x-1 transition-luxury">→</span>
                </a>
              </div>
            </div>
          </div>
        </article>

      </div>
    </section>

  </main>

</BaseLayout>

<script is:inline>
  // Advanced Theatrical Histological Neural Simulation Suite
  // Features:
  // 1. Biological Cytology & Varicose Axons
  // 2. Unmyelinated Dendritic Cursor Trailing (Tapers & Dissolves <150ms)
  // 3. Thought Scribing (Pointer Drag -> Custom Engram Circuit Formation)
  // 4. Global Cortical Ignition (Triggered via Rapid Interaction & Engram Resonance)
  // 5. Web Audio Biofeedback (Pythagorean Synaptic Chimes & Ignition Chord Swell)
  (function() {
    const canvas = document.getElementById('synaptic-field');
    const aura = document.getElementById('ignition-aura');
    let auraTimeout = null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');

    let width, height;
    let mouse = { x: -1000, y: -1000, isDown: false, active: false };
    const neurons = [];
    const connections = [];
    const activePulses = [];

    // Micro-Acoustics Biofeedback (Leveraging global window.NeuroAudio)
    const pentatonicScale = (window.NeuroAudio && window.NeuroAudio.scale) || [293.66, 329.63, 369.99, 440.00, 493.88, 587.33, 659.25];

    function playTactileStimulus(intensity = 0.032) {
      if (window.NeuroAudio) window.NeuroAudio.playMallet(intensity);
    }

    function playSynapticChime(freq = 440, volume = 0.065) {
      if (window.NeuroAudio) window.NeuroAudio.playCelesta(freq, volume);
    }

    // Graceful Cinematic Global Ignition Cascade
    function playIgnitionChord() {
      if (!window.NeuroAudio) return;
      const chordTones = [293.66, 369.99, 440.00, 587.33, 739.99, 880.00];
      chordTones.forEach((f, idx) => {
        setTimeout(() => {
          window.NeuroAudio.playCelesta(f, 0.035);
        }, idx * 70);
      });
    }

    function resize() {
      const isMobile = window.innerWidth < 768;
      const dpr = Math.min(window.devicePixelRatio || 1, isMobile ? 1.5 : 2);
      width = window.innerWidth;
      const heroEl = document.getElementById('hero');
      if (heroEl) {
        const heroRect = heroEl.getBoundingClientRect();
        height = Math.max(550, Math.round(heroRect.bottom + window.scrollY));
      } else {
        height = Math.max(550, Math.min(window.innerHeight, 750));
      }
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = width + 'px';
      canvas.style.height = height + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    resize();
    window.addEventListener('resize', resize);

    // Track mouse & pointer for Thought Scribing
    const scribedEngram = [];
    let isIgniting = false;
    let rapidStimulusCount = 0;
    let lastStimulusTime = 0;

    window.addEventListener('pointermove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY + window.scrollY;
      mouse.active = true;

      if (mouse.isDown) {
        scribedEngram.push({ x: mouse.x, y: mouse.y, time: Date.now() });
        for (let i = 0; i < neurons.length; i++) {
          const n = neurons[i];
          const d = Math.hypot(mouse.x - n.x, mouse.y - n.y);
          if (d < 45 && !n.isEngramRecruited) {
            n.isEngramRecruited = true;
            n.potential = 0.9;
            playSynapticChime(pentatonicScale[i % pentatonicScale.length], 0.04);
          }
        }
      }
    });

    window.addEventListener('pointerleave', () => {
      mouse.active = false;
      mouse.isDown = false;
    });

    // Pointerdown: Stimulus Injection & Rapid Summation Check
    window.addEventListener('pointerdown', (e) => {
      if (e.target.closest('a') || e.target.closest('button')) return;

      const clickX = e.clientX;
      const clickY = e.clientY + window.scrollY;

      if (clickY > height + 40) {
        rapidStimulusCount = 0;
        return;
      }

      mouse.isDown = true;
      scribedEngram.length = 0;

      const now = Date.now();
      if (now - lastStimulusTime < 750) {
        rapidStimulusCount++;
      } else {
        rapidStimulusCount = 1;
      }
      lastStimulusTime = now;

      if (rapidStimulusCount >= 3 && !isIgniting) {
        rapidStimulusCount = 0;
        triggerGlobalIgnition(clickX, clickY);
        return;
      }

      let anyFired = false;
      let anyStimulated = false;

      for (let i = 0; i < neurons.length; i++) {
        const n = neurons[i];
        n.isEngramRecruited = false;
        const dist = Math.hypot(clickX - n.x, clickY - n.y);

        if (dist < 240) {
          const stimulus = Math.pow(1 - dist / 240, 1.3) * 0.75;
          if (n.refractory <= 0) {
            n.potential += stimulus;
            anyStimulated = true;
            if (n.potential >= n.currentThreshold) {
              fireNeuron(n, -1, 0);
              anyFired = true;
            }
          }
        }
      }

      if (!anyFired && anyStimulated) {
        playTactileStimulus(0.032);
      }
    });

    // Pointerup: Release Thought Scribe -> Ignite Engram Circuit -> Critical Avalanche
    window.addEventListener('pointerup', () => {
      if (mouse.isDown && scribedEngram.length > 5) {
        const recruited = neurons.filter(n => n.isEngramRecruited);
        if (recruited.length > 1) {
          recruited.forEach((rn, idx) => {
            setTimeout(() => {
              fireNeuron(rn, -1, 0);
            }, idx * 60);
          });

          if (recruited.length >= 4 && !isIgniting) {
            const avgX = recruited.reduce((sum, n) => sum + n.x, 0) / recruited.length;
            const avgY = recruited.reduce((sum, n) => sum + n.y, 0) / recruited.length;
            setTimeout(() => {
              triggerGlobalIgnition(avgX, avgY);
            }, recruited.length * 60 + 150);
          }
        }
      }
      mouse.isDown = false;
      neurons.forEach(n => n.isEngramRecruited = false);
    });

    const isMobile = typeof window !== 'undefined' && window.innerWidth < 768;
    const morphTypes = ['pyramidal', 'multipolar', 'bipolar'];
    const numNeurons = isMobile ? 24 : 66;

    for (let i = 0; i < numNeurons; i++) {
      const maxSpawnY = (height || 720) * 0.85;
      const baseX = Math.random() * (width || window.innerWidth);
      const baseY = Math.random() * maxSpawnY;
      const type = morphTypes[i % morphTypes.length];
      const baseRadius = 4.0 + Math.random() * 2.5;

      let angle = Math.random() * Math.PI * 2;
      if (type === 'pyramidal') {
        angle = -Math.PI * 0.5 + (Math.random() - 0.5) * 0.75;
      } else if (type === 'bipolar') {
        angle = -Math.PI * 0.5 + (Math.random() - 0.5) * 0.9;
      }

      neurons.push({
        id: i,
        baseX: baseX,
        baseY: baseY,
        x: baseX,
        y: baseY,
        type: type,
        radius: baseRadius,
        angle: angle,
        phase: Math.random() * Math.PI * 2,
        driftSpeed: 0.0003 + Math.random() * 0.0005,
        driftRadius: 2.0 + Math.random() * 3.5,
        potential: 0.0,
        baseThreshold: 0.82,
        currentThreshold: 0.82,
        refractory: 0,
        spikeEnergy: 0.0,
        jitterX: 0,
        jitterY: 0,
        connectedIndices: [],
        isEngramRecruited: false
      });
    }

    // Cubic Bézier Evaluation Helpers
    function getCubicPoint(x0, y0, cp1x, cp1y, cp2x, cp2y, x1, y1, t) {
      const invT = 1 - t;
      const c0 = invT * invT * invT;
      const c1 = 3 * invT * invT * t;
      const c2 = 3 * invT * t * t;
      const c3 = t * t * t;
      return {
        x: c0 * x0 + c1 * cp1x + c2 * cp2x + c3 * x1,
        y: c0 * y0 + c1 * cp1y + c2 * cp2y + c3 * y1
      };
    }

    function getCubicControlPoints(nA, nB, conn) {
      const isForward = (conn.from === nA.id);
      const dx = nB.x - nA.x;
      const dy = nB.y - nA.y;
      const d = Math.hypot(dx, dy) || 1;
      const nx = -dy / d;
      const ny = dx / d;

      if (isForward) {
        return {
          cp1x: nA.x + dx * conn.t1 + nx * conn.offset1,
          cp1y: nA.y + dy * conn.t1 + ny * conn.offset1,
          cp2x: nA.x + dx * conn.t2 + nx * conn.offset2,
          cp2y: nA.y + dy * conn.t2 + ny * conn.offset2
        };
      } else {
        return {
          cp1x: nA.x + dx * (1 - conn.t2) - nx * conn.offset2,
          cp1y: nA.y + dy * (1 - conn.t2) - ny * conn.offset2,
          cp2x: nA.x + dx * (1 - conn.t1) - nx * conn.offset1,
          cp2y: nA.y + dy * (1 - conn.t1) - ny * conn.offset1
        };
      }
    }

    function addAxonalConnection(i, j, isCollateral = false) {
      if (neurons[i].connectedIndices.includes(j)) return;
      neurons[i].connectedIndices.push(j);
      neurons[j].connectedIndices.push(i);

      const dx = neurons[j].baseX - neurons[i].baseX;
      const dy = neurons[j].baseY - neurons[i].baseY;
      const d = Math.hypot(dx, dy) || 1;

      const sign = Math.random() > 0.5 ? 1 : -1;
      // Taut, elegant biological bowing along perpendicular normal vector:
      // Subtle 5px to 12px deflection with matching signs (No opposing S-curves)
      const bow = sign * (4.5 + Math.random() * Math.min(d * 0.08, 7.5));
      const offset1 = bow;
      const offset2 = bow * (0.85 + (Math.random() - 0.5) * 0.15); // SAME SIGN!

      const numBoutons = 2 + Math.floor(Math.random() * 2);
      const boutons = [];
      for (let b = 0; b < numBoutons; b++) {
        boutons.push({
          t: 0.25 + Math.random() * 0.50,
          radius: 1.1 + Math.random() * 0.5
        });
      }

      connections.push({
        from: i,
        to: j,
        t1: 0.35 + (Math.random() - 0.5) * 0.05,
        t2: 0.65 + (Math.random() - 0.5) * 0.05,
        offset1: offset1,
        offset2: offset2,
        boutons: boutons,
        isCollateral: isCollateral
      });
    }

    // Sparse, purposeful histological arborization
    for (let i = 0; i < neurons.length; i++) {
      if (neurons[i].connectedIndices.length >= 2) continue;

      const candidates = [];
      for (let j = 0; j < neurons.length; j++) {
        if (i === j || neurons[i].connectedIndices.includes(j)) continue;
        const dx = neurons[i].baseX - neurons[j].baseX;
        const dy = neurons[i].baseY - neurons[j].baseY;
        const d = Math.hypot(dx, dy);
        if (d > 35 && d < 205) {
          candidates.push({ id: j, d: d });
        }
      }

      candidates.sort((a, b) => a.d - b.d);

      if (candidates.length > 0 && neurons[candidates[0].id].connectedIndices.length < 3) {
        addAxonalConnection(i, candidates[0].id, false);
      }

      if (candidates.length > 1 && neurons[candidates[1].id].connectedIndices.length < 3 && Math.random() < 0.8) {
        addAxonalConnection(i, candidates[1].id, true);
      }
    }

    // Guarantee zero lonely neurons
    for (let i = 0; i < neurons.length; i++) {
      while (neurons[i].connectedIndices.length < 2) {
        let closestDist = Infinity;
        let closestIdx = -1;
        for (let j = 0; j < neurons.length; j++) {
          if (i === j || neurons[i].connectedIndices.includes(j)) continue;
          const d = Math.hypot(neurons[i].baseX - neurons[j].baseX, neurons[i].baseY - neurons[j].baseY);
          if (d < closestDist) {
            closestDist = d;
            closestIdx = j;
          }
        }
        if (closestIdx !== -1) {
          addAxonalConnection(i, closestIdx, neurons[i].connectedIndices.length > 0);
        } else break;
      }
    }

    // Fire action potential (audio-visual biofeedback)
    function fireNeuron(n, sourceId = -1, hop = 0, isIgnition = false) {
      const maxHops = isIgnition ? 7 : 4;
      if (hop > maxHops) return;

      n.potential = 0.0;
      n.spikeEnergy = 1.0;
      n.refractory = isIgnition ? 22 : 40;
      n.currentThreshold = n.baseThreshold + (isIgnition ? 0.08 : 0.22);

      const freq = pentatonicScale[n.id % pentatonicScale.length] * (hop === 0 ? 1 : (hop === 1 ? 1.25 : 1.5));
      playSynapticChime(freq, isIgnition ? 0.028 : 0.06);

      for (let k = 0; k < n.connectedIndices.length; k++) {
        const targetId = n.connectedIndices[k];
        if (targetId === sourceId) continue;

        const targetNeuron = neurons[targetId];
        let targetConn = null;
        for (let c = 0; c < connections.length; c++) {
          if ((connections[c].from === n.id && connections[c].to === targetId) ||
              (connections[c].from === targetId && connections[c].to === n.id)) {
            targetConn = connections[c];
            break;
          }
        }

        activePulses.push({
          fromNeuron: n,
          toNeuron: targetNeuron,
          conn: targetConn,
          progress: 0.0,
          speed: 0.030 + Math.random() * 0.012,
          hop: hop + 1,
          energy: isIgnition ? Math.max(0.65, 1.0 - hop * 0.06) : Math.max(0.35, 1.0 - hop * 0.22),
          isIgnition: isIgnition
        });
      }
    }

    // Trigger Theatrical Global Cortical Ignition via True Axonal Avalanche
    function triggerGlobalIgnition(originX = width * 0.5, originY = 350) {
      if (isIgniting) return;
      isIgniting = true;

      if (aura) {
        aura.style.left = `${originX}px`;
        aura.style.top = `${originY}px`;
        aura.style.opacity = '1';
        clearTimeout(auraTimeout);
        auraTimeout = setTimeout(() => {
          aura.style.opacity = '0';
        }, 2200);
      }

      playIgnitionChord();

      neurons.forEach(n => {
        n.refractory = 0;
        n.currentThreshold = n.baseThreshold;
      });

      const sortedByDist = neurons
        .map(n => ({ neuron: n, d: Math.hypot(n.x - originX, n.y - originY) }))
        .sort((a, b) => a.d - b.d);

      const seeds = sortedByDist.slice(0, 2);
      seeds.forEach((s, idx) => {
        setTimeout(() => {
          fireNeuron(s.neuron, -1, 0, true);
        }, idx * 75);
      });

      setTimeout(() => {
        isIgniting = false;
      }, 2600);
    }

    // Soft Histological Soma Rendering
    function drawSoftHistologicalSoma(ctx, x, y, r, angle, excitation, spike, type, isRecruited) {
      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(angle);

      const grad = ctx.createRadialGradient(0, 0, r * 0.15, 0, 0, r * 2.4);

      if (spike > 0.05) {
        grad.addColorStop(0, `rgba(255, 255, 255, ${0.95 * spike})`);
        grad.addColorStop(0.25, `rgba(245, 158, 11, ${0.85 * spike})`);
        grad.addColorStop(0.65, `rgba(13, 148, 136, ${0.45 * spike})`);
        grad.addColorStop(1, 'rgba(13, 148, 136, 0)');
      } else if (isRecruited) {
        grad.addColorStop(0, 'rgba(245, 158, 11, 0.85)');
        grad.addColorStop(0.6, 'rgba(217, 119, 6, 0.4)');
        grad.addColorStop(1, 'rgba(217, 119, 6, 0)');
      } else if (excitation > 0.1) {
        grad.addColorStop(0, `rgba(217, 119, 6, ${0.4 + excitation * 0.5})`);
        grad.addColorStop(0.5, `rgba(245, 158, 11, ${0.2 + excitation * 0.35})`);
        grad.addColorStop(1, 'rgba(245, 158, 11, 0)');
      } else {
        grad.addColorStop(0, 'rgba(130, 120, 110, 0.11)');
        grad.addColorStop(0.6, 'rgba(175, 165, 155, 0.035)');
        grad.addColorStop(1, 'rgba(175, 165, 155, 0)');
      }

      ctx.fillStyle = grad;
      ctx.beginPath();
      if (type === 'pyramidal') {
        ctx.moveTo(0, -r * 1.6);
        ctx.quadraticCurveTo(r * 1.3, r * 0.3, r * 0.9, r * 1.2);
        ctx.quadraticCurveTo(0, r * 1.5, -r * 0.9, r * 1.2);
        ctx.quadraticCurveTo(-r * 1.3, r * 0.3, 0, -r * 1.6);
      } else if (type === 'bipolar') {
        ctx.ellipse(0, 0, r * 0.75, r * 1.6, 0, 0, Math.PI * 2);
      } else {
        ctx.arc(0, 0, r * 1.3, 0, Math.PI * 2);
      }
      ctx.fill();

      const nucleusR = Math.max(1.2, r * 0.38);
      ctx.beginPath();
      ctx.arc(0, 0, nucleusR, 0, Math.PI * 2);
      if (spike > 0.05) {
        ctx.fillStyle = `rgba(255, 255, 255, ${0.98 * spike})`;
      } else if (isRecruited || excitation > 0.1) {
        ctx.fillStyle = `rgba(217, 119, 6, ${0.6 + excitation * 0.35})`;
      } else {
        ctx.fillStyle = 'rgba(110, 100, 92, 0.15)';
      }
      ctx.fill();

      // Delicate dendritic arbor with Cajal gemmules (dendritic spines)
      ctx.beginPath();
      if (type === 'pyramidal') {
        // Apical dendritic trunk
        ctx.moveTo(0, -r * 1.2);
        ctx.quadraticCurveTo(r * 0.25, -r * 2.2, 0, -r * 3.4);

        // Apical gemmules / dendritic spines (micro-spines along shaft)
        ctx.moveTo(-0.4, -r * 1.8); ctx.lineTo(-r * 0.65, -r * 1.95);
        ctx.moveTo(0.4, -r * 2.4);  ctx.lineTo(r * 0.65, -r * 2.55);
        ctx.moveTo(-0.4, -r * 2.9); ctx.lineTo(-r * 0.60, -r * 3.05);

        // Terminal apical bifurcation
        ctx.moveTo(0, -r * 3.4);
        ctx.quadraticCurveTo(-r * 0.55, -r * 4.1, -r * 0.95, -r * 4.7);
        ctx.moveTo(0, -r * 3.4);
        ctx.quadraticCurveTo(r * 0.55, -r * 4.1, r * 0.95, -r * 4.7);

        // Basal dendritic skirt
        ctx.moveTo(-r * 0.8, r * 1.0);
        ctx.quadraticCurveTo(-r * 1.5, r * 1.7, -r * 2.3, r * 2.4);
        ctx.moveTo(-r * 1.5, r * 1.7);
        ctx.lineTo(-r * 2.1, r * 1.4);

        ctx.moveTo(r * 0.8, r * 1.0);
        ctx.quadraticCurveTo(r * 1.5, r * 1.7, r * 2.3, r * 2.4);
        ctx.moveTo(r * 1.5, r * 1.7);
        ctx.lineTo(r * 2.1, r * 1.4);
      } else if (type === 'bipolar') {
        // Superior and inferior poles with fine spines
        ctx.moveTo(0, -r * 1.4);
        ctx.quadraticCurveTo(r * 0.35, -r * 2.4, 0, -r * 3.5);
        ctx.moveTo(-0.4, -r * 2.2); ctx.lineTo(-r * 0.55, -r * 2.35);

        ctx.moveTo(0, r * 1.4);
        ctx.quadraticCurveTo(-r * 0.35, r * 2.4, 0, -r * 3.5);
        ctx.moveTo(0.4, r * 2.2); ctx.lineTo(r * 0.55, r * 2.35);
      } else {
        // Stellate / Multipolar radiating arbor
        const branches = 4;
        for (let b = 0; b < branches; b++) {
          const ba = (b * Math.PI * 2) / branches;
          const sx = Math.cos(ba) * r * 0.9;
          const sy = Math.sin(ba) * r * 0.9;
          const mx = Math.cos(ba + 0.25) * r * 2.0;
          const my = Math.sin(ba + 0.25) * r * 2.0;
          const ex = Math.cos(ba - 0.12) * r * 3.1;
          const ey = Math.sin(ba - 0.12) * r * 3.1;
          ctx.moveTo(sx, sy);
          ctx.quadraticCurveTo(mx, my, ex, ey);

          // Micro-twig on branch
          ctx.moveTo(mx, my);
          ctx.lineTo(mx + Math.cos(ba + 0.8) * r * 0.9, my + Math.sin(ba + 0.8) * r * 0.9);
        }
      }

      ctx.strokeStyle = spike > 0.05
        ? `rgba(13, 148, 136, ${0.5 + spike * 0.4})`
        : (isRecruited ? 'rgba(245, 158, 11, 0.7)' : (excitation > 0.1 ? `rgba(217, 119, 6, ${0.2 + excitation * 0.45})` : 'rgba(165, 155, 145, 0.06)'));
      ctx.lineWidth = 0.55;
      ctx.stroke();

      ctx.restore();
    }

    let time = 0;

    function render() {
      ctx.clearRect(0, 0, width, height);

      time += 0.004;

      // 1. Update Biological State
      for (let i = 0; i < neurons.length; i++) {
        const n = neurons[i];

        n.x = n.baseX + Math.sin(time * n.driftSpeed * 100 + n.phase) * n.driftRadius;
        n.y = n.baseY + Math.cos(time * n.driftSpeed * 80 + n.phase) * (n.driftRadius * 0.65);

        if (mouse.active && !mouse.isDown) {
          const dist = Math.hypot(mouse.x - n.x, mouse.y - n.y);
          if (dist < 135 && n.refractory <= 0) {
            const hoverEPSP = (1 - dist / 135) * 0.01;
            n.potential = Math.min(n.currentThreshold - 0.05, n.potential + hoverEPSP);
          }
        }

        n.potential *= 0.985;
        if (n.currentThreshold > n.baseThreshold) n.currentThreshold = Math.max(n.baseThreshold, n.currentThreshold - 0.005);
        if (n.refractory > 0) n.refractory--;
        if (n.spikeEnergy > 0) n.spikeEnergy *= 0.90;

        if (n.potential > 0.15) {
          const jitterMag = n.potential * 1.6;
          n.jitterX = (Math.random() - 0.5) * jitterMag;
          n.jitterY = (Math.random() - 0.5) * jitterMag;
        } else {
          n.jitterX = 0;
          n.jitterY = 0;
        }
      }

      // 2. Render Curvilinear Sinuous Axons with Boutons
      for (let c = 0; c < connections.length; c++) {
        const conn = connections[c];
        const nA = neurons[conn.from];
        const nB = neurons[conn.to];

        const activeCharge = Math.max(nA.potential, nB.potential);
        const cp = getCubicControlPoints(nA, nB, conn);

        ctx.beginPath();
        ctx.moveTo(nA.x + nA.jitterX, nA.y + nA.jitterY);
        ctx.bezierCurveTo(cp.cp1x, cp.cp1y, cp.cp2x, cp.cp2y, nB.x + nB.jitterX, nB.y + nB.jitterY);

        if (nA.isEngramRecruited && nB.isEngramRecruited) {
          ctx.strokeStyle = 'rgba(245, 158, 11, 0.65)';
          ctx.lineWidth = 1.2;
        } else if (activeCharge > 0.15) {
          ctx.strokeStyle = `rgba(217, 119, 6, ${0.12 + activeCharge * 0.35})`;
          ctx.lineWidth = 0.8 + activeCharge * 0.4;
        } else {
          ctx.strokeStyle = conn.isCollateral ? 'rgba(175, 165, 155, 0.05)' : 'rgba(170, 160, 150, 0.075)';
          ctx.lineWidth = conn.isCollateral ? 0.45 : 0.6;
        }
        ctx.stroke();

        for (let b = 0; b < conn.boutons.length; b++) {
          const bt = conn.boutons[b].t;
          const bPt = getCubicPoint(nA.x, nA.y, cp.cp1x, cp.cp1y, cp.cp2x, cp.cp2y, nB.x, nB.y, bt);

          let boutonPulse = 0;
          for (let p = 0; p < activePulses.length; p++) {
            const pulse = activePulses[p];
            if (pulse.fromNeuron.id === nA.id && pulse.toNeuron.id === nB.id) {
              const distToBouton = Math.abs(pulse.progress - bt);
              if (distToBouton < 0.16) {
                boutonPulse = Math.max(boutonPulse, (1 - distToBouton / 0.16) * pulse.energy);
              }
            } else if (pulse.fromNeuron.id === nB.id && pulse.toNeuron.id === nA.id) {
              const distToBouton = Math.abs((1 - pulse.progress) - bt);
              if (distToBouton < 0.16) {
                boutonPulse = Math.max(boutonPulse, (1 - distToBouton / 0.16) * pulse.energy);
              }
            }
          }

          ctx.beginPath();
          ctx.arc(bPt.x, bPt.y, conn.boutons[b].radius, 0, Math.PI * 2);

          if (boutonPulse > 0.05) {
            ctx.fillStyle = `rgba(13, 148, 136, ${0.25 + boutonPulse * 0.6})`;
          } else if (activeCharge > 0.15) {
            ctx.fillStyle = `rgba(217, 119, 6, ${0.25 + activeCharge * 0.4})`;
          } else {
            ctx.fillStyle = 'rgba(170, 162, 154, 0.08)';
          }
          ctx.fill();
        }
      }

      // 3. Render Traveling Axonal Conduction Waves
      for (let p = activePulses.length - 1; p >= 0; p--) {
        const pulse = activePulses[p];
        pulse.progress += pulse.speed;

        const nA = pulse.fromNeuron;
        const nB = pulse.toNeuron;
        const conn = pulse.conn;

        if (conn) {
          const cp = getCubicControlPoints(nA, nB, conn);
          const waveLen = 0.32;
          const headT = Math.min(1.0, pulse.progress);
          const tailT = Math.max(0.0, pulse.progress - waveLen);

          if (headT > tailT) {
            const steps = 12;
            let prev = null;
            for (let s = 0; s <= steps; s++) {
              const fraction = s / steps;
              const t = tailT + (headT - tailT) * fraction;
              const pt = getCubicPoint(nA.x, nA.y, cp.cp1x, cp.cp1y, cp.cp2x, cp.cp2y, nB.x, nB.y, t);

              if (prev) {
                const segAlpha = Math.pow(fraction, 1.6) * 0.85 * pulse.energy;
                ctx.beginPath();
                ctx.moveTo(prev.x, prev.y);
                ctx.lineTo(pt.x, pt.y);
                ctx.strokeStyle = `rgba(13, 148, 136, ${segAlpha})`;
                ctx.lineWidth = 0.7 + fraction * 0.75;
                ctx.stroke();
              }
              prev = pt;
            }
          }
        }

        if (pulse.progress >= 1.0) {
          const target = pulse.toNeuron;
          if (pulse.isIgnition) {
            if (target.refractory <= 0 || isIgniting) {
              fireNeuron(target, nA.id, pulse.hop, true);
            }
          } else {
            if (target.refractory <= 0) {
              target.potential += 0.65 * pulse.energy;
              if (target.potential >= target.currentThreshold * 0.70) {
                fireNeuron(target, nA.id, pulse.hop, false);
              }
            }
          }
          activePulses.splice(p, 1);
        }
      }

      // 4A. Render Thought Scribing Trail (Pointer Engram Canvas)
      if (mouse.isDown && scribedEngram.length > 1) {
        ctx.beginPath();
        ctx.moveTo(scribedEngram[0].x, scribedEngram[0].y);
        for (let i = 1; i < scribedEngram.length; i++) {
          ctx.lineTo(scribedEngram[i].x, scribedEngram[i].y);
        }
        ctx.strokeStyle = 'rgba(217, 119, 6, 0.55)';
        ctx.lineWidth = 1.4;
        ctx.setLineDash([4, 4]);
        ctx.stroke();
        ctx.setLineDash([]);
      }



      // 5. Render Somas
      for (let i = 0; i < neurons.length; i++) {
        const n = neurons[i];
        const posX = n.x + n.jitterX;
        const posY = n.y + n.jitterY;

        drawSoftHistologicalSoma(ctx, posX, posY, n.radius, n.angle, n.potential, n.spikeEnergy, n.type, n.isEngramRecruited);
      }

      if (isVisible) {
        animId = requestAnimationFrame(render);
      }
    }

    let isVisible = true;
    let animId = null;

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        const entry = entries[0];
        const nextVisible = entry.isIntersecting && !document.hidden;
        if (nextVisible && !isVisible) {
          isVisible = true;
          if (!animId) animId = requestAnimationFrame(render);
        } else if (!nextVisible && isVisible) {
          isVisible = false;
          if (animId) {
            cancelAnimationFrame(animId);
            animId = null;
          }
        }
      }, { rootMargin: '120px 0px' });
      observer.observe(canvas);
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden && animId) {
        isVisible = false;
        cancelAnimationFrame(animId);
        animId = null;
      } else if (!document.hidden && !animId) {
        isVisible = true;
        animId = requestAnimationFrame(render);
      }
    });

    animId = requestAnimationFrame(render);
  })();

  // Cortical Topography Scalp Potential Field Simulation
  (function() {
    const canvas = document.getElementById('cortical-topography');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let dpr = 1;

    function resize() {
      const rect = canvas.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = rect.width;
      height = rect.height;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    window.addEventListener('resize', resize, { passive: true });
    resize();

    const electrodes = [
      { name: 'Fz', x: 0, y: -0.42, zone: 'arithmetic' },
      { name: 'F3', x: -0.32, y: -0.40, zone: 'arithmetic' },
      { name: 'F4', x: 0.32, y: -0.40, zone: 'arithmetic' },
      { name: 'F7', x: -0.65, y: -0.28, zone: 'speech' },
      { name: 'F8', x: 0.65, y: -0.28, zone: 'arithmetic' },
      { name: 'Cz', x: 0, y: 0, zone: 'motor' },
      { name: 'C3', x: -0.42, y: 0, zone: 'motor' },
      { name: 'C4', x: 0.42, y: 0, zone: 'motor' },
      { name: 'T3', x: -0.75, y: 0.05, zone: 'speech' },
      { name: 'T4', x: 0.75, y: 0.05, zone: 'motor' },
      { name: 'Pz', x: 0, y: 0.42, zone: 'motor' },
      { name: 'P3', x: -0.32, y: 0.40, zone: 'speech' },
      { name: 'P4', x: 0.32, y: 0.40, zone: 'motor' },
      { name: 'T5', x: -0.62, y: 0.42, zone: 'speech' },
      { name: 'T6', x: 0.62, y: 0.42, zone: 'motor' },
      { name: 'Oz', x: 0, y: 0.75, zone: 'baseline' }
    ];

    const cognitivePoles = [
      { name: 'motor', x: 0, y: 0, color: '#B45309' },
      { name: 'arithmetic', x: 0, y: -0.42, color: '#0D9488' },
      { name: 'speech', x: -0.55, y: -0.15, color: '#D97706' }
    ];

    let currentPole = { x: 0, y: 0, color: '#B45309' };
    let targetPole = { x: 0, y: 0, color: '#B45309' };
    let mouse = { x: 0, y: 0, active: false };
    let ripplePulse = 0;

    const container = canvas.parentElement;
    if (container) {
      container.addEventListener('pointermove', (e) => {
        const rect = canvas.getBoundingClientRect();
        const rawX = e.clientX - rect.left;
        const rawY = e.clientY - rect.top;
        const cx = width / 2;
        const cy = height / 2;
        const R = Math.min(width, height) * 0.38;

        mouse.x = (rawX - cx) / R;
        mouse.y = (rawY - cy) / R;
        mouse.active = true;
      });

      container.addEventListener('pointerleave', () => {
        mouse.active = false;
      });

      container.addEventListener('pointerdown', () => {
        ripplePulse = 1.0;
      });
    }

    let time = 0;

    function render() {
      if (width === 0 || height === 0) {
        requestAnimationFrame(render);
        return;
      }

      time += 0.018;

      const cycleIdx = Math.floor((time * 0.25) % cognitivePoles.length);
      const nextIdx = (cycleIdx + 1) % cognitivePoles.length;
      const blend = (Math.sin(time * 0.5) + 1) / 2;

      const pA = cognitivePoles[cycleIdx];
      const pB = cognitivePoles[nextIdx];

      targetPole.x = pA.x * (1 - blend) + pB.x * blend;
      targetPole.y = pA.y * (1 - blend) + pB.y * blend;

      if (mouse.active) {
        targetPole.x = targetPole.x * 0.3 + mouse.x * 0.7;
        targetPole.y = targetPole.y * 0.3 + mouse.y * 0.7;
      }

      currentPole.x += (targetPole.x - currentPole.x) * 0.06;
      currentPole.y += (targetPole.y - currentPole.y) * 0.06;

      if (ripplePulse > 0.01) {
        ripplePulse *= 0.94;
      } else {
        ripplePulse = 0;
      }

      ctx.clearRect(0, 0, width, height);

      const cx = width / 2;
      const cy = height / 2;
      const R = Math.min(width, height) * 0.38;

      ctx.save();

      ctx.beginPath();
      ctx.arc(cx, cy, R, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(23, 23, 23, 0.15)';
      ctx.lineWidth = 1.0;
      ctx.stroke();

      ctx.beginPath();
      ctx.moveTo(cx - 10, cy - R + 1);
      ctx.lineTo(cx, cy - R - 12);
      ctx.lineTo(cx + 10, cy - R + 1);
      ctx.strokeStyle = 'rgba(23, 23, 23, 0.25)';
      ctx.lineWidth = 1.0;
      ctx.stroke();

      ctx.beginPath();
      ctx.arc(cx - R - 3, cy, 9, Math.PI * 0.5, Math.PI * 1.5, false);
      ctx.strokeStyle = 'rgba(23, 23, 23, 0.2)';
      ctx.lineWidth = 1.0;
      ctx.stroke();

      ctx.beginPath();
      ctx.arc(cx + R + 3, cy, 9, Math.PI * 1.5, Math.PI * 0.5, false);
      ctx.strokeStyle = 'rgba(23, 23, 23, 0.2)';
      ctx.lineWidth = 1.0;
      ctx.stroke();

      ctx.beginPath();
      ctx.moveTo(cx, cy - R * 0.95);
      ctx.lineTo(cx, cy + R * 0.95);
      ctx.moveTo(cx - R * 0.95, cy);
      ctx.lineTo(cx + R * 0.95, cy);
      ctx.strokeStyle = 'rgba(23, 23, 23, 0.05)';
      ctx.lineWidth = 0.8;
      ctx.setLineDash([3, 6]);
      ctx.stroke();
      ctx.setLineDash([]);

      ctx.beginPath();
      ctx.arc(cx, cy, R - 1, 0, Math.PI * 2);
      ctx.clip();

      const polePxX = cx + currentPole.x * R;
      const polePxY = cy + currentPole.y * R;

      const thermalGrad = ctx.createRadialGradient(polePxX, polePxY, 4, polePxX, polePxY, R * 0.9);
      thermalGrad.addColorStop(0, 'rgba(217, 119, 6, 0.14)');
      thermalGrad.addColorStop(0.45, 'rgba(13, 148, 136, 0.06)');
      thermalGrad.addColorStop(1, 'rgba(250, 249, 245, 0)');

      ctx.fillStyle = thermalGrad;
      ctx.fillRect(cx - R, cy - R, R * 2, R * 2);

      const numContours = 9;
      for (let c = 1; c <= numContours; c++) {
        const baseRadius = (c / numContours) * R * 0.85;
        const contourAlpha = Math.max(0.08, 0.42 - (c / numContours) * 0.32);

        ctx.beginPath();
        const steps = 64;
        for (let s = 0; s <= steps; s++) {
          const theta = (s / steps) * Math.PI * 2;
          const harmonic1 = Math.sin(theta * 3 + time * 1.5) * 4.5;
          const harmonic2 = Math.cos(theta * 2 - time * 0.8) * 3.0;
          const rippleMod = ripplePulse > 0 ? Math.sin(theta * 6 - time * 8) * (ripplePulse * 12) : 0;

          const r = baseRadius + harmonic1 + harmonic2 + rippleMod;
          const ptX = polePxX + Math.cos(theta) * r;
          const ptY = polePxY + Math.sin(theta) * r;

          if (s === 0) ctx.moveTo(ptX, ptY);
          else ctx.lineTo(ptX, ptY);
        }
        ctx.closePath();
        ctx.strokeStyle = c % 2 === 0 ? `rgba(217, 119, 6, ${contourAlpha})` : `rgba(23, 23, 23, ${contourAlpha * 0.75})`;
        ctx.lineWidth = c === 1 ? 1.3 : 0.8;
        ctx.stroke();
      }

      ctx.restore();

      for (let i = 0; i < electrodes.length; i++) {
        const el = electrodes[i];
        const elX = cx + el.x * R;
        const elY = cy + el.y * R;

        const dx = (elX - polePxX) / R;
        const dy = (elY - polePxY) / R;
        const dist = Math.sqrt(dx * dx + dy * dy);
        const activation = Math.max(0, 1 - dist * 1.6);

        if (activation > 0.25) {
          ctx.beginPath();
          ctx.arc(elX, elY, 3 + activation * 5, 0, Math.PI * 2);
          ctx.strokeStyle = `rgba(217, 119, 6, ${activation * 0.6})`;
          ctx.lineWidth = 0.8;
          ctx.stroke();
        }

        ctx.beginPath();
        ctx.arc(elX, elY, 1.8 + activation * 0.8, 0, Math.PI * 2);
        ctx.fillStyle = activation > 0.35 ? '#B45309' : 'rgba(23, 23, 23, 0.45)';
        ctx.fill();
      }

      if (isVisible) {
        animId = requestAnimationFrame(render);
      }
    }

    let isVisible = true;
    let animId = null;

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        const entry = entries[0];
        const nextVisible = entry.isIntersecting && !document.hidden;
        if (nextVisible && !isVisible) {
          isVisible = true;
          if (!animId) animId = requestAnimationFrame(render);
        } else if (!nextVisible && isVisible) {
          isVisible = false;
          if (animId) {
            cancelAnimationFrame(animId);
            animId = null;
          }
        }
      }, { rootMargin: '120px 0px' });
      observer.observe(canvas);
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden && animId) {
        isVisible = false;
        cancelAnimationFrame(animId);
        animId = null;
      } else if (!document.hidden && !animId) {
        isVisible = true;
        animId = requestAnimationFrame(render);
      }
    });

    animId = requestAnimationFrame(render);
  })();
</script>
