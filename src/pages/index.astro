            </div>
          </div>

          <div class="space-y-4 lg:pt-2">
            <span class="text-[9px] font-mono text-amber-700 uppercase tracking-widest block">HEALTHCARE · CLINICAL ONBOARDING</span>
            <h3 class="text-3xl font-serif text-neutral-950 group-hover:text-amber-800 transition-colors">
              Vitals: Digital Medical ID
            </h3>
            <p class="text-base text-neutral-600 font-light leading-[1.7]">
              Redesigned emergency medical onboarding to solve a 92% drop-off barrier for vulnerable patients, establishing foundational trust and clear privacy control before requesting sensitive medical history.
            </p>
            <div class="pt-3">
              <a href="/vitals" class="inline-flex items-center gap-1.5 text-xs font-mono text-neutral-800 hover:text-amber-700 border-b border-neutral-300 pb-0.5 hover:border-amber-600 transition-luxury group">
                <span>View Vitals Case Study</span>
                <span class="group-hover:translate-x-1 transition-luxury">→</span>
              </a>
            </div>
          </div>
        </article>

      </div>
    </section>

</main>
</BaseLayout>

<script is:inline>
  // Synaptic Neural Firing Simulation (Dormant Cortical Mesh + Action Potentials on Interaction)
  (function() {
    const canvas = document.getElementById('synaptic-field');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');

    let width, height;
    let mouse = { x: -1000, y: -1000, active: false };

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = Math.max(window.innerHeight * 1.15, 850);
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = width + 'px';
      canvas.style.height = height + 'px';
      ctx.scale(dpr, dpr);
    }

    resize();
    window.addEventListener('resize', resize);

    window.addEventListener('mousemove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY + window.scrollY;
      mouse.active = true;
    });

    window.addEventListener('mouseleave', () => {
      mouse.active = false;
    });

    // Create stable neural nodes
    const numNodes = 65;
    const nodes = [];

    for (let i = 0; i < numNodes; i++) {
      const baseX = Math.random() * (width || window.innerWidth);
      const baseY = Math.random() * (height || 850);
      nodes.push({
        baseX: baseX,
        baseY: baseY,
        x: baseX,
        y: baseY,
        phase: Math.random() * Math.PI * 2,
        driftSpeed: 0.002 + Math.random() * 0.003,
        driftRadius: 12 + Math.random() * 20,
        excitation: 0,
        pulseOffset: Math.random() * 10
      });
    }

    let time = 0;

    function render() {
      ctx.clearRect(0, 0, width, height);

      time += 0.015;

      // Update node positions with gentle harmonic micro-drift
      for (let i = 0; i < nodes.length; i++) {
        const n = nodes[i];
        n.x = n.baseX + Math.sin(time * n.driftSpeed * 100 + n.phase) * n.driftRadius;
        n.y = n.baseY + Math.cos(time * n.driftSpeed * 80 + n.phase) * (n.driftRadius * 0.7);

        // Interaction with cursor
        const dx = mouse.x - n.x;
        const dy = mouse.y - n.y;
        const dist = Math.sqrt(dx * dx + dy * dy);

        if (dist < 170 && mouse.active) {
          const targetExcitation = Math.pow(1 - dist / 170, 1.5);
          n.excitation = Math.max(n.excitation, targetExcitation);
        }

        // Smooth decay back to dormant state
        n.excitation *= 0.94;
      }

      // Draw Synaptic Connections (Axons) between nearby excited nodes
      const maxConnDist = 135;

      for (let i = 0; i < nodes.length; i++) {
        const nA = nodes[i];
        for (let j = i + 1; j < nodes.length; j++) {
          const nB = nodes[j];
          const dx = nA.x - nB.x;
          const dy = nA.y - nB.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < maxConnDist) {
            const jointExcitation = Math.max(nA.excitation, nB.excitation);
            const distFactor = 1 - dist / maxConnDist;

            // Faint resting connection
            const baseAlpha = 0.04 * distFactor;
            // Excited firing connection
            const firingAlpha = jointExcitation * 0.45 * distFactor;
            const totalAlpha = baseAlpha + firingAlpha;

            if (totalAlpha > 0.02) {
              ctx.beginPath();
              ctx.moveTo(nA.x, nA.y);
              ctx.lineTo(nB.x, nB.y);

              if (jointExcitation > 0.25) {
                // Warm golden amber firing axon
                ctx.strokeStyle = `rgba(217, 119, 6, ${totalAlpha})`;
                ctx.lineWidth = 0.75 + jointExcitation * 0.75;
              } else {
                // Soft muted neural mesh
                ctx.strokeStyle = `rgba(168, 162, 158, ${totalAlpha})`;
                ctx.lineWidth = 0.65;
              }
              ctx.stroke();

              // Action potential pulse traveling along active axon
              if (jointExcitation > 0.35) {
                const pulseProgress = ((time * 1.5 + (i + j)) % 1);
                const pulseX = nA.x + (nB.x - nA.x) * pulseProgress;
                const pulseY = nA.y + (nB.y - nA.y) * pulseProgress;

                ctx.fillStyle = `rgba(13, 148, 136, ${jointExcitation * 0.75})`;
                ctx.beginPath();
                ctx.arc(pulseX, pulseY, 1.2, 0, Math.PI * 2);
                ctx.fill();
              }
            }
          }
        }
      }

      // Draw Neural Soma Nodes
      for (let i = 0; i < nodes.length; i++) {
        const n = nodes[i];

        if (n.excitation > 0.15) {
          // Active firing node with golden/sage corona
          ctx.fillStyle = `rgba(217, 119, 6, ${0.4 + n.excitation * 0.5})`;
          ctx.beginPath();
          ctx.arc(n.x, n.y, 2.2 + n.excitation * 1.8, 0, Math.PI * 2);
          ctx.fill();

          // Outer faint halo
          ctx.fillStyle = `rgba(13, 148, 136, ${n.excitation * 0.25})`;
          ctx.beginPath();
          ctx.arc(n.x, n.y, 5 + n.excitation * 4, 0, Math.PI * 2);
          ctx.fill();
        } else {
          // Dormant resting node
          ctx.fillStyle = 'rgba(168, 162, 158, 0.4)';
          ctx.beginPath();
          ctx.arc(n.x, n.y, 1.8, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      requestAnimationFrame(render);
    }

    render();
  })();
</script>
