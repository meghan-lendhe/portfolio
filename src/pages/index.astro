            </div>
          </div>

          <div class="space-y-4 lg:pt-2">
            <span class="text-[9px] font-mono text-amber-700 uppercase tracking-widest block">HEALTHCARE · CLINICAL ONBOARDING</span>
            <h3 class="text-3xl font-serif text-neutral-950 group-hover:text-amber-800 transition-colors">
              Vitals: Digital Medical ID
            </h3>
            <p class="text-base text-neutral-600 font-light leading-[1.7]">
              Redesigned emergency medical onboarding to solve a 92% drop-off barrier for vulnerable patients, establishing foundational trust and clear privacy control before requesting sensitive medical history.
            </p>
            <div class="pt-3">
              <a href="/vitals" class="inline-flex items-center gap-1.5 text-xs font-mono text-neutral-800 hover:text-amber-700 border-b border-neutral-300 pb-0.5 hover:border-amber-600 transition-luxury group">
                <span>View Vitals Case Study</span>
                <span class="group-hover:translate-x-1 transition-luxury">→</span>
              </a>
            </div>
          </div>
        </article>

      </div>
    </section>

</main>
</BaseLayout>

<script is:inline>
  // Ramón y Cajal-Inspired Organic Neural Network Simulation
  // Curvilinear Axonal Trajectories, Morphological Cytology & Loop-Free Synaptic Avalanches
  (function() {
    const canvas = document.getElementById('synaptic-field');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');

    let width, height;
    let mouse = { x: -1000, y: -1000, active: false };

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = Math.max(window.innerHeight * 1.18, 900);
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = width + 'px';
      canvas.style.height = height + 'px';
      ctx.scale(dpr, dpr);
    }

    resize();
    window.addEventListener('resize', resize);

    window.addEventListener('mousemove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY + window.scrollY;
      mouse.active = true;
    });

    window.addEventListener('mouseleave', () => {
      mouse.active = false;
    });

    // Morphologies: Pyramidal (apical dendrite trunk), Multipolar (radiating arbor), Bipolar (elongated spindle)
    const morphTypes = ['pyramidal', 'multipolar', 'bipolar'];
    const numNeurons = 62;
    const neurons = [];
    const connections = [];
    const activePulses = [];

    for (let i = 0; i < numNeurons; i++) {
      const baseX = Math.random() * (width || window.innerWidth);
      const baseY = Math.random() * (height || 900);
      const type = morphTypes[i % morphTypes.length];
      const baseRadius = 3.5 + Math.random() * 2.0;

      neurons.push({
        id: i,
        baseX: baseX,
        baseY: baseY,
        x: baseX,
        y: baseY,
        type: type,
        radius: baseRadius,
        angle: Math.random() * Math.PI * 2,
        phase: Math.random() * Math.PI * 2,
        driftSpeed: 0.0012 + Math.random() * 0.0018,
        driftRadius: 8 + Math.random() * 15,
        potential: 0.0,
        baseThreshold: 0.85,
        currentThreshold: 0.85,
        refractory: 0,
        spikeEnergy: 0.0,
        jitterX: 0,
        jitterY: 0,
        connectedIndices: []
      });
    }

    // Build anatomical axonal arborization with subtle organic curvatures
    const maxConnDistance = 145;
    for (let i = 0; i < neurons.length; i++) {
      for (let j = i + 1; j < neurons.length; j++) {
        const dx = neurons[i].baseX - neurons[j].baseX;
        const dy = neurons[i].baseY - neurons[j].baseY;
        const d = Math.sqrt(dx * dx + dy * dy);
        if (d < maxConnDistance) {
          neurons[i].connectedIndices.push(j);
          neurons[j].connectedIndices.push(i);

          // Precompute organic curvature offset so filaments aren't ruler-straight
          const perpAngle = Math.atan2(dy, dx) + Math.PI / 2;
          const curveOffset = (Math.random() - 0.5) * 22;

          connections.push({
            from: i,
            to: j,
            curveOffsetX: Math.cos(perpAngle) * curveOffset,
            curveOffsetY: Math.sin(perpAngle) * curveOffset
          });
        }
      }
    }

    // Fire action potential (strictly limited hops & synaptic fatigue to eliminate infinite loops)
    function fireNeuron(n, sourceId = -1, hop = 0) {
      if (hop > 2) return; // Hard limit on cascade depth: guarantees termination

      n.potential = 0.0;
      n.spikeEnergy = 1.0;
      n.refractory = 55; // Extended refractory period prevents reverberation
      n.currentThreshold += 0.45; // Synaptic fatigue: temporarily raises threshold

      for (let k = 0; k < n.connectedIndices.length; k++) {
        const targetId = n.connectedIndices[k];
        if (targetId === sourceId) continue; // Never back-propagate to trigger source

        const targetNeuron = neurons[targetId];
        activePulses.push({
          fromNeuron: n,
          toNeuron: targetNeuron,
          progress: 0.0,
          speed: 0.042 + Math.random() * 0.015,
          hop: hop + 1,
          energy: Math.max(0.3, 1.0 - hop * 0.35)
        });
      }
    }

    // Click anywhere to inject current into nearby neurons
    window.addEventListener('pointerdown', (e) => {
      const clickX = e.clientX;
      const clickY = e.clientY + window.scrollY;

      for (let i = 0; i < neurons.length; i++) {
        const n = neurons[i];
        const dx = clickX - n.x;
        const dy = clickY - n.y;
        const dist = Math.sqrt(dx * dx + dy * dy);

        if (dist < 240) {
          const stimulus = Math.pow(1 - dist / 240, 1.3) * 0.72;
          if (n.refractory <= 0) {
            n.potential += stimulus;
            if (n.potential >= n.currentThreshold) {
              fireNeuron(n, -1, 0);
            }
          }
        }
      }
    });

    // Organic Neuron Cytology Drawing (Soft amoeboid somas, curving dendrites)
    function drawOrganicPyramidal(ctx, x, y, r, angle, excitation, spike) {
      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(angle);

      // Soma: Pear-shaped, softly curved pyramidal body
      ctx.beginPath();
      ctx.moveTo(0, -r * 1.5);
      ctx.quadraticCurveTo(r * 1.2, r * 0.2, r * 0.9, r * 1.1);
      ctx.quadraticCurveTo(0, r * 1.4, -r * 0.9, r * 1.1);
      ctx.quadraticCurveTo(-r * 1.2, r * 0.2, 0, -r * 1.5);
      ctx.closePath();

      if (spike > 0.05) {
        ctx.fillStyle = `rgba(217, 119, 6, ${0.75 + spike * 0.25})`;
        ctx.fill();
        ctx.strokeStyle = `rgba(13, 148, 136, ${spike})`;
        ctx.lineWidth = 1.2;
        ctx.stroke();
      } else {
        ctx.fillStyle = excitation > 0.1 ? `rgba(217, 119, 6, ${0.2 + excitation * 0.6})` : 'rgba(168, 155, 142, 0.45)';
        ctx.fill();
        ctx.strokeStyle = excitation > 0.1 ? `rgba(217, 119, 6, ${0.4 + excitation * 0.6})` : 'rgba(140, 128, 115, 0.45)';
        ctx.lineWidth = 0.8;
        ctx.stroke();
      }

      // Curved Apical Dendrite Trunk & Ramification
      ctx.beginPath();
      ctx.moveTo(0, -r * 1.5);
      ctx.quadraticCurveTo(r * 0.4, -r * 2.3, 0, -r * 3.0);
      // Fork
      ctx.moveTo(0, -r * 3.0);
      ctx.quadraticCurveTo(-r * 0.6, -r * 3.6, -r * 0.8, -r * 4.2);
      ctx.moveTo(0, -r * 3.0);
      ctx.quadraticCurveTo(r * 0.6, -r * 3.6, r * 0.8, -r * 4.2);

      // Curved Basal Dendrites
      ctx.moveTo(-r * 0.9, r * 1.1);
      ctx.quadraticCurveTo(-r * 1.8, r * 1.6, -r * 2.2, r * 2.4);
      ctx.moveTo(r * 0.9, r * 1.1);
      ctx.quadraticCurveTo(r * 1.8, r * 1.6, r * 2.2, r * 2.4);

      ctx.strokeStyle = spike > 0.05 ? `rgba(13, 148, 136, ${spike * 0.8})` : (excitation > 0.15 ? `rgba(217, 119, 6, ${0.25 + excitation * 0.5})` : 'rgba(180, 168, 156, 0.4)');
      ctx.lineWidth = 0.75;
      ctx.stroke();

      ctx.restore();
    }

    function drawOrganicMultipolar(ctx, x, y, r, angle, excitation, spike) {
      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(angle);

      // Soma: Soft curved amoeboid body
      ctx.beginPath();
      ctx.arc(0, 0, r * 1.1, 0, Math.PI * 2);

      if (spike > 0.05) {
        ctx.fillStyle = `rgba(217, 119, 6, ${0.75 + spike * 0.25})`;
        ctx.fill();
        ctx.strokeStyle = `rgba(13, 148, 136, ${spike})`;
        ctx.lineWidth = 1.2;
        ctx.stroke();
      } else {
        ctx.fillStyle = excitation > 0.1 ? `rgba(217, 119, 6, ${0.2 + excitation * 0.6})` : 'rgba(168, 155, 142, 0.45)';
        ctx.fill();
        ctx.strokeStyle = excitation > 0.1 ? `rgba(217, 119, 6, ${0.4 + excitation * 0.6})` : 'rgba(140, 128, 115, 0.45)';
        ctx.lineWidth = 0.8;
        ctx.stroke();
      }

      // Radiating curved dendritic spines (non-geometric, organic curvature)
      ctx.beginPath();
      const branches = 4;
      for (let b = 0; b < branches; b++) {
        const ba = (b * Math.PI * 2) / branches;
        const startX = Math.cos(ba) * r * 1.1;
        const startY = Math.sin(ba) * r * 1.1;
        const midX = Math.cos(ba + 0.25) * r * 1.9;
        const midY = Math.sin(ba + 0.25) * r * 1.9;
        const endX = Math.cos(ba - 0.1) * r * 2.7;
        const endY = Math.sin(ba - 0.1) * r * 2.7;

        ctx.moveTo(startX, startY);
        ctx.quadraticCurveTo(midX, midY, endX, endY);
      }

      ctx.strokeStyle = spike > 0.05 ? `rgba(13, 148, 136, ${spike * 0.8})` : (excitation > 0.15 ? `rgba(217, 119, 6, ${0.25 + excitation * 0.5})` : 'rgba(180, 168, 156, 0.4)');
      ctx.lineWidth = 0.75;
      ctx.stroke();

      ctx.restore();
    }

    function drawOrganicBipolar(ctx, x, y, r, angle, excitation, spike) {
      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(angle);

      // Soma: Soft elongated spindle
      ctx.beginPath();
      ctx.ellipse(0, 0, r * 0.65, r * 1.4, 0, 0, Math.PI * 2);

      if (spike > 0.05) {
        ctx.fillStyle = `rgba(217, 119, 6, ${0.75 + spike * 0.25})`;
        ctx.fill();
        ctx.strokeStyle = `rgba(13, 148, 136, ${spike})`;
        ctx.lineWidth = 1.2;
        ctx.stroke();
      } else {
        ctx.fillStyle = excitation > 0.1 ? `rgba(217, 119, 6, ${0.2 + excitation * 0.6})` : 'rgba(168, 155, 142, 0.45)';
        ctx.fill();
        ctx.strokeStyle = excitation > 0.1 ? `rgba(217, 119, 6, ${0.4 + excitation * 0.6})` : 'rgba(140, 128, 115, 0.45)';
        ctx.lineWidth = 0.8;
        ctx.stroke();
      }

      // Curved bipolar extensions
      ctx.beginPath();
      ctx.moveTo(0, -r * 1.4);
      ctx.quadraticCurveTo(r * 0.35, -r * 2.2, 0, -r * 3.0);
      ctx.moveTo(0, r * 1.4);
      ctx.quadraticCurveTo(-r * 0.35, r * 2.2, 0, r * 3.0);

      ctx.strokeStyle = spike > 0.05 ? `rgba(13, 148, 136, ${spike * 0.8})` : (excitation > 0.15 ? `rgba(217, 119, 6, ${0.25 + excitation * 0.5})` : 'rgba(180, 168, 156, 0.4)');
      ctx.lineWidth = 0.75;
      ctx.stroke();

      ctx.restore();
    }

    let time = 0;

    function render() {
      ctx.clearRect(0, 0, width, height);

      time += 0.012;

      // 1. Biological updates & potential decay
      for (let i = 0; i < neurons.length; i++) {
        const n = neurons[i];

        // Smooth organic drift
        n.x = n.baseX + Math.sin(time * n.driftSpeed * 100 + n.phase) * n.driftRadius;
        n.y = n.baseY + Math.cos(time * n.driftSpeed * 80 + n.phase) * (n.driftRadius * 0.65);

        // Sub-threshold cursor proximity noise
        if (mouse.active) {
          const dx = mouse.x - n.x;
          const dy = mouse.y - n.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 130 && n.refractory <= 0) {
            const hoverEPSP = (1 - dist / 130) * 0.01;
            n.potential = Math.min(n.currentThreshold - 0.05, n.potential + hoverEPSP);
          }
        }

        // Leaky integrator potential decay
        n.potential *= 0.985;

        // Threshold fatigue recovery
        if (n.currentThreshold > n.baseThreshold) {
          n.currentThreshold = Math.max(n.baseThreshold, n.currentThreshold - 0.005);
        }

        // Refractory countdown
        if (n.refractory > 0) {
          n.refractory--;
        }

        // Action potential spike flash decay
        if (n.spikeEnergy > 0) {
          n.spikeEnergy *= 0.90;
        }

        // Organic micro-vibration proportional to potential
        if (n.potential > 0.15) {
          const jitterMag = n.potential * 1.8;
          n.jitterX = (Math.random() - 0.5) * jitterMag;
          n.jitterY = (Math.random() - 0.5) * jitterMag;
        } else {
          n.jitterX = 0;
          n.jitterY = 0;
        }
      }

      // 2. Render Curvilinear Inter-Neuronal Axon Fibers
      for (let c = 0; c < connections.length; c++) {
        const conn = connections[c];
        const nA = neurons[conn.from];
        const nB = neurons[conn.to];

        const activeCharge = Math.max(nA.potential, nB.potential);
        const activeSpike = Math.max(nA.spikeEnergy, nB.spikeEnergy);

        const midX = (nA.x + nB.x) * 0.5 + conn.curveOffsetX;
        const midY = (nA.y + nB.y) * 0.5 + conn.curveOffsetY;

        ctx.beginPath();
        ctx.moveTo(nA.x + nA.jitterX, nA.y + nA.jitterY);
        ctx.quadraticCurveTo(midX, midY, nB.x + nB.jitterX, nB.y + nB.jitterY);

        if (activeSpike > 0.08) {
          ctx.strokeStyle = `rgba(13, 148, 136, ${0.35 + activeSpike * 0.45})`;
          ctx.lineWidth = 1.0 + activeSpike * 0.8;
        } else if (activeCharge > 0.15) {
          ctx.strokeStyle = `rgba(217, 119, 6, ${0.1 + activeCharge * 0.35})`;
          ctx.lineWidth = 0.75 + activeCharge * 0.4;
        } else {
          ctx.strokeStyle = 'rgba(210, 205, 198, 0.28)';
          ctx.lineWidth = 0.6;
        }
        ctx.stroke();
      }

      // 3. Render Curvilinear Action Potential Droplets along Axons
      for (let p = activePulses.length - 1; p >= 0; p--) {
        const pulse = activePulses[p];
        pulse.progress += pulse.speed;

        const nA = pulse.fromNeuron;
        const nB = pulse.toNeuron;

        // Quadratic Bezier interpolation along the curved connection
        const t = Math.min(1.0, pulse.progress);
        const invT = 1 - t;

        // Find connection curve offset if present
        let curveX = 0;
        let curveY = 0;
        for (let c = 0; c < connections.length; c++) {
          if ((connections[c].from === nA.id && connections[c].to === nB.id) ||
              (connections[c].from === nB.id && connections[c].to === nA.id)) {
            curveX = connections[c].curveOffsetX;
            curveY = connections[c].curveOffsetY;
            break;
          }
        }

        const midX = (nA.x + nB.x) * 0.5 + curveX;
        const midY = (nA.y + nB.y) * 0.5 + curveY;

        const currX = invT * invT * nA.x + 2 * invT * t * midX + t * t * nB.x;
        const currY = invT * invT * nA.y + 2 * invT * t * midY + t * t * nB.y;

        // Luminous droplet
        ctx.fillStyle = `rgba(217, 119, 6, ${0.9 * pulse.energy})`;
        ctx.beginPath();
        ctx.arc(currX, currY, 2.0, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = `rgba(13, 148, 136, ${0.35 * pulse.energy})`;
        ctx.beginPath();
        ctx.arc(currX, currY, 4.5, 0, Math.PI * 2);
        ctx.fill();

        // Synaptic arrival & downstream excitation
        if (pulse.progress >= 1.0) {
          const target = pulse.toNeuron;
          if (target.refractory <= 0) {
            target.potential += 0.38 * pulse.energy;
            if (target.potential >= target.currentThreshold) {
              fireNeuron(target, nA.id, pulse.hop);
            }
          }
          activePulses.splice(p, 1);
        }
      }

      // 4. Render Organic Somas
      for (let i = 0; i < neurons.length; i++) {
        const n = neurons[i];
        const posX = n.x + n.jitterX;
        const posY = n.y + n.jitterY;

        const effectiveR = n.radius * (1.0 + n.potential * 0.22 + n.spikeEnergy * 0.55);

        // Corona halo during spike
        if (n.spikeEnergy > 0.08) {
          ctx.fillStyle = `rgba(13, 148, 136, ${n.spikeEnergy * 0.25})`;
          ctx.beginPath();
          ctx.arc(posX, posY, effectiveR * 2.4, 0, Math.PI * 2);
          ctx.fill();
        }

        if (n.type === 'pyramidal') {
          drawOrganicPyramidal(ctx, posX, posY, effectiveR, n.angle, n.potential, n.spikeEnergy);
        } else if (n.type === 'multipolar') {
          drawOrganicMultipolar(ctx, posX, posY, effectiveR, n.angle, n.potential, n.spikeEnergy);
        } else {
          drawOrganicBipolar(ctx, posX, posY, effectiveR, n.angle, n.potential, n.spikeEnergy);
        }
      }

      requestAnimationFrame(render);
    }

    render();
  })();
</script>
