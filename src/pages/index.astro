---
import BaseLayout from '../layouts/BaseLayout.astro';
import source from '../content/index.html?raw';

const main = source.match(new RegExp('<main[\\s\\S]*?</main>'))?.[0].replaceAll('assets/', '/assets/') ?? '';
---

<BaseLayout title="Meghan Lendhe — Product Designer">
  <Fragment set:html={main} />
</BaseLayout>
