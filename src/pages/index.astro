<script is:inline>
  // High-Precision Laboratory Oscilloscope with Dual-Pass Phosphor Physics & Graticule Reticle
  (function() {
    const canvas = document.getElementById('eeg-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');

    function resizeCanvas() {
      const rect = canvas.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      ctx.scale(dpr, dpr);
    }
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);

    // 4-channel configuration with tactile neutral-gray & amber accents
    const channels = [
      { name: 'Fz (Frontal)', color: '#71717a', glow: 'rgba(113,113,122,0.4)', freq: 1.5, amp: 5.5, baseOffset: 0.16 },
      { name: 'C3 (Left Motor)', color: '#f4f4f5', glow: 'rgba(244,244,245,0.5)', freq: 3.1, amp: 9.0, baseOffset: 0.38 },
      { name: 'Cz (Vertex)', color: '#94a3b8', glow: 'rgba(148,163,184,0.3)', freq: 2.2, amp: 6.8, baseOffset: 0.60 },
      { name: 'C4 (Right Motor)', color: '#f59e0b', glow: 'rgba(245,158,11,0.6)', freq: 3.0, amp: 9.0, baseOffset: 0.82 }
    ];

    let currentTask = 0;
    let time = 0;

    const taskData = [
      { name: 'INTENT: LEFT MOTOR IMAGERY', conf: 'CONF: 96.4%' },
      { name: 'INTENT: RIGHT MOTOR IMAGERY', conf: 'CONF: 94.8%' },
      { name: 'INTENT: COGNITIVE BASELINE / REST', conf: 'CONF: 98.2%' }
    ];

    const taskPill = document.getElementById('current-task-pill');
    const confVal = document.getElementById('confidence-val');
    const buttons = document.querySelectorAll('[data-task-trigger]');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.getAttribute('data-task-trigger'), 10);
        currentTask = idx;
        buttons.forEach((b, i) => {
          const stateNum = b.querySelector('.task-state-num');
          const stateTitle = b.querySelector('.task-state-title');

          if (i === idx) {
            if (stateNum) {
              stateNum.classList.remove('text-neutral-500');
              stateNum.classList.add('text-amber-400');
            }
            if (stateTitle) {
              stateTitle.classList.remove('text-neutral-400');
              stateTitle.classList.add('text-white');
            }
          } else {
            if (stateNum) {
              stateNum.classList.add('text-neutral-500');
              stateNum.classList.remove('text-amber-400');
            }
            if (stateTitle) {
              stateTitle.classList.add('text-neutral-400');
              stateTitle.classList.remove('text-white');
            }
          }
        });

        if (taskPill) taskPill.textContent = taskData[idx].name;
        if (confVal) confVal.textContent = taskData[idx].conf;
      });
    });

    function draw() {
      const rect = canvas.getBoundingClientRect();
      const w = rect.width;
      const h = rect.height;

      ctx.clearRect(0, 0, w, h);

      // Graticule Reticle: Vertical time division ticks every 120px with micro-crosshairs
      ctx.lineWidth = 1;
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.025)';
      for (let x = 60; x < w - 60; x += 120) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, h);
        ctx.stroke();

        // Subtle tick at baseline
        ctx.fillStyle = 'rgba(255, 255, 255, 0.15)';
        ctx.fillRect(x - 0.5, h - 6, 1, 6);
      }

      // Horizontal calibration channels & microvolt labels
      for (let i = 0; i < channels.length; i++) {
        const y = h * channels[i].baseOffset;
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(w, y);
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.04)';
        ctx.stroke();

        ctx.fillStyle = 'rgba(148, 163, 184, 0.45)';
        ctx.font = '9px "JetBrains Mono", monospace';
        ctx.fillText(channels[i].name, 12, y - 5);
        ctx.fillText('0 µV', w - 44, y - 5);

        // Amplitude bounds
        ctx.fillStyle = 'rgba(148, 163, 184, 0.2)';
        ctx.fillText('+20', w - 44, y - 18);
        ctx.fillText('-20', w - 44, y + 16);
      }

      time += 0.034;

      // Draw multi-channel traces with dual-pass phosphor bloom
      channels.forEach((ch, idx) => {
        let modAmp = ch.amp;
        let modFreq = ch.freq;

        // Realistic task-based neurodynamics
        if (currentTask === 0) {
          if (ch.name.startsWith('C4')) modAmp = 2.0; // Contralateral ERD (power suppression)
          if (ch.name.startsWith('C3')) { modAmp = 12.0; modFreq = 4.2; } // Ipsilateral rebound
        } else if (currentTask === 1) {
          if (ch.name.startsWith('C3')) modAmp = 2.0; // Contralateral ERD
          if (ch.name.startsWith('C4')) { modAmp = 12.0; modFreq = 4.2; }
        } else {
          // Synchronous resting state: synchronized 10 Hz alpha wave envelope
          const alphaEnvelope = 0.65 + 0.35 * Math.sin(time * 0.9 + idx);
          modAmp = (ch.name.startsWith('Cz') || ch.name.startsWith('Fz')) ? 11.5 * alphaEnvelope : 6.0;
          modFreq = 2.4;
        }

        const centerY = h * ch.baseOffset;

        // PASS 1: Outer halo
        ctx.save();
        ctx.beginPath();
        ctx.strokeStyle = ch.color;
        ctx.lineWidth = 1.75;
        ctx.shadowColor = ch.glow;
        ctx.shadowBlur = 9;

        for (let x = 0; x < w; x += 3) {
          const t = time + (x * 0.009 * modFreq);
          const wave1 = Math.sin(t) * modAmp;
          const wave2 = Math.cos(t * 2.3 + idx) * (modAmp * 0.35);
          const noise = Math.sin(x * 14.1 + time * 3.8) * 0.6;
          const y = centerY + wave1 + wave2 + noise;

          if (x === 0) {
            ctx.moveTo(x, y);
          } else {
            ctx.lineTo(x, y);
          }
        }
        ctx.stroke();

        // PASS 2: Crisp core
        ctx.shadowBlur = 0;
        ctx.lineWidth = 0.75;
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.85)';
        ctx.stroke();

        // Active sensor tracking reticle head
        const leadX = w - 8;
        const leadT = time + (leadX * 0.009 * modFreq);
        const leadY = centerY + Math.sin(leadT) * modAmp + Math.cos(leadT * 2.3 + idx) * (modAmp * 0.35);

        ctx.fillStyle = ch.color;
        ctx.fillRect(leadX - 2, leadY - 2, 4, 4);
        ctx.restore();
      });

      requestAnimationFrame(draw);
    }

    draw();
  })();
</script>
