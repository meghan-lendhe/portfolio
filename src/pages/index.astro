---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Meghan Lendhe — Product Designer & NeuroHCI Researcher" theme="light">
<!-- Luminous Gallery Atmosphere: Layered Warm Ambient Gradients -->
<div class="fixed inset-0 pointer-events-none -z-20 bg-[#FAF9F5]"></div>
<div class="fixed inset-0 pointer-events-none -z-20 bg-[radial-gradient(ellipse_75%_55%_at_70%_10%,rgba(217,119,6,0.045),transparent_65%)]"></div>
<div class="fixed inset-0 pointer-events-none -z-20 bg-[radial-gradient(ellipse_60%_45%_at_15%_25%,rgba(13,148,136,0.035),transparent_60%)]"></div>
<div class="fixed inset-0 pointer-events-none -z-20 bg-[radial-gradient(ellipse_55%_40%_at_85%_75%,rgba(217,119,6,0.03),transparent_70%)]"></div>

<!-- Interactive Histological Neural Simulation Canvas (Soft Cytology, Varicose Axons, Zero Isolated Nodes) -->
<canvas id="synaptic-field" class="absolute top-0 inset-x-0 w-full h-[120vh] pointer-events-none -z-10"></canvas>

<main id="main" class="relative max-w-page mx-auto px-6 md:px-20 pb-72 pt-28 md:pt-40 font-sans text-neutral-800 selection:bg-amber-500/20 selection:text-neutral-900">

    <!-- HERO SECTION: Luminous & Grounded Career Opening -->
    <section id="hero" aria-labelledby="hero-title" class="relative mb-36 md:mb-52">

      <!-- Monumental Career Motto Headline -->
      <div class="max-w-6xl mb-16">
        <h1 id="hero-title" class="font-serif text-5xl sm:text-7xl lg:text-[6.75rem] font-normal leading-[0.93] tracking-[-0.04em] text-neutral-950 mb-8 text-balance">
          Creating seamless interactions between humans and computers.
        </h1>

        <!-- Intermediate Scale Bridge -->
        <p class="text-2xl sm:text-3xl text-neutral-700 font-light leading-snug tracking-tight mb-14 max-w-[50ch]">
          I'm Meghan Lendhe—a product designer and neuroHCI researcher bridging biosignal computing with human-centered systems.
        </p>

        <div class="grid grid-cols-1 lg:grid-cols-[1.35fr_0.65fr] gap-12 lg:gap-20 items-start">
          <div>
            <p class="text-lg sm:text-xl text-neutral-600 font-light leading-[1.8] max-w-[52ch] text-pretty">
              I explore how neural interfaces, biosignal decoding, and machine learning can make computing feel natural, adaptive, and human. Currently developing hands-on research experience in zero-calibration EEG decoding architectures while bringing a proven foundation in end-to-end product design.
            </p>
          </div>

          <!-- Section Roadmap (Clear, Human, Zero Boxes) -->
          <div class="space-y-6 lg:pt-1">
            <div class="text-[9px] font-mono uppercase tracking-[0.32em] text-neutral-500">EXPLORE WORK</div>
            <nav aria-label="Page navigation" class="flex flex-col gap-3 font-mono text-xs tracking-wider">
              <a href="#research" class="group flex items-center justify-between border-b border-neutral-200 pb-2.5 text-neutral-900 transition-luxury hover:text-amber-700 hover:border-amber-500">
                <span>01. NEUROHCI &amp; BIOSIGNALS</span>
                <span class="text-neutral-400 group-hover:text-amber-700 group-hover:translate-x-1.5 transition-luxury">→</span>
              </a>
              <a href="#product-design" class="group flex items-center justify-between border-b border-neutral-200 pb-2.5 text-neutral-600 transition-luxury hover:text-neutral-950 hover:border-neutral-400">
                <span>02. PRODUCT DESIGN CASE STUDIES</span>
                <span class="text-neutral-400 group-hover:text-neutral-950 group-hover:translate-x-1.5 transition-luxury">→</span>
              </a>
              <a href="#about" class="group flex items-center justify-between border-b border-neutral-200 pb-2.5 text-neutral-500 transition-luxury hover:text-neutral-950 hover:border-neutral-400">
                <span>03. PERSPECTIVE &amp; COLLABORATION</span>
                <span class="text-neutral-400 group-hover:text-neutral-950 group-hover:translate-y-0.5 transition-luxury">↓</span>
              </a>
            </nav>
          </div>
        </div>
      </div>

    </section>


    <!-- SECTION 01: NEUROHCI & BIOSIGNAL COMPUTING -->
    <section id="research" aria-labelledby="monograph-title" class="mb-48 md:mb-56 scroll-mt-32">
      
      <!-- Section Tag -->
      <div class="pb-5 mb-16 border-b border-neutral-200">
        <div class="text-[9px] font-mono tracking-[0.36em] text-neutral-500 uppercase">
          01 / NEUROHCI &amp; BIOSIGNAL COMPUTING
        </div>
      </div>

      <!-- Asymmetric Broadsheet Layout (65/35 Split with Technical Ledger) -->
      <div class="grid grid-cols-1 lg:grid-cols-[1.3fr_0.7fr] gap-16 lg:gap-24 mb-20 items-start">
        <div>
          <h2 id="monograph-title" class="font-serif text-4xl sm:text-6xl lg:text-[4.5rem] text-neutral-950 leading-[1.02] tracking-tight mb-8 text-balance">
            Zero-Calibration BCI: Classifying Neural Patterns Across Unfamiliar Sessions
          </h2>
          <div class="font-serif italic text-2xl sm:text-3xl text-neutral-700 leading-relaxed max-w-[44ch] mb-10">
            “Standard BCI setups require 30 minutes of calibration before decoding a single thought. If neural interfaces are ever going to be practical outside a lab, zero calibration is a non-negotiable step.”
          </div>

          <div class="space-y-6 text-neutral-600 font-light text-lg leading-[1.85] max-w-[54ch]">
            <p class="text-neutral-900 font-normal text-xl leading-relaxed">
              In non-invasive Brain-Computer Interfaces, user adoption breaks at the calibration step. Traditional motor-imagery systems require 20 to 40 minutes of repetitive calibration at the start of every session before any control is granted. Sensor displacement, daily impedance changes, and non-stationary neural signals cause models trained yesterday to fail today.
            </p>
            <p class="text-neutral-600">
              For the NeurIPS 2026 Brain &amp; Body Workshop Challenge, I explored training neural decoding architectures to classify raw EEG patterns into 3 continuous motor tasks <span class="text-neutral-950 font-normal underline decoration-neutral-300 underline-offset-4">without pre-session calibration</span>. By projecting differing subjects and recording sessions into an invariant latent manifold, this approach isolates motor intent from non-stationary noise from the very first second.
            </p>
          </div>
        </div>

        <!-- Technical Specification Ledger -->
        <div class="space-y-8 lg:pt-4 pl-0 lg:pl-10">
          <div class="text-[9px] font-mono uppercase tracking-[0.36em] text-neutral-500">EXPERIENCE &amp; TECHNICAL SPECIFICATIONS</div>
          
          <dl class="space-y-6 text-xs font-mono">
            <div>
              <dt class="text-neutral-400 text-[9px] tracking-[0.25em] uppercase mb-1">CALIBRATION LATENCY</dt>
              <dd class="text-neutral-950 text-base font-medium tabular-nums">0.0 sec Pre-Session</dd>
              <dd class="text-neutral-500 text-[11px] font-sans mt-0.5">Instantaneous inference upon sensor placement</dd>
            </div>
            <div>
              <dt class="text-neutral-400 text-[9px] tracking-[0.25em] uppercase mb-1">ELECTRODE MONTAGE</dt>
              <dd class="text-neutral-950 text-base font-medium">10-20 Sensorimotor Strip</dd>
              <dd class="text-neutral-500 text-[11px] font-sans mt-0.5">Motor cortex coordinates: C3, Cz, C4</dd>
            </div>
            <div>
              <dt class="text-neutral-400 text-[9px] tracking-[0.25em] uppercase mb-1">INVARIANCE STRATEGY</dt>
              <dd class="text-neutral-950 text-base font-medium">Latent Manifold Alignment</dd>
              <dd class="text-neutral-500 text-[11px] font-sans mt-0.5">Mitigates cross-subject neural drift</dd>
            </div>
            <div>
              <dt class="text-neutral-400 text-[9px] tracking-[0.25em] uppercase mb-1">TASK CLASSIFICATION</dt>
              <dd class="text-neutral-950 text-base font-medium">3-Class Continuous</dd>
              <dd class="text-neutral-500 text-[11px] font-sans mt-0.5">Left Hand · Right Hand · Baseline Rest</dd>
            </div>
          </dl>

          <div class="pt-6 border-t border-neutral-200">
            <a
              href="https://neural-interfaces26.github.io/index.html"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-xs font-mono text-neutral-700 hover:text-amber-700 transition-luxury group"
            >
              <span class="tracking-wider">NEURIPS WORKSHOP CHALLENGE REPO</span>
              <span class="text-amber-600 font-mono transition-luxury group-hover:translate-x-1">→</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Methodological Breakdown -->
      <div class="pt-14 border-t border-neutral-200 grid grid-cols-1 md:grid-cols-3 gap-12">
        <div class="space-y-3">
          <span class="text-[9px] font-mono text-neutral-400 uppercase tracking-widest block">PIPELINE 01 / SIGNAL PREPROCESSING</span>
          <h3 class="text-lg font-medium text-neutral-950">Uncalibrated 10-20 Montage</h3>
          <p class="text-sm text-neutral-600 font-light leading-relaxed">
            Streaming multi-channel microvolt fluctuations across motor cortex coordinates (C3, Cz, C4) without baseline sweeps or manual impedance matching.
          </p>
        </div>

        <div class="space-y-3">
          <span class="text-[9px] font-mono text-neutral-400 uppercase tracking-widest block">PIPELINE 02 / LATENT ALIGNMENT</span>
          <h3 class="text-lg font-medium text-neutral-950">Session-Invariant Geometry</h3>
          <p class="text-sm text-neutral-600 font-light leading-relaxed">
            Projecting non-overlapping recording days and cross-subject neural variance into a shared latent space, decoupling motor intent from hardware noise.
          </p>
        </div>

        <div class="space-y-3">
          <span class="text-[9px] font-mono text-neutral-400 uppercase tracking-widest block">PIPELINE 03 / INTENT DISCRIMINATION</span>
          <h3 class="text-lg font-medium text-neutral-950">Continuous 3-Class Inference</h3>
          <p class="text-sm text-neutral-600 font-light leading-relaxed">
            Distinguishing between left motor imagery, right motor imagery, and cognitive rest immediately upon donning the sensor array.
          </p>
        </div>
      </div>

    </section>


    <!-- PERSPECTIVE INTERLUDE (Clean & Minimal) -->
    <section id="about" aria-label="Perspective" class="py-20 md:py-28 my-16 border-y border-neutral-200 text-center relative overflow-hidden">
      <div class="max-w-4xl mx-auto px-6 space-y-6">
        <span class="text-[9px] font-mono tracking-[0.35em] text-amber-700 uppercase">PERSPECTIVE</span>
        <blockquote class="font-serif italic text-2xl sm:text-4xl text-neutral-900 font-light leading-[1.3] text-balance">
          “The most impactful technology doesn’t demand that people adapt to it. It adapts quietly to them.”
        </blockquote>
        <div class="text-[10px] font-mono tracking-[0.25em] text-neutral-400 uppercase pt-2">
          MEGHAN LENDHE · PRODUCT DESIGN &amp; NEUROHCI RESEARCH
        </div>
      </div>
    </section>


    <!-- SECTION 02: PRODUCT DESIGN & COMPLEX WORKFLOWS -->
    <section id="product-design" aria-labelledby="product-title" class="pt-16">
      
      <div class="pb-5 mb-16 border-b border-neutral-200">
        <div class="text-[9px] font-mono tracking-[0.36em] text-neutral-500 uppercase">
          02 / PRODUCT DESIGN &amp; COMPLEX WORKFLOWS
        </div>
      </div>

      <div class="max-w-4xl mb-24">
        <h2 id="product-title" class="font-serif text-4xl sm:text-6xl text-neutral-950 mb-6">
          Product Design
        </h2>
        <p class="text-xl text-neutral-600 font-light leading-[1.7] max-w-[52ch]">
          I spent the past few years designing digital products across e-commerce, government services, and healthcare.
        </p>
      </div>

      <!-- CASE STUDY SPREADS: Authentic Domain & Impact -->
      <div class="space-y-44">
        
        <!-- Case Study 01: BulkMagic -->
        <article class="grid grid-cols-1 lg:grid-cols-[1.35fr_0.65fr] gap-16 items-start group">
          <div class="relative overflow-hidden bg-neutral-100 rounded-xl border border-neutral-200/80">
            <a href="/bulkmagic" class="block aspect-[16/10] overflow-hidden">
              <img
                src="/assets/experience/bulkmagic-group-buy.jpg"
                alt="BulkMagic campus group-buying e-commerce product architecture"
                class="w-full h-full object-contain p-4 grayscale contrast-110 opacity-90 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-[1.015] transition-luxury duration-700"
              />
            </a>
            <div class="flex items-center justify-between text-[10px] font-mono tracking-widest text-neutral-500 uppercase border-t border-neutral-200 px-4 py-2.5 bg-neutral-50/80">
              <span>E-COMMERCE · GROUP BUYING</span>
              <span>UHUNGRY PILOT</span>
            </div>
          </div>

          <div class="space-y-4 lg:pt-2">
            <span class="text-[9px] font-mono text-amber-700 uppercase tracking-widest block">E-COMMERCE · CAMPUS PILOT</span>
            <h3 class="text-3xl font-serif text-neutral-950 group-hover:text-amber-800 transition-colors">
              BulkMagic: Campus Subscription Ecosystem
            </h3>
            <p class="text-base text-neutral-600 font-light leading-[1.7]">
              Pivoted BulkMagic into a focused campus subscription pilot with UHungry Cafe at the University of Utah. Architected responsive prototypes, mapped group-buy state machines, and tested student meal-plan economics.
            </p>
            <div class="pt-3">
              <a href="/bulkmagic" class="inline-flex items-center gap-1.5 text-xs font-mono text-neutral-800 hover:text-amber-700 border-b border-neutral-300 pb-0.5 hover:border-amber-600 transition-luxury group">
                <span>View BulkMagic Case Study</span>
                <span class="group-hover:translate-x-1 transition-luxury">→</span>
              </a>
            </div>
          </div>
        </article>

        <!-- Case Study 02: Omara Technologies -->
        <article class="grid grid-cols-1 lg:grid-cols-[0.65fr_1.35fr] gap-16 items-start group">
          <div class="space-y-4 order-2 lg:order-1 lg:pt-2">
            <span class="text-[9px] font-mono text-teal-700 uppercase tracking-widest block">GOVERNMENT SERVICES · AUDIT PLATFORM</span>
            <h3 class="text-3xl font-serif text-neutral-950 group-hover:text-teal-800 transition-colors">
              Omara: Welfare Application Review
            </h3>
            <p class="text-base text-neutral-600 font-light leading-[1.7]">
              Designed an officer-facing operational platform to review offline welfare applications. Engineered custom design-system verification skills that automated high-fidelity Figma components and accelerated prototyping workflows.
            </p>
            <div class="pt-3">
              <a href="/omara" class="inline-flex items-center gap-1.5 text-xs font-mono text-neutral-800 hover:text-teal-700 border-b border-neutral-300 pb-0.5 hover:border-teal-600 transition-luxury group">
                <span>View Omara Case Study</span>
                <span class="group-hover:translate-x-1 transition-luxury">→</span>
              </a>
            </div>
          </div>

          <div class="order-1 lg:order-2 relative overflow-hidden bg-neutral-100 rounded-xl border border-neutral-200/80">
            <a href="/omara" class="block aspect-[16/10] overflow-hidden">
              <img
                src="/assets/experience/omara-workflows.svg"
                alt="Omara welfare application review and design-system tooling"
                class="w-full h-full object-contain p-4 grayscale contrast-110 opacity-90 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-[1.015] transition-luxury duration-700"
              />
            </a>
            <div class="flex items-center justify-between text-[10px] font-mono tracking-widest text-neutral-500 uppercase border-t border-neutral-200 px-4 py-2.5 bg-neutral-50/80">
              <span>GOVERNMENT SERVICES</span>
              <span>VERIFICATION WORKFLOW</span>
            </div>
          </div>
        </article>

        <!-- Case Study 03: Vitals Digital Medical ID -->
        <article class="grid grid-cols-1 lg:grid-cols-[1.35fr_0.65fr] gap-16 items-start group">
          <div class="relative overflow-hidden bg-neutral-100 rounded-xl border border-neutral-200/80">
            <a href="/vitals" class="block aspect-[16/10] overflow-hidden">
              <img
                src="/assets/vitals/cover.png"
                alt="Vitals medical ID onboarding"
                class="w-full h-full object-contain p-4 grayscale contrast-110 opacity-90 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-[1.015] transition-luxury duration-700"
              />
            </a>
            <div class="flex items-center justify-between text-[10px] font-mono tracking-widest text-neutral-500 uppercase border-t border-neutral-200 px-4 py-2.5 bg-neutral-50/80">
              <span>HEALTHCARE · DIGITAL MEDICAL ID</span>
              <span>TRUST-FIRST DISCLOSURE</span>
            </div>
          </div>

          <div class="space-y-4 lg:pt-2">
            <span class="text-[9px] font-mono text-amber-700 uppercase tracking-widest block">HEALTHCARE · CLINICAL ONBOARDING</span>
            <h3 class="text-3xl font-serif text-neutral-950 group-hover:text-amber-800 transition-colors">
              Vitals: Digital Medical ID
            </h3>
            <p class="text-base text-neutral-600 font-light leading-[1.7]">
              Redesigned emergency medical onboarding to solve a 92% drop-off barrier for vulnerable patients, establishing foundational trust and clear privacy control before requesting sensitive medical history.
            </p>
            <div class="pt-3">
              <a href="/vitals" class="inline-flex items-center gap-1.5 text-xs font-mono text-neutral-800 hover:text-amber-700 border-b border-neutral-300 pb-0.5 hover:border-amber-600 transition-luxury group">
                <span>View Vitals Case Study</span>
                <span class="group-hover:translate-x-1 transition-luxury">→</span>
              </a>
            </div>
          </div>
        </article>

      </div>
    </section>

</main>
</BaseLayout>

<script is:inline>
  // Advanced Histological Cytology & Integrate-and-Fire Neural Network Simulation
  // Features: Soft Radial Density Gradient Somas (Zero Cartoon Borders), Varicose Axons, Guaranteed Network Connectivity, Luminous Multi-Phase Action Potentials
  (function() {
    const canvas = document.getElementById('synaptic-field');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');

    let width, height;
    let mouse = { x: -1000, y: -1000, active: false };

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = Math.max(window.innerHeight * 1.18, 900);
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = width + 'px';
      canvas.style.height = height + 'px';
      ctx.scale(dpr, dpr);
    }

    resize();
    window.addEventListener('resize', resize);

    window.addEventListener('mousemove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY + window.scrollY;
      mouse.active = true;
    });

    window.addEventListener('mouseleave', () => {
      mouse.active = false;
    });

    const morphTypes = ['pyramidal', 'multipolar', 'bipolar'];
    const numNeurons = 64;
    const neurons = [];
    const connections = [];
    const activePulses = [];

    // Initialize Neurons with biological cytology properties
    for (let i = 0; i < numNeurons; i++) {
      const baseX = Math.random() * (width || window.innerWidth);
      const baseY = Math.random() * (height || 900);
      const type = morphTypes[i % morphTypes.length];
      const baseRadius = 4.0 + Math.random() * 2.5;

      neurons.push({
        id: i,
        baseX: baseX,
        baseY: baseY,
        x: baseX,
        y: baseY,
        type: type,
        radius: baseRadius,
        angle: Math.random() * Math.PI * 2,
        phase: Math.random() * Math.PI * 2,
        driftSpeed: 0.001 + Math.random() * 0.0016,
        driftRadius: 6 + Math.random() * 12,
        potential: 0.0,
        baseThreshold: 0.82,
        currentThreshold: 0.82,
        refractory: 0,
        spikeEnergy: 0.0,
        jitterX: 0,
        jitterY: 0,
        connectedIndices: []
      });
    }

    // Helper to add a connection with organic curvature & synaptic boutons
    function addAxonalConnection(i, j, dx, dy) {
      if (neurons[i].connectedIndices.includes(j)) return;
      neurons[i].connectedIndices.push(j);
      neurons[j].connectedIndices.push(i);

      const perpAngle = Math.atan2(dy, dx) + Math.PI / 2;
      const curveOffset = (Math.random() - 0.5) * 26;

      // Generate 2-4 synaptic boutons en passant along this axon
      const numBoutons = 2 + Math.floor(Math.random() * 3);
      const boutons = [];
      for (let b = 0; b < numBoutons; b++) {
        boutons.push({
          t: 0.2 + Math.random() * 0.6,
          radius: 1.0 + Math.random() * 0.8
        });
      }

      connections.push({
        from: i,
        to: j,
        curveOffsetX: Math.cos(perpAngle) * curveOffset,
        curveOffsetY: Math.sin(perpAngle) * curveOffset,
        boutons: boutons
      });
    }

    // Step 1: Distance-based local arborization
    const maxConnDistance = 155;
    for (let i = 0; i < neurons.length; i++) {
      for (let j = i + 1; j < neurons.length; j++) {
        const dx = neurons[i].baseX - neurons[j].baseX;
        const dy = neurons[i].baseY - neurons[j].baseY;
        const d = Math.sqrt(dx * dx + dy * dy);
        if (d < maxConnDistance) {
          addAxonalConnection(i, j, dx, dy);
        }
      }
    }

    // Step 2: GUARANTEE ZERO LONELY NEURONS (Minimum degree = 2)
    for (let i = 0; i < neurons.length; i++) {
      while (neurons[i].connectedIndices.length < 2) {
        let closestDist = Infinity;
        let closestIdx = -1;
        for (let j = 0; j < neurons.length; j++) {
          if (i === j || neurons[i].connectedIndices.includes(j)) continue;
          const dx = neurons[i].baseX - neurons[j].baseX;
          const dy = neurons[i].baseY - neurons[j].baseY;
          const d = Math.sqrt(dx * dx + dy * dy);
          if (d < closestDist) {
            closestDist = d;
            closestIdx = j;
          }
        }
        if (closestIdx !== -1) {
          const dx = neurons[i].baseX - neurons[closestIdx].baseX;
          const dy = neurons[i].baseY - neurons[closestIdx].baseY;
          addAxonalConnection(i, closestIdx, dx, dy);
        } else {
          break;
        }
      }
    }

    // Finite Action Potential Cascade with Synaptic Fatigue
    function fireNeuron(n, sourceId = -1, hop = 0) {
      if (hop > 2) return; // Strict cascade limit guarantees termination

      n.potential = 0.0;
      n.spikeEnergy = 1.0;
      n.refractory = 58; // Refractory protection against loops
      n.currentThreshold += 0.5; // Synaptic depression

      for (let k = 0; k < n.connectedIndices.length; k++) {
        const targetId = n.connectedIndices[k];
        if (targetId === sourceId) continue; // No back-excitation

        const targetNeuron = neurons[targetId];
        activePulses.push({
          fromNeuron: n,
          toNeuron: targetNeuron,
          progress: 0.0,
          speed: 0.038 + Math.random() * 0.014,
          hop: hop + 1,
          energy: Math.max(0.35, 1.0 - hop * 0.32)
        });
      }
    }

    // Stimulus Current Injection on Pointerdown
    window.addEventListener('pointerdown', (e) => {
      const clickX = e.clientX;
      const clickY = e.clientY + window.scrollY;

      for (let i = 0; i < neurons.length; i++) {
        const n = neurons[i];
        const dx = clickX - n.x;
        const dy = clickY - n.y;
        const dist = Math.sqrt(dx * dx + dy * dy);

        if (dist < 250) {
          const stimulus = Math.pow(1 - dist / 250, 1.3) * 0.75;
          if (n.refractory <= 0) {
            n.potential += stimulus;
            if (n.potential >= n.currentThreshold) {
              fireNeuron(n, -1, 0);
            }
          }
        }
      }
    });

    // -------------------------------------------------------------
    // SOFT HISTOLOGICAL SOMA DRAWING (Zero Cartoon Outlines)
    // -------------------------------------------------------------
    function drawSoftHistologicalSoma(ctx, x, y, r, angle, excitation, spike, type) {
      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(angle);

      // Radial Cytoplasmic Density Gradient (Dense Nucleus fading into soft translucent membrane)
      const grad = ctx.createRadialGradient(0, 0, r * 0.15, 0, 0, r * 2.2);

      if (spike > 0.05) {
        // Active Action Potential Flash: Radiant Champagne-Gold nucleus blooming into Emerald/Sage halo
        grad.addColorStop(0, `rgba(255, 255, 255, ${0.9 * spike})`);
        grad.addColorStop(0.25, `rgba(245, 158, 11, ${0.85 * spike})`);
        grad.addColorStop(0.65, `rgba(13, 148, 136, ${0.45 * spike})`);
        grad.addColorStop(1, 'rgba(13, 148, 136, 0)');
      } else if (excitation > 0.1) {
        // Depolarizing / Charging: Luminous warm amber swelling from nucleus
        grad.addColorStop(0, `rgba(217, 119, 6, ${0.4 + excitation * 0.5})`);
        grad.addColorStop(0.5, `rgba(245, 158, 11, ${0.2 + excitation * 0.35})`);
        grad.addColorStop(1, 'rgba(245, 158, 11, 0)');
      } else {
        // Dormant Resting: Translucent warm histological stain (sepia-charcoal core)
        grad.addColorStop(0, 'rgba(120, 110, 100, 0.45)');
        grad.addColorStop(0.55, 'rgba(168, 155, 142, 0.22)');
        grad.addColorStop(1, 'rgba(168, 155, 142, 0)');
      }

      // Fill soft organic cytoplasmic wash
      ctx.fillStyle = grad;
      ctx.beginPath();
      if (type === 'pyramidal') {
        ctx.moveTo(0, -r * 1.6);
        ctx.quadraticCurveTo(r * 1.3, r * 0.3, r * 0.9, r * 1.2);
        ctx.quadraticCurveTo(0, r * 1.5, -r * 0.9, r * 1.2);
        ctx.quadraticCurveTo(-r * 1.3, r * 0.3, 0, -r * 1.6);
      } else if (type === 'bipolar') {
        ctx.ellipse(0, 0, r * 0.75, r * 1.6, 0, 0, Math.PI * 2);
      } else {
        ctx.arc(0, 0, r * 1.3, 0, Math.PI * 2);
      }
      ctx.fill();

      // Dense central nucleus organelle
      const nucleusR = Math.max(1.2, r * 0.38);
      ctx.beginPath();
      ctx.arc(0, 0, nucleusR, 0, Math.PI * 2);
      if (spike > 0.05) {
        ctx.fillStyle = `rgba(255, 255, 255, ${0.95 * spike})`;
      } else if (excitation > 0.1) {
        ctx.fillStyle = `rgba(217, 119, 6, ${0.5 + excitation * 0.4})`;
      } else {
        ctx.fillStyle = 'rgba(90, 80, 72, 0.55)';
      }
      ctx.fill();

      // Soft, organic dendritic branches emerging smoothly without hard strokes
      ctx.beginPath();
      if (type === 'pyramidal') {
        // Apical trunk
        ctx.moveTo(0, -r * 1.2);
        ctx.quadraticCurveTo(r * 0.3, -r * 2.2, 0, -r * 3.2);
        ctx.moveTo(0, -r * 3.2);
        ctx.quadraticCurveTo(-r * 0.6, -r * 4.0, -r * 0.9, -r * 4.6);
        ctx.moveTo(0, -r * 3.2);
        ctx.quadraticCurveTo(r * 0.6, -r * 4.0, r * 0.9, -r * 4.6);
        // Basal branches
        ctx.moveTo(-r * 0.8, r * 1.0);
        ctx.quadraticCurveTo(-r * 1.6, r * 1.8, -r * 2.4, r * 2.5);
        ctx.moveTo(r * 0.8, r * 1.0);
        ctx.quadraticCurveTo(r * 1.6, r * 1.8, r * 2.4, r * 2.5);
      } else if (type === 'bipolar') {
        ctx.moveTo(0, -r * 1.4);
        ctx.quadraticCurveTo(r * 0.4, -r * 2.4, 0, -r * 3.4);
        ctx.moveTo(0, r * 1.4);
        ctx.quadraticCurveTo(-r * 0.4, r * 2.4, 0, r * 3.4);
      } else {
        const branches = 4;
        for (let b = 0; b < branches; b++) {
          const ba = (b * Math.PI * 2) / branches;
          const sx = Math.cos(ba) * r * 0.9;
          const sy = Math.sin(ba) * r * 0.9;
          const mx = Math.cos(ba + 0.3) * r * 2.0;
          const my = Math.sin(ba + 0.3) * r * 2.0;
          const ex = Math.cos(ba - 0.15) * r * 3.0;
          const ey = Math.sin(ba - 0.15) * r * 3.0;
          ctx.moveTo(sx, sy);
          ctx.quadraticCurveTo(mx, my, ex, ey);
        }
      }

      ctx.strokeStyle = spike > 0.05
        ? `rgba(13, 148, 136, ${0.5 + spike * 0.4})`
        : (excitation > 0.1 ? `rgba(217, 119, 6, ${0.2 + excitation * 0.45})` : 'rgba(150, 140, 130, 0.32)');
      ctx.lineWidth = 0.8;
      ctx.stroke();

      ctx.restore();
    }

    let time = 0;

    function render() {
      ctx.clearRect(0, 0, width, height);

      time += 0.012;

      // 1. Biological State Integration & Leaky Decay
      for (let i = 0; i < neurons.length; i++) {
        const n = neurons[i];

        // Smooth subtle drift
        n.x = n.baseX + Math.sin(time * n.driftSpeed * 100 + n.phase) * n.driftRadius;
        n.y = n.baseY + Math.cos(time * n.driftSpeed * 80 + n.phase) * (n.driftRadius * 0.65);

        // Hover proximity induction
        if (mouse.active) {
          const dx = mouse.x - n.x;
          const dy = mouse.y - n.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 135 && n.refractory <= 0) {
            const hoverEPSP = (1 - dist / 135) * 0.01;
            n.potential = Math.min(n.currentThreshold - 0.05, n.potential + hoverEPSP);
          }
        }

        // Leaky integrator potential decay
        n.potential *= 0.985;

        // Fatigue recovery
        if (n.currentThreshold > n.baseThreshold) {
          n.currentThreshold = Math.max(n.baseThreshold, n.currentThreshold - 0.005);
        }

        // Refractory countdown
        if (n.refractory > 0) {
          n.refractory--;
        }

        // Action potential spike flash decay
        if (n.spikeEnergy > 0) {
          n.spikeEnergy *= 0.90;
        }

        // Micro-vibration proportional to membrane potential
        if (n.potential > 0.15) {
          const jitterMag = n.potential * 1.6;
          n.jitterX = (Math.random() - 0.5) * jitterMag;
          n.jitterY = (Math.random() - 0.5) * jitterMag;
        } else {
          n.jitterX = 0;
          n.jitterY = 0;
        }
      }

      // 2. Render Curvilinear Axons with Synaptic Boutons & Non-Uniform Tapering
      for (let c = 0; c < connections.length; c++) {
        const conn = connections[c];
        const nA = neurons[conn.from];
        const nB = neurons[conn.to];

        const activeCharge = Math.max(nA.potential, nB.potential);
        const activeSpike = Math.max(nA.spikeEnergy, nB.spikeEnergy);

        const midX = (nA.x + nB.x) * 0.5 + conn.curveOffsetX;
        const midY = (nA.y + nB.y) * 0.5 + conn.curveOffsetY;

        // Base curved axon fiber
        ctx.beginPath();
        ctx.moveTo(nA.x + nA.jitterX, nA.y + nA.jitterY);
        ctx.quadraticCurveTo(midX, midY, nB.x + nB.jitterX, nB.y + nB.jitterY);

        if (activeSpike > 0.08) {
          ctx.strokeStyle = `rgba(13, 148, 136, ${0.35 + activeSpike * 0.45})`;
          ctx.lineWidth = 1.1 + activeSpike * 0.7;
        } else if (activeCharge > 0.15) {
          ctx.strokeStyle = `rgba(217, 119, 6, ${0.12 + activeCharge * 0.35})`;
          ctx.lineWidth = 0.8 + activeCharge * 0.4;
        } else {
          ctx.strokeStyle = 'rgba(195, 188, 180, 0.28)';
          ctx.lineWidth = 0.65;
        }
        ctx.stroke();

        // Draw Synaptic Boutons (Varicosities) along the filament
        for (let b = 0; b < conn.boutons.length; b++) {
          const bt = conn.boutons[b].t;
          const invBt = 1 - bt;
          const bx = invBt * invBt * nA.x + 2 * invBt * bt * midX + bt * bt * nB.x;
          const by = invBt * invBt * nA.y + 2 * invBt * bt * midY + bt * bt * nB.y;

          ctx.beginPath();
          ctx.arc(bx, by, conn.boutons[b].radius, 0, Math.PI * 2);

          if (activeSpike > 0.08) {
            ctx.fillStyle = `rgba(13, 148, 136, ${0.6 * activeSpike})`;
          } else if (activeCharge > 0.15) {
            ctx.fillStyle = `rgba(217, 119, 6, ${0.25 + activeCharge * 0.4})`;
          } else {
            ctx.fillStyle = 'rgba(180, 172, 164, 0.35)';
          }
          ctx.fill();
        }
      }

      // 3. Render High-Fidelity Multi-Phase Action Potential Wave Packets
      for (let p = activePulses.length - 1; p >= 0; p--) {
        const pulse = activePulses[p];
        pulse.progress += pulse.speed;

        const nA = pulse.fromNeuron;
        const nB = pulse.toNeuron;

        let curveX = 0;
        let curveY = 0;
        for (let c = 0; c < connections.length; c++) {
          if ((connections[c].from === nA.id && connections[c].to === nB.id) ||
              (connections[c].from === nB.id && connections[c].to === nA.id)) {
            curveX = connections[c].curveOffsetX;
            curveY = connections[c].curveOffsetY;
            break;
          }
        }

        const midX = (nA.x + nB.x) * 0.5 + curveX;
        const midY = (nA.y + nB.y) * 0.5 + curveY;

        // Render traveling ion wave packet (bright leading spark + bioluminescent sage tail)
        const steps = 6;
        for (let s = 0; s < steps; s++) {
          const lag = s * 0.022;
          const t = Math.max(0, Math.min(1.0, pulse.progress - lag));
          const invT = 1 - t;
          const px = invT * invT * nA.x + 2 * invT * t * midX + t * t * nB.x;
          const py = invT * invT * nA.y + 2 * invT * t * midY + t * t * nB.y;

          ctx.beginPath();
          if (s === 0) {
            // Intense leading spark (Champagne Gold)
            ctx.arc(px, py, 2.4, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(255, 235, 180, ${0.95 * pulse.energy})`;
            ctx.fill();

            // Corona
            ctx.beginPath();
            ctx.arc(px, py, 5.0, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(245, 158, 11, ${0.45 * pulse.energy})`;
            ctx.fill();
          } else {
            // Fading bioluminescent wake (Warm Amber -> Sage Green)
            const tailAlpha = (1 - s / steps) * 0.45 * pulse.energy;
            ctx.arc(px, py, 2.0 - s * 0.25, 0, Math.PI * 2);
            ctx.fillStyle = s < 3
              ? `rgba(217, 119, 6, ${tailAlpha})`
              : `rgba(13, 148, 136, ${tailAlpha * 0.8})`;
            ctx.fill();
          }
        }

        // Synaptic arrival & downstream excitation
        if (pulse.progress >= 1.0) {
          const target = pulse.toNeuron;
          if (target.refractory <= 0) {
            target.potential += 0.4 * pulse.energy;
            if (target.potential >= target.currentThreshold) {
              fireNeuron(target, nA.id, pulse.hop);
            }
          }
          activePulses.splice(p, 1);
        }
      }

      // 4. Render Soft Histological Somas
      for (let i = 0; i < neurons.length; i++) {
        const n = neurons[i];
        const posX = n.x + n.jitterX;
        const posY = n.y + n.jitterY;

        const effectiveR = n.radius * (1.0 + n.potential * 0.2 + n.spikeEnergy * 0.5);
        drawSoftHistologicalSoma(ctx, posX, posY, effectiveR, n.angle, n.potential, n.spikeEnergy, n.type);
      }

      requestAnimationFrame(render);
    }

    render();
  })();
</script>
