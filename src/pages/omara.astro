---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChapterMarker from '../components/case-study/ChapterMarker.astro';
import StepEyebrow from '../components/case-study/StepEyebrow.astro';
import Vitrine from '../components/case-study/Vitrine.astro';
import Caption from '../components/case-study/Caption.astro';
import RestingRule from '../components/case-study/RestingRule.astro';
---

<BaseLayout title="Omara Technologies · Digitizing Public Welfare Systems" theme="light">

<main id="main" class="relative max-w-page mx-auto px-6 md:px-16 lg:px-20 pb-72 pt-20 md:pt-32 font-sans text-neutral-800 selection:bg-amber-500/20 selection:text-neutral-900">

  <!-- HERO SECTION: Executive Masthead & Operational Scope -->
  <section class="mb-32 md:mb-48 relative">
    <div class="max-w-6xl mb-16">
      <div class="text-[10px] font-mono tracking-[0.28em] text-neutral-500 uppercase font-medium mb-6">
        Case Study · Public Welfare Systems &amp; Design Tooling
      </div>
      <h1 class="font-serif text-5xl sm:text-7xl lg:text-[6.25rem] font-normal leading-[0.94] tracking-[-0.04em] text-neutral-950 mb-10 text-balance">
        Digitizing Public Welfare Administration.
      </h1>
      <p class="text-2xl sm:text-3xl text-neutral-800 font-normal leading-snug tracking-tight mb-14 max-w-[52ch]">
        Moving paper-based welfare schemes online with citizen and caseworker portals, supported by custom design system tooling.
      </p>

      <div class="grid grid-cols-1 lg:grid-cols-[1.3fr_0.7fr] gap-12 lg:gap-24 items-start pt-8 border-t border-neutral-200">
        <div>
          <p class="text-xl sm:text-2xl text-neutral-900 font-normal leading-[1.75] max-w-[52ch] text-pretty">
            Administering public welfare in India traditionally involved physical paper forms, in-person verification queues, and regional administrative offices. At Omara, I led product design to move this process online: designing an accessible application portal for citizens, an adjudication queue for caseworkers, and custom tools to maintain our design system.
          </p>
        </div>

        <!-- Margin Ledger: Broadsheet Archival Coordinates -->
        <div class="lg:pt-1 pl-0 lg:pl-10">
          <dl class="space-y-4 text-xs font-mono">
            <div>
              <dt class="text-neutral-500 text-[10px] tracking-[0.22em] uppercase mb-1 font-medium">ORGANIZATION</dt>
              <dd class="text-neutral-950 text-sm font-medium">Omara Technologies</dd>
            </div>
            <div>
              <dt class="text-neutral-500 text-[10px] tracking-[0.22em] uppercase mb-1 font-medium">MY ROLE</dt>
              <dd class="text-neutral-950 text-sm font-medium">Product Designer &amp; Tooling Engineer</dd>
            </div>
            <div>
              <dt class="text-neutral-500 text-[10px] tracking-[0.22em] uppercase mb-1 font-medium">COMPLIANCE STANDARD</dt>
              <dd class="text-neutral-950 text-sm font-medium">GIGW &amp; WCAG 2.1 AAA</dd>
            </div>
            <div>
              <dt class="text-neutral-500 text-[10px] tracking-[0.22em] uppercase mb-1 font-medium">CORE SCOPE</dt>
              <dd class="text-neutral-950 text-sm font-medium">Citizen Intake, Caseworker Review, Figma Tooling</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>

    <!-- Monumental Hero Showcase: Caseworker Review & Citizen Clarification -->
    <div>
      <Vitrine padded class="p-4 sm:p-8">
        <img
          src="/assets/experience/omara-cover.png"
          alt="Omara caseworker adjudication console alongside the citizen clarification alert interface"
          class="w-full h-auto max-h-[640px] object-contain hover:scale-[1.01] transition-luxury duration-700"
          loading="eager"
        />
      </Vitrine>
      <Caption>
        An officer flagging a document discrepancy, notifying the citizen directly on their phone.
      </Caption>
    </div>
  </section>

  <!-- Architectural Section Divider -->
  <RestingRule class="mb-24 md:mb-36" />

  <!-- CHAPTER 01: THE DIGITIZATION CHALLENGE -->
  <section class="pt-8 pb-8 mb-32 md:mb-48">
    <ChapterMarker number="01" title="The Digitization Challenge" />

    <div class="max-w-4xl mb-16">
      <h2 class="font-serif text-4xl sm:text-6xl text-neutral-950 leading-[1.05] tracking-tight font-normal text-balance mb-8">
        Moving welfare administration from paper folders to connected portals.
      </h2>
      <p class="text-xl sm:text-2xl text-neutral-800 font-normal leading-[1.75] max-w-[54ch] text-pretty">
        Welfare schemes often rely on paper forms submitted at local district offices. For citizens, this meant long travel times, uncertain timelines, and return trips if a document was missing. For officers, it meant managing backlogs of physical folders. We built this platform to connect both sides: giving citizens clear tracking on their phones and caseworkers a digital triage queue.
      </p>
    </div>

    <!-- Operational Workflow Ledger -->
    <div class="border-t border-neutral-200 pt-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10 sm:gap-12">
        <div class="space-y-3">
          <div class="font-mono text-xs text-amber-800 font-semibold tracking-wider uppercase">01 / DIGITAL INTAKE</div>
          <h3 class="font-serif text-2xl text-neutral-950 font-normal">Online Application</h3>
          <p class="text-sm text-neutral-700 leading-relaxed">
            Citizens fill out intuitive forms and upload photos or scans of their proofs from their phones, guided by clear document guidelines.
          </p>
        </div>

        <div class="space-y-3">
          <div class="font-mono text-xs text-amber-800 font-semibold tracking-wider uppercase">02 / CENTRALIZED REVIEW</div>
          <h3 class="font-serif text-2xl text-neutral-950 font-normal">Officer Triage Queue</h3>
          <p class="text-sm text-neutral-700 leading-relaxed">
            Caseworkers review applications in an organized digital queue, cross-referencing applicant statements with uploaded certificates on one screen.
          </p>
        </div>

        <div class="space-y-3">
          <div class="font-mono text-xs text-amber-800 font-semibold tracking-wider uppercase">03 / DIRECT RESOLUTION</div>
          <h3 class="font-serif text-2xl text-neutral-950 font-normal">Targeted Follow-Up</h3>
          <p class="text-sm text-neutral-700 leading-relaxed">
            If a document is blurred or incomplete, the officer flags the specific gap and the citizen uploads the correct document directly, avoiding repeat office visits.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Architectural Section Divider -->
  <RestingRule class="mb-24 md:mb-36" />

  <!-- CHAPTER 02: DIGITAL VERIFICATION -->
  <section class="pt-8 pb-8 mb-32 md:mb-48">
    <ChapterMarker number="02" title="Digital Verification" />

    <div class="max-w-4xl mb-16">
      <h2 class="font-serif text-4xl sm:text-6xl text-neutral-950 leading-[1.05] tracking-tight font-normal text-balance mb-8">
        Streamlining document verification for public benefits.
      </h2>
      <p class="text-xl sm:text-2xl text-neutral-800 font-normal leading-[1.75] max-w-[54ch] text-pretty">
        Qualifying for social benefits requires proving eligibility: household income limits, identity records, and active bank accounts for Direct Benefit Transfer (DBT). Offline, this required gazetted attestations and in-person visits. We designed structured verification steps that confirm eligibility quickly while keeping the interface clear for first-time internet users.
      </p>
    </div>

    <!-- Simplified Verification Summary Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12 border-t border-neutral-200 pt-8">
      <div class="space-y-3">
        <span class="text-[10px] font-mono text-amber-800 uppercase tracking-widest block font-medium">STEP 01</span>
        <h3 class="text-2xl font-serif text-neutral-950 font-normal">Identity &amp; Demographics</h3>
        <p class="text-sm text-neutral-700 leading-relaxed font-normal">
          Straightforward document upload and basic identity validation to confirm applicant details without requiring physical visits to regional offices.
        </p>
      </div>

      <div class="space-y-3">
        <span class="text-[10px] font-mono text-amber-800 uppercase tracking-widest block font-medium">STEP 02</span>
        <h3 class="text-2xl font-serif text-neutral-950 font-normal">Bank Account Validation</h3>
        <p class="text-sm text-neutral-700 leading-relaxed font-normal">
          Direct verification of account numbers and IFSC details to ensure educational grants and social security pensions reach the correct beneficiary via Direct Benefit Transfer (DBT).
        </p>
      </div>

      <div class="space-y-3">
        <span class="text-[10px] font-mono text-amber-800 uppercase tracking-widest block font-medium">STEP 03</span>
        <h3 class="text-2xl font-serif text-neutral-950 font-normal">Official Certificates</h3>
        <p class="text-sm text-neutral-700 leading-relaxed font-normal">
          Standardized intake formats for regional documents (caste certificates, income declarations, and disability proofs) with full-resolution previews for reviewing officers.
        </p>
      </div>
    </div>
  </section>

  <!-- Architectural Section Divider -->
  <RestingRule class="mb-24 md:mb-36" />

  <!-- CHAPTER 03: AN EVOLVING DESIGN SYSTEM -->
  <section class="pt-8 pb-8 mb-32 md:mb-48">
    <ChapterMarker number="03" title="An Evolving Design System" />

    <div class="max-w-4xl mb-16">
      <h2 class="font-serif text-4xl sm:text-6xl text-neutral-950 leading-[1.05] tracking-tight font-normal text-balance mb-8">
        Building reusable patterns across diverse state programs.
      </h2>
      <p class="text-xl sm:text-2xl text-neutral-800 font-normal leading-[1.75] max-w-[54ch] text-pretty">
        Working across different state departments meant continually encountering new requirements, from rural land records to multi-generational family structures. Rather than building custom forms for each scheme, I cataloged recurring patterns and turned them into reusable components. As each new scheme launched, the system grew more capable without having to reinvent core building blocks.
      </p>
    </div>

    <!-- Domain Patterns & Governance Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12 border-t border-neutral-200 pt-8">
      <div class="space-y-4">
        <span class="text-[10px] font-mono text-amber-800 uppercase tracking-widest block font-medium">Pattern 01</span>
        <h3 class="text-2xl font-serif text-neutral-950 font-normal">Land &amp; Property Ledgers</h3>
        <p class="text-sm text-neutral-700 leading-relaxed font-normal">
          Modular parcel hierarchy selectors (Survey/Khasra numbers, Sub-division, and Village mapping) adaptable across diverse state cadastral systems and joint titleholder formats.
        </p>
      </div>

      <div class="space-y-4">
        <span class="text-[10px] font-mono text-amber-800 uppercase tracking-widest block font-medium">Pattern 02</span>
        <h3 class="text-2xl font-serif text-neutral-950 font-normal">Family &amp; Household Structures</h3>
        <p class="text-sm text-neutral-700 leading-relaxed font-normal">
          Dynamic demographic components supporting joint household relationships, dependent tracking, and guardian verifications across family welfare schemes.
        </p>
      </div>

      <div class="space-y-4">
        <span class="text-[10px] font-mono text-amber-800 uppercase tracking-widest block font-medium">Pattern 03</span>
        <h3 class="text-2xl font-serif text-neutral-950 font-normal">GIGW &amp; Linguistic Inclusivity</h3>
        <p class="text-sm text-neutral-700 leading-relaxed font-normal">
          Color tokens and typographic scales built strictly to GIGW standards and WCAG 2.1 AAA contrast, tested to handle script expansion across multiple Indic languages.
        </p>
      </div>
    </div>
  </section>

  <!-- Architectural Section Divider -->
  <RestingRule class="mb-24 md:mb-36" />

  <!-- CHAPTER 04: WORKFLOW AUTOMATION -->
  <section class="pt-8 pb-8 mb-32 md:mb-48 relative overflow-hidden">
    <ChapterMarker number="04" title="Workflow Automation" />

    <div class="max-w-4xl mb-16">
      <h2 class="font-serif text-4xl sm:text-6xl text-neutral-950 leading-[1.05] tracking-tight font-normal text-balance mb-8">
        Automating design QA and generating prototypes from specs.
      </h2>
      <p class="text-xl sm:text-2xl text-neutral-800 font-normal leading-[1.75] max-w-[54ch] text-pretty">
        Public welfare platforms involve hundreds of form states, validations, and accessibility standards. To keep our work consistent and avoid manual wiring, I built two custom automation tools using Figma's APIs.
      </p>
    </div>

    <!-- Custom Tools Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 border-t border-neutral-200 pt-10">
      <div class="space-y-4">
        <StepEyebrow label="TOOL" number="01" accent />
        <h3 class="text-3xl font-serif text-neutral-950 font-normal">
          Figma Component Auditor
        </h3>
        <p class="text-base text-neutral-700 font-normal leading-relaxed">
          A custom plugin that checks component libraries against our design tokens, autolayout rules, and GIGW color contrast standards. It flags inconsistencies, applies corrections, and syncs updated component specs directly to Notion for developer handoff.
        </p>
      </div>

      <div class="space-y-4">
        <StepEyebrow label="TOOL" number="02" accent />
        <h3 class="text-3xl font-serif text-neutral-950 font-normal">
          Notion-to-Figma Prototype Generator
        </h3>
        <p class="text-base text-neutral-700 font-normal leading-relaxed">
          A script that reads structured user flows and form schemas from Notion and automatically generates token-accurate, connected Figma frames. This cut out hours of manual frame-by-frame linking for repetitive multi-step forms.
        </p>
      </div>
    </div>
  </section>

  <!-- CHAPTER NAVIGATION: Architectural Broadsheet Links -->
  <section class="pt-16 border-t border-neutral-200">
    <div class="flex flex-col sm:flex-row items-baseline justify-between gap-12 font-mono text-xs">
      <a href="/bulkmagic" class="group flex flex-col gap-2 transition-luxury">
        <span class="text-[10px] tracking-widest uppercase text-neutral-600 group-hover:text-amber-800 font-medium">← PREVIOUS CASE STUDY</span>
        <span class="font-serif text-2xl font-normal text-neutral-950 group-hover:text-amber-800">BulkMagic: Multi-State Onboarding</span>
        <span class="font-sans text-xs text-neutral-600 font-normal">Multi-state compliance onboarding sprint &amp; adaptive routing</span>
      </a>

      <a href="/vitals" class="group flex flex-col gap-2 sm:text-right transition-luxury">
        <span class="text-[10px] tracking-widest uppercase text-neutral-600 group-hover:text-amber-800 font-medium">NEXT CASE STUDY →</span>
        <span class="font-serif text-2xl font-normal text-neutral-950 group-hover:text-amber-800">Vitals: Digital Medical ID</span>
        <span class="font-sans text-xs text-neutral-600 font-normal">Overcoming the 92% drop-off barrier through trust-first onboarding</span>
      </a>
    </div>
  </section>

</main>
</BaseLayout>
