---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Omara Technologies — GovTech Welfare Review & Design-System Skills" theme="light" includeCaseStudyScript>
<!-- Luminous Gallery Atmosphere: Layered Warm Ambient Gradients -->
<div class="fixed inset-0 pointer-events-none -z-20 bg-[#FAF9F5]"></div>
<div class="fixed inset-0 pointer-events-none -z-20 bg-[radial-gradient(ellipse_75%_55%_at_70%_10%,rgba(217,119,6,0.045),transparent_65%)]"></div>
<div class="fixed inset-0 pointer-events-none -z-20 bg-[radial-gradient(ellipse_60%_45%_at_15%_25%,rgba(13,148,136,0.035),transparent_60%)]"></div>
<div class="fixed inset-0 pointer-events-none -z-20 bg-[radial-gradient(ellipse_55%_40%_at_85%_75%,rgba(217,119,6,0.03),transparent_70%)]"></div>

<main id="main" class="relative max-w-page mx-auto px-6 md:px-20 pb-72 pt-20 md:pt-32 font-sans text-neutral-800 selection:bg-amber-500/20 selection:text-neutral-900">

  <!-- CASE STUDY HEADER / FOLIO ARCHIVE DATELINE -->
  <header class="flex flex-wrap items-center justify-between gap-6 pb-6 mb-16 text-[10px] font-mono tracking-[0.28em] text-neutral-600 uppercase border-b border-neutral-200 font-medium">
    <div class="flex items-center gap-3">
      <a href="/" class="text-neutral-950 hover:text-amber-800 transition-luxury font-medium">MEGHAN LENDHE</a>
      <span class="text-neutral-300">/</span>
      <span>CASE STUDY 04</span>
    </div>
    <div class="flex items-center gap-6 text-neutral-600">
      <span>GOVTECH PLATFORMS</span>
      <span class="text-neutral-300">/</span>
      <span class="text-neutral-800 font-medium">WELFARE TRIAGE &amp; DESIGN-SYSTEM AUTOMATION</span>
    </div>
  </header>

  <!-- HERO SECTION: Monumental Headline & Narrative Scale Bridge -->
  <section class="mb-32 md:mb-48">
    <div class="max-w-6xl mb-20">
      <span class="text-[10px] font-mono tracking-[0.28em] text-amber-800 uppercase block mb-6 font-medium">
        PUBLIC SECTOR INTERACTION DESIGN &amp; TOOLING
      </span>
      <h1 class="font-serif text-5xl sm:text-7xl lg:text-[6.5rem] font-normal leading-[0.94] tracking-[-0.04em] text-neutral-950 mb-10 text-balance">
        Clearer Reviews, Faster Design Workflows.
      </h1>
      <p class="text-2xl sm:text-3xl text-neutral-800 font-normal leading-snug tracking-tight mb-14 max-w-[50ch]">
        Designing caseworker triage interfaces for offline welfare applications while engineering automated design-system verification skills.
      </p>

      <div class="grid grid-cols-1 lg:grid-cols-[1.3fr_0.7fr] gap-12 lg:gap-24 items-start pt-6 border-t border-neutral-200">
        <div>
          <p class="text-xl sm:text-2xl text-neutral-800 font-normal leading-[1.75] max-w-[52ch] text-pretty mb-8">
            Government welfare programs process thousands of physical, offline citizen applications weekly. When documents are incomplete or illegible, caseworkers face severe administrative backlogs. <span class="text-neutral-950 font-normal underline decoration-neutral-300 underline-offset-8">I designed an officer-facing review engine</span> to resolve citizen information gaps while simultaneously engineering automated skills to verify UI component fidelity.
          </p>
          <div class="font-serif italic text-2xl sm:text-3xl text-neutral-900 leading-relaxed max-w-[46ch]">
            “Public sector software succeeds when it respects the cognitive load of caseworkers—turning bureaucratic backlog into structured, compassionate triage.”
          </div>
        </div>

        <!-- Margin Ledger: Project Specifications (Pure Broadsheet Typography) -->
        <div class="space-y-8 lg:pt-2 pl-0 lg:pl-10">
          <div class="text-[10px] font-mono uppercase tracking-[0.28em] text-neutral-600 font-medium">PROJECT COORDINATES</div>
          <dl class="space-y-6 text-xs font-mono">
            <div>
              <dt class="text-neutral-600 text-[10px] tracking-[0.25em] uppercase mb-1 font-medium">CLIENT &amp; DOMAIN</dt>
              <dd class="text-neutral-950 text-base font-medium">Omara Technologies</dd>
              <dd class="text-neutral-600 text-xs font-sans mt-0.5">Government welfare &amp; public services</dd>
            </div>
            <div>
              <dt class="text-neutral-600 text-[10px] tracking-[0.25em] uppercase mb-1 font-medium">CORE DELIVERABLES</dt>
              <dd class="text-neutral-950 text-base font-medium">Caseworker Portal &amp; AI Tooling</dd>
              <dd class="text-neutral-600 text-xs font-sans mt-0.5">Triage workflows + automated audit skills</dd>
            </div>
            <div>
              <dt class="text-neutral-600 text-[10px] tracking-[0.25em] uppercase mb-1 font-medium">ROLE &amp; OWNERSHIP</dt>
              <dd class="text-neutral-950 text-base font-medium">Product Designer &amp; Tooling Eng</dd>
              <dd class="text-neutral-600 text-xs font-sans mt-0.5">End-to-end UX, prototyping &amp; Claude Code skills</dd>
            </div>
            <div>
              <dt class="text-neutral-600 text-[10px] tracking-[0.25em] uppercase mb-1 font-medium">SYSTEM OUTCOME</dt>
              <dd class="text-neutral-950 text-base font-medium">Automated Component Linting</dd>
              <dd class="text-neutral-600 text-xs font-sans mt-0.5">Hours to minutes prototype generation</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>

    <!-- Monumental Hero Image Spread -->
    <div class="relative overflow-hidden pt-8 border-t border-neutral-200">
      <div class="aspect-[16/10] overflow-hidden bg-white/90 border border-neutral-200/90 shadow-xs flex items-center justify-center p-6 md:p-12">
        <img
          src="/assets/experience/omara-workflows.svg"
          alt="Concepts for welfare application review and design-system workflows"
          class="w-full h-auto max-h-[85%] object-contain hover:scale-[1.01] transition-luxury duration-700"
        />
      </div>
      <div class="flex items-center justify-between text-[10px] font-mono tracking-widest text-neutral-600 uppercase mt-4 border-t border-neutral-200 pt-3 font-medium">
        <span>Caseworker Triage Platform</span>
        <span>Offline Welfare Intake &amp; Verification</span>
      </div>
    </div>
  </section>

  <!-- SECTION 01: KEY METRICS & SYSTEM IMPACT -->
  <section class="py-24 border-y border-neutral-200 mb-36 md:mb-52">
    <div class="text-[10px] font-mono tracking-[0.28em] text-neutral-600 uppercase mb-16 font-medium">
      01 / Key Impact &amp; System Metrics
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-16 md:gap-12">
      <div class="space-y-4">
        <div class="font-serif text-6xl sm:text-7xl lg:text-8xl font-normal text-neutral-950 tracking-tight tabular-nums">
          100<span class="text-amber-800 font-sans text-4xl sm:text-5xl font-medium">%</span>
        </div>
        <div class="text-[10px] font-mono uppercase tracking-[0.28em] text-neutral-600 font-medium">OFFLINE APPLICATION COVERAGE</div>
        <p class="text-sm text-neutral-700 font-normal leading-relaxed max-w-[32ch]">
          Unified digital review interface digitizing paper-based welfare submissions across regional field offices.
        </p>
      </div>

      <div class="space-y-4">
        <div class="font-serif text-6xl sm:text-7xl lg:text-8xl font-normal text-neutral-950 tracking-tight tabular-nums">
          2<span class="text-amber-800 font-sans text-4xl sm:text-5xl font-medium"> Skills</span>
        </div>
        <div class="text-[10px] font-mono uppercase tracking-[0.28em] text-neutral-600 font-medium">DESIGN-SYSTEM AUTOMATION SKILLS</div>
        <p class="text-sm text-neutral-700 font-normal leading-relaxed max-w-[32ch]">
          Custom CLI-integrated agentic verification workflows validating component tokens and accessibility standards.
        </p>
      </div>

      <div class="space-y-4">
        <div class="font-serif text-6xl sm:text-7xl lg:text-8xl font-normal text-neutral-950 tracking-tight tabular-nums">
          ~85<span class="text-amber-800 font-sans text-4xl sm:text-5xl font-medium">%</span>
        </div>
        <div class="text-[10px] font-mono uppercase tracking-[0.28em] text-neutral-600 font-medium">PROTOTYPE LATENCY REDUCTION</div>
        <p class="text-sm text-neutral-700 font-normal leading-relaxed max-w-[32ch]">
          Accelerated design-to-Figma prototype assembly from hours of manual component assembly to minutes.
        </p>
      </div>
    </div>
  </section>

  <!-- SECTION 02: WELFARE APPLICATION REVIEW -->
  <section class="mb-48 md:mb-60">
    <div class="pb-5 mb-20 border-b border-neutral-200">
      <div class="text-[10px] font-mono tracking-[0.28em] text-neutral-600 uppercase font-medium">
        02 / Human-Centered Caseworker Review
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1.2fr_0.8fr] gap-16 lg:gap-24 items-start">
      <div class="space-y-8">
        <h2 class="font-serif text-4xl sm:text-6xl text-neutral-950 leading-[1.05] tracking-tight font-normal text-balance">
          Resolving applicant gaps with structured clarification loops.
        </h2>
        <div class="space-y-6 text-neutral-700 font-normal text-lg leading-[1.8] max-w-[54ch]">
          <p class="text-neutral-950 font-normal text-xl leading-relaxed">
            When citizens apply for social benefits offline, missing documents or illegible forms traditionally trigger full rejections. Caseworkers were trapped between strict compliance rules and a desire to help vulnerable applicants.
          </p>
          <p class="text-neutral-700">
            I designed an intuitive clarification request mechanism directly into the caseworker portal. Rather than denying an application outright, officers can pinpoint exact gaps—requesting targeted supplementary verification with a single action, protecting citizen access to vital aid.
          </p>
        </div>
      </div>

      <div class="space-y-6 font-mono text-xs text-neutral-700 pt-2 border-t border-neutral-200">
        <div class="text-[10px] uppercase tracking-[0.28em] text-neutral-600 font-medium">CORE WORKFLOW PILLARS</div>
        <div class="space-y-4">
          <div class="flex items-start gap-4">
            <span class="text-amber-800 font-semibold tabular-nums">01</span>
            <span>Structured document discrepancy highlighting for caseworkers.</span>
          </div>
          <div class="flex items-start gap-4">
            <span class="text-amber-800 font-semibold tabular-nums">02</span>
            <span>One-click clarification notices sent to citizens via SMS/Mail.</span>
          </div>
          <div class="flex items-start gap-4">
            <span class="text-amber-800 font-semibold tabular-nums">03</span>
            <span>Audit-ready audit trails compliant with statutory welfare regulations.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 03: DESIGN-SYSTEM AUTOMATION -->
  <section class="mb-48 md:mb-60">
    <div class="pb-5 mb-20 border-b border-neutral-200">
      <div class="text-[10px] font-mono tracking-[0.28em] text-neutral-600 uppercase font-medium">
        03 / Design System Automation
      </div>
    </div>

    <div class="max-w-4xl mb-24">
      <h2 class="font-serif text-4xl sm:text-6xl text-neutral-950 mb-6 font-normal text-balance">
        Turning design-system maintenance into reusable agentic skills.
      </h2>
      <p class="text-xl text-neutral-800 font-normal leading-[1.7] max-w-[52ch]">
        To maintain rigorous UI quality without slowing feature delivery, I engineered two Claude Code agentic skills that automate governance, accessibility audits, and prototype assembly.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 border-t border-neutral-200 pt-16">
      <div class="space-y-5">
        <span class="text-[10px] font-mono text-amber-800 uppercase tracking-widest block font-medium">Tool 01 · Verification</span>
        <h3 class="text-3xl font-serif text-neutral-950 font-normal">
          Component Audit &amp; Linting
        </h3>
        <p class="text-base text-neutral-700 font-normal leading-[1.75]">
          A specialized skill that audits React/HTML component implementations against internal design tokens, contrast ratios, and spacing scales. It automatically surfaces discrepancies and generates precise pull requests to fix drift.
        </p>
      </div>

      <div class="space-y-5">
        <span class="text-[10px] font-mono text-amber-800 uppercase tracking-widest block font-medium">Tool 02 · Generation</span>
        <h3 class="text-3xl font-serif text-neutral-950 font-normal">
          High-Fidelity Prototype Assembly
        </h3>
        <p class="text-base text-neutral-700 font-normal leading-[1.75]">
          An automated generation pipeline that converts structured user flow descriptions into token-accurate, interactive layout structures—reducing prototype creation time from multiple hours to minutes.
        </p>
      </div>
    </div>
  </section>

  <!-- CHAPTER NAVIGATION: Architectural Broadsheet Links -->
  <section class="pt-16 border-t border-neutral-200">
    <div class="flex flex-col sm:flex-row items-baseline justify-between gap-12 font-mono text-xs">
      <a href="/bulkmagic" class="group flex flex-col gap-2 transition-luxury">
        <span class="text-[10px] tracking-widest uppercase text-neutral-600 group-hover:text-amber-800 font-medium">← PREVIOUS CASE STUDY</span>
        <span class="font-serif text-2xl font-normal text-neutral-950 group-hover:text-amber-800">BulkMagic: Multi-State Onboarding</span>
        <span class="font-sans text-xs text-neutral-600 font-normal">Campus group-buying state machine &amp; compliance UX</span>
      </a>

      <a href="/cool-school" class="group flex flex-col gap-2 sm:text-right transition-luxury">
        <span class="text-[10px] tracking-widest uppercase text-neutral-600 group-hover:text-amber-800 font-medium">NEXT CASE STUDY →</span>
        <span class="font-serif text-2xl font-normal text-neutral-950 group-hover:text-amber-800">Cool School: Game Architecture</span>
        <span class="font-sans text-xs text-neutral-600 font-normal">Pediatric conflict-resolution &amp; developmental play</span>
      </a>
    </div>
  </section>

</main>
</BaseLayout>
