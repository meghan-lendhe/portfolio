---
import BaseLayout from '../layouts/BaseLayout.astro';
import source from '../content/omara.html?raw';

const main = source.match(new RegExp('<main[\\s\\S]*?</main>'))?.[0].replaceAll('assets/', '/assets/') ?? '';
---

<BaseLayout title="Omara Technologies — Government Services and Design-System Work">
  <Fragment set:html={main} />
</BaseLayout>
