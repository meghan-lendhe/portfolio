---
interface Props {
  theme?: 'light' | 'dark';
}

const { theme = 'light' } = Astro.props;
const isDark = theme === 'dark';
---

<footer class={isDark ? "bg-[#090A0C] text-white border-t border-white/[0.07]" : "bg-black text-white"}>
  <div class="mx-auto max-w-page px-6 md:px-20 pb-16 pt-24 md:pb-24 md:pt-36">
    <div class="grid gap-12 pb-20 md:grid-cols-[1fr_1fr] md:items-start md:gap-20 border-b border-white/[0.07]">
      <div>
        <span class={isDark ? "inline-block text-[9px] font-mono tracking-[0.36em] text-neutral-500 uppercase mb-6" : "hidden"}>COLLOQUIUM &amp; INQUIRY</span>
        <h2 class="font-serif text-4xl sm:text-6xl font-light text-white leading-tight tracking-tight">
          Initiate dialogue.
        </h2>
      </div>
      <div class="space-y-8 lg:pt-2">
        <p class="text-lg md:text-xl font-light leading-relaxed text-neutral-300 max-w-[44ch]">
          Open to research inquiries, engineering collaboration, and opportunities across neural interfaces, foundation biosignal decoders, and complex operational systems.
        </p>
        <div class="flex flex-wrap items-center gap-6 font-mono text-xs">
          <a
            href="mailto:meghanlendhe@gmail.com"
            class="group inline-flex items-center gap-2 text-white border-b border-white/20 pb-1 hover:border-amber-400 hover:text-amber-300 transition-luxury"
          >
            <span>meghanlendhe@gmail.com</span>
            <span class="text-neutral-500 group-hover:text-amber-300 transition-luxury">→</span>
          </a>
          <a
            href="https://www.linkedin.com/in/meghanlendhe/"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2 text-neutral-400 border-b border-white/10 pb-1 hover:border-amber-400 hover:text-amber-300 transition-luxury"
          >
            <span>LinkedIn Archive</span>
            <span class="text-neutral-600 group-hover:text-amber-300 transition-luxury">↗</span>
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </div>
      </div>
    </div>
    <div class="flex flex-col gap-4 pt-8 text-[10px] font-mono tracking-[0.25em] text-neutral-500 uppercase sm:flex-row sm:items-center sm:justify-between">
      <span>© 2026 MEGHAN LENDHE · NEURAL INTERFACES &amp; BIOSIGNAL COMPUTING</span>
      <a href="#main" class="w-fit text-neutral-400 transition-luxury hover:text-amber-300">
        TOP OF FOLIO ↑
      </a>
    </div>
  </div>
</footer>
