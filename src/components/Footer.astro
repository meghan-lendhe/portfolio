---
interface Props {
  theme?: 'light' | 'dark';
}

const { theme = 'light' } = Astro.props;
const isDark = theme === 'dark';
---

<footer class={`relative overflow-hidden ${isDark ? "bg-[#090A0C] text-white border-t border-white/[0.07]" : "bg-[#F3F2EC] text-neutral-900 border-t border-neutral-200"}`}>
  <!-- Ambient Atmospheric Substrate (Calm Stationary Gallery Glow) -->
  <div
    class="absolute -top-32 left-10 md:left-1/4 w-[640px] h-[640px] rounded-full pointer-events-none blur-3xl opacity-80"
    style={`background: ${
      isDark
        ? "radial-gradient(ellipse at center, rgba(217,119,6,0.16), rgba(13,148,136,0.09) 45%, rgba(13,148,136,0.02) 70%, transparent 85%)"
        : "radial-gradient(ellipse at center, rgba(217,119,6,0.12), rgba(245,158,11,0.07) 40%, rgba(13,148,136,0.04) 65%, transparent 80%)"
    };`}
    aria-hidden="true"
  ></div>

  <div class="mx-auto max-w-page px-6 md:px-20 pb-16 pt-24 md:pb-24 md:pt-36 relative z-10">
    <div class={`grid gap-12 pb-20 md:grid-cols-[1.1fr_0.9fr] md:items-start md:gap-20 border-b ${isDark ? 'border-white/[0.07]' : 'border-neutral-200'}`}>
      
      <!-- Left: Invitation & Anatomical Colophon -->
      <div>
        <div id="footer-colophon-mark" class="mb-6 inline-flex items-center gap-3 group cursor-pointer select-none" title="Anatomical Ramón y Cajal pyramidal soma">
          <!-- Living Histological Pyramidal Neuron Colophon (Micro-Kinetic Vector) -->
          <svg
            id="footer-colophon-svg"
            class={`size-6 overflow-visible transition-luxury ${isDark ? 'text-neutral-400 group-hover:text-amber-400' : 'text-neutral-600 group-hover:text-amber-800'}`}
            viewBox="0 0 28 28"
            fill="none"
            stroke="currentColor"
            stroke-width="1.1"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <!-- Apical Dendrite & Branchlets -->
            <path id="colophon-apical" d="M14 11V2M14 5l-3.5-3M14 5l3.5-3M14 8l-4-2M14 8l4-2" />
            <!-- Apical Spines -->
            <line x1="13.2" y1="3.5" x2="12" y2="3" stroke-width="0.8" />
            <line x1="14.8" y1="3.5" x2="16" y2="3" stroke-width="0.8" />
            <line x1="13.2" y1="6.5" x2="11.8" y2="6.2" stroke-width="0.8" />
            <line x1="14.8" y1="6.5" x2="16.2" y2="6.2" stroke-width="0.8" />
            <!-- Pyramidal Soma Cell Body -->
            <polygon
              id="colophon-soma"
              points="14,11 18,17 10,17"
              class="transition-all duration-500"
              fill="currentColor"
              fill-opacity="0.12"
              stroke-width="1.2"
            />
            <!-- Organelle Nucleus -->
            <circle
              id="colophon-nucleus"
              cx="14"
              cy="14.5"
              r="1.3"
              class="transition-all duration-500"
              fill="currentColor"
              fill-opacity="0.4"
            />
            <!-- Basal Dendrites -->
            <path d="M10.5 17l-3.5 3.5M17.5 17l3.5 3.5M12 17l-1.5 4.5M16 17l1.5 4.5" />
            <!-- Primary Axon Shaft -->
            <path id="colophon-axon" d="M14 17v8.5" stroke-width="1.2" />
            <!-- Conduction Pulse Bead (Emerald Action Potential Wave) -->
            <circle id="colophon-pulse-bead" cx="14" cy="2" r="1.3" fill="#0D9488" opacity="0" class="pointer-events-none" />
            <!-- Terminal Synaptic Bouton -->
            <circle id="colophon-bouton" cx="14" cy="26" r="1.1" class="transition-all duration-500" fill="currentColor" />
          </svg>
          <span class={`inline-block text-[10px] font-mono tracking-[0.28em] uppercase font-medium transition-colors ${isDark ? 'text-neutral-400 group-hover:text-amber-300' : 'text-neutral-600 group-hover:text-amber-800'}`}>Let’s Connect</span>
        </div>

        <h2 class={`font-serif text-4xl sm:text-6xl font-normal leading-tight tracking-[-0.03em] ${isDark ? 'text-white' : 'text-neutral-950'}`}>
          Let’s start a conversation.
        </h2>
      </div>

      <!-- Right: Narrative & Direct Typographic Channels -->
      <div class="space-y-8 lg:pt-2">
        <p class={`text-lg md:text-xl font-normal leading-relaxed max-w-[44ch] ${isDark ? 'text-neutral-300' : 'text-neutral-700'}`}>
          Open to lead product design roles, research partnerships, and foundational challenges across neural interfaces, biosignal computing, and high-complexity human-machine workflows.
        </p>

        <div class="flex flex-wrap items-center gap-8 font-mono text-xs">
          <!-- Direct Email Channel with Zero-Shift Tactile Copy -->
          <a
            href="mailto:meghanlendhe@gmail.com"
            id="footer-email-link"
            title="Click to copy email address (or open mail client)"
            class={`group relative inline-flex items-center gap-2.5 pb-1 transition-luxury font-medium cursor-pointer ${
              isDark
                ? 'text-white hover:text-amber-300'
                : 'text-neutral-900 hover:text-amber-800'
            }`}
          >
            <!-- Dual-State Grid Container (Zero Layout Shift) -->
            <span class="inline-grid grid-cols-1 grid-rows-1 items-center">
              <span
                id="footer-email-text"
                class="col-start-1 row-start-1 text-sm font-sans font-normal transition-all duration-300 transform opacity-100 translate-y-0"
              >
                meghanlendhe@gmail.com
              </span>
              <span
                id="footer-email-copied"
                class={`col-start-1 row-start-1 text-sm font-sans font-normal transition-all duration-300 transform opacity-0 -translate-y-1 pointer-events-none ${
                  isDark ? 'text-amber-300' : 'text-amber-800'
                }`}
              >
                Copied to clipboard
              </span>
            </span>

            <span
              id="footer-email-arrow"
              class={`inline-block transition-transform duration-500 ease-luxury ${
                isDark ? 'text-neutral-400 group-hover:text-amber-300 group-hover:translate-x-1' : 'text-amber-800 group-hover:translate-x-1'
              }`}
            >
              →
            </span>
            <!-- Luxury Animated Hairline Underline -->
            <span class={`absolute bottom-0 left-0 h-[1px] w-0 transition-all duration-500 ease-luxury group-hover:w-full ${isDark ? 'bg-amber-400/80' : 'bg-amber-800/70'}`}></span>
          </a>

          <!-- LinkedIn Channel -->
          <a
            href="https://www.linkedin.com/in/meghanlendhe/"
            target="_blank"
            rel="noopener noreferrer"
            class={`group relative inline-flex items-center gap-1.5 pb-1 transition-luxury font-medium ${
              isDark
                ? 'text-neutral-400 hover:text-amber-300'
                : 'text-neutral-700 hover:text-amber-800'
            }`}
          >
            <span>LinkedIn</span>
            <span class={`inline-block transition-transform duration-500 ease-luxury ${isDark ? 'text-neutral-500 group-hover:text-amber-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5' : 'text-amber-800 group-hover:translate-x-0.5 group-hover:-translate-y-0.5'}`}>↗</span>
            <span class="sr-only">(opens in a new tab)</span>
            <!-- Luxury Animated Hairline Underline -->
            <span class={`absolute bottom-0 left-0 h-[1px] w-0 transition-all duration-500 ease-luxury group-hover:w-full ${isDark ? 'bg-amber-400/80' : 'bg-amber-800/70'}`}></span>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Broadsheet Colophon Strip -->
    <div class={`flex flex-col gap-4 pt-8 text-[10px] font-mono tracking-[0.25em] uppercase sm:flex-row sm:items-center sm:justify-between font-medium ${isDark ? 'text-neutral-400' : 'text-neutral-600'}`}>
      <span>© 2026 MEGHAN LENDHE · MUMBAI, INDIA</span>

      <a
        href="#main"
        id="footer-back-to-top"
        class={`group inline-flex items-center gap-1.5 w-fit transition-luxury cursor-pointer ${isDark ? 'text-neutral-400 hover:text-amber-300' : 'text-neutral-600 hover:text-amber-800'}`}
      >
        <span>BACK TO TOP</span>
        <span class="inline-block transition-transform duration-500 ease-luxury group-hover:-translate-y-1">↑</span>
      </a>
    </div>

  </div>
</footer>

<script is:inline>
(function() {
  // 1. Pyramidal Colophon Micro-Kinetic Conduction
  const colophon = document.getElementById('footer-colophon-mark');
  const pulseBead = document.getElementById('colophon-pulse-bead');
  const soma = document.getElementById('colophon-soma');
  const nucleus = document.getElementById('colophon-nucleus');
  const bouton = document.getElementById('colophon-bouton');
  let isPulsing = false;

  function triggerConductionPulse(withAudio = false) {
    if (isPulsing || !pulseBead) return;
    isPulsing = true;

    if (withAudio && window.NeuroAudio) {
      window.NeuroAudio.playCelesta(587.33, 0.025);
    }

    const startTime = performance.now();
    const duration = 550; // ms

    if (soma) soma.setAttribute('fill-opacity', '0.42');
    if (nucleus) nucleus.setAttribute('fill-opacity', '0.85');

    function animatePulse(now) {
      const elapsed = now - startTime;
      const progress = Math.min(1.0, elapsed / duration);

      // Trajectory along vertical axis y: 2 to 26
      const currentY = 2 + progress * 24;
      pulseBead.setAttribute('cy', currentY.toFixed(1));

      // Fade in at top, bright in shaft, fade out at bouton
      const alpha = progress < 0.15
        ? progress / 0.15
        : (progress > 0.85 ? (1.0 - progress) / 0.15 : 1.0);
      pulseBead.setAttribute('opacity', (alpha * 0.95).toFixed(2));

      // Bouton reception flash
      if (progress > 0.82 && bouton) {
        bouton.setAttribute('r', '1.7');
        bouton.setAttribute('fill', '#0D9488');
      }

      if (progress < 1.0) {
        requestAnimationFrame(animatePulse);
      } else {
        pulseBead.setAttribute('opacity', '0');
        if (soma) soma.setAttribute('fill-opacity', '0.12');
        if (nucleus) nucleus.setAttribute('fill-opacity', '0.40');
        if (bouton) {
          setTimeout(() => {
            bouton.setAttribute('r', '1.1');
            bouton.setAttribute('fill', 'currentColor');
            isPulsing = false;
          }, 180);
        } else {
          isPulsing = false;
        }
      }
    }

    requestAnimationFrame(animatePulse);
  }

  if (colophon) {
    colophon.addEventListener('pointerenter', () => triggerConductionPulse(false));
    colophon.addEventListener('click', () => triggerConductionPulse(true));
  }

  // 2. Tactile Email Copy Affordance with Harmonic Celesta Tone & Zero Layout Shift
  const emailLink = document.getElementById('footer-email-link');
  const emailText = document.getElementById('footer-email-text');
  const emailCopied = document.getElementById('footer-email-copied');
  let copyTimeout = null;

  if (emailLink && emailText && emailCopied) {
    emailLink.addEventListener('click', (e) => {
      if (!e.metaKey && !e.ctrlKey) {
        e.preventDefault();
      }

      navigator.clipboard.writeText('meghanlendhe@gmail.com').then(() => {
        if (window.NeuroAudio) {
          window.NeuroAudio.playCelesta(659.25, 0.025);
        }

        clearTimeout(copyTimeout);
        // Seamless cross-fade with zero layout shift
        emailText.classList.remove('opacity-100', 'translate-y-0');
        emailText.classList.add('opacity-0', 'translate-y-1');

        emailCopied.classList.remove('opacity-0', '-translate-y-1');
        emailCopied.classList.add('opacity-100', 'translate-y-0');

        copyTimeout = setTimeout(() => {
          emailCopied.classList.remove('opacity-100', 'translate-y-0');
          emailCopied.classList.add('opacity-0', '-translate-y-1');

          emailText.classList.remove('opacity-0', 'translate-y-1');
          emailText.classList.add('opacity-100', 'translate-y-0');
        }, 2200);
      }).catch(() => {
        window.location.href = 'mailto:meghanlendhe@gmail.com';
      });
    });
  }

  // 4. Smooth Back to Top with Acoustic Celesta Note
  const backToTopBtn = document.getElementById('footer-back-to-top');
  if (backToTopBtn) {
    backToTopBtn.addEventListener('click', (e) => {
      e.preventDefault();
      if (window.NeuroAudio) {
        window.NeuroAudio.playCelesta(659.25, 0.025);
      }
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
  }
})();
</script>
