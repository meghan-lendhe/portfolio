---
interface Props {
  theme?: 'light' | 'dark';
}

const { theme = 'light' } = Astro.props;
const isDark = theme === 'dark';
---

<footer class={`relative overflow-hidden ${isDark ? "bg-[#090A0C] text-white border-t border-white/[0.07]" : "bg-[#F3F2EC] text-neutral-900 border-t border-neutral-200"}`}>
  <!-- Ambient Atmospheric Light Aura -->
  <div class="absolute -top-32 left-10 md:left-1/4 w-[540px] h-[540px] rounded-full bg-[radial-gradient(ellipse_at_center,rgba(217,119,6,0.055),rgba(13,148,136,0.035),transparent_70%)] pointer-events-none blur-3xl" aria-hidden="true"></div>

  <div class="mx-auto max-w-page px-6 md:px-20 pb-16 pt-24 md:pb-24 md:pt-36 relative z-10">
    <div class={`grid gap-12 pb-20 md:grid-cols-[1.1fr_0.9fr] md:items-start md:gap-20 border-b ${isDark ? 'border-white/[0.07]' : 'border-neutral-200'}`}>
      
      <!-- Left: Invitation & Anatomical Colophon -->
      <div>
        <div id="footer-colophon-mark" class="mb-6 inline-flex items-center gap-3 group cursor-pointer select-none">
          <!-- Histological Pyramidal Neuron Colophon (Bespoke Vector Craft) -->
          <svg class={`size-6 transition-luxury ${isDark ? 'text-neutral-400 group-hover:text-amber-400' : 'text-neutral-600 group-hover:text-amber-800'}`} viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <!-- Apical Dendrite & Branchlets -->
            <path d="M14 11V2M14 5l-3.5-3M14 5l3.5-3M14 8l-4-2M14 8l4-2" />
            <!-- Apical Spines -->
            <line x1="13.2" y1="3.5" x2="12" y2="3" stroke-width="0.8" />
            <line x1="14.8" y1="3.5" x2="16" y2="3" stroke-width="0.8" />
            <line x1="13.2" y1="6.5" x2="11.8" y2="6.2" stroke-width="0.8" />
            <line x1="14.8" y1="6.5" x2="16.2" y2="6.2" stroke-width="0.8" />
            <!-- Pyramidal Soma Cell Body -->
            <polygon points="14,11 18,17 10,17" class="transition-all duration-300" fill="currentColor" fill-opacity="0.12" stroke-width="1.2" />
            <!-- Organelle Nucleus -->
            <circle cx="14" cy="14.5" r="1.3" fill="currentColor" fill-opacity="0.4" />
            <!-- Basal Dendrites -->
            <path d="M10.5 17l-3.5 3.5M17.5 17l3.5 3.5M12 17l-1.5 4.5M16 17l1.5 4.5" />
            <!-- Primary Axon Shaft -->
            <path d="M14 17v8.5" stroke-width="1.2" />
            <!-- Terminal Synaptic Bouton -->
            <circle cx="14" cy="26" r="1.1" fill="currentColor" />
          </svg>
          <span class={`inline-block text-[10px] font-mono tracking-[0.28em] uppercase font-medium transition-colors ${isDark ? 'text-neutral-400 group-hover:text-amber-300' : 'text-neutral-600 group-hover:text-amber-800'}`}>Let’s Connect</span>
        </div>

        <h2 class={`font-serif text-4xl sm:text-6xl font-normal leading-tight tracking-[-0.03em] ${isDark ? 'text-white' : 'text-neutral-950'}`}>
          Let’s start a conversation.
        </h2>
      </div>

      <!-- Right: Narrative & Direct Typographic Channels -->
      <div class="space-y-8 lg:pt-2">
        <p class={`text-lg md:text-xl font-normal leading-relaxed max-w-[44ch] ${isDark ? 'text-neutral-300' : 'text-neutral-700'}`}>
          Open to lead product design roles, research partnerships, and foundational challenges across neural interfaces, biosignal computing, and high-complexity human-machine workflows.
        </p>

        <div class="flex flex-wrap items-center gap-8 font-mono text-xs">
          <a
            href="mailto:meghanlendhe@gmail.com"
            class={`action-potential-link group inline-flex items-center gap-2 pb-1 transition-luxury font-medium ${
              isDark
                ? 'text-white hover:text-amber-300'
                : 'text-neutral-900 hover:text-amber-800'
            }`}
          >
            <span class="text-sm font-sans font-normal">meghanlendhe@gmail.com</span>
            <span class={`transition-luxury ${isDark ? 'text-neutral-400 group-hover:text-amber-300' : 'text-amber-800 group-hover:translate-x-1'}`}>→</span>
          </a>

          <a
            href="https://www.linkedin.com/in/meghanlendhe/"
            target="_blank"
            rel="noopener noreferrer"
            class={`action-potential-link group inline-flex items-center gap-1.5 pb-1 transition-luxury font-medium ${
              isDark
                ? 'text-neutral-400 hover:text-amber-300'
                : 'text-neutral-700 hover:text-amber-800'
            }`}
          >
            <span>LinkedIn</span>
            <span class={`transition-luxury ${isDark ? 'text-neutral-500 group-hover:text-amber-300' : 'text-amber-800 group-hover:translate-x-0.5'}`}>↗</span>
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Broadsheet Colophon Strip -->
    <div class={`flex flex-col gap-4 pt-8 text-[10px] font-mono tracking-[0.25em] uppercase sm:flex-row sm:items-center sm:justify-between font-medium ${isDark ? 'text-neutral-400' : 'text-neutral-600'}`}>
      <span>© 2026 MEGHAN LENDHE · MUMBAI, INDIA</span>

      <a
        href="#main"
        id="footer-back-to-top"
        class={`group inline-flex items-center gap-1.5 w-fit transition-luxury cursor-pointer ${isDark ? 'text-neutral-400 hover:text-amber-300' : 'text-neutral-600 hover:text-amber-800'}`}
      >
        <span>BACK TO TOP</span>
        <span class="transition-transform group-hover:-translate-y-0.5">↑</span>
      </a>
    </div>

  </div>
</footer>

<script is:inline>
(function() {
  // 1. Pyramidal Colophon Micro-Interaction
  const colophon = document.getElementById('footer-colophon-mark');
  if (colophon) {
    colophon.addEventListener('click', () => {
      if (window.NeuroAudio) {
        window.NeuroAudio.playCelesta(587.33, 0.025);
      }
    });
  }

  // 2. Tactile Celesta Harmonic on Back to Top
  const backToTopBtn = document.getElementById('footer-back-to-top');
  if (backToTopBtn) {
    backToTopBtn.addEventListener('click', (e) => {
      e.preventDefault();
      if (window.NeuroAudio) {
        window.NeuroAudio.playCelesta(659.25, 0.025);
      }
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
  }
})();
</script>
