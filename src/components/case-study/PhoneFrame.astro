---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={[
  "group/phone shrink-0 relative rounded-[36px] sm:rounded-[40px] p-2 bg-[#0B0E14] border-[1.5px] border-[#232836] drop-shadow-[0_20px_26px_rgba(0,0,0,0.14)] hover:-translate-y-1 hover:drop-shadow-[0_28px_36px_rgba(0,0,0,0.22)] transition-luxury duration-500 flex flex-col",
  className
]}>
  <!-- Top Speaker Slit in Bezel -->
  <div class="absolute top-1.5 inset-x-0 flex justify-center z-20 pointer-events-none select-none">
    <div class="w-10 h-[2.5px] bg-[#1C202B] rounded-full"></div>
  </div>

  <!-- Hardware Frame / Screen Container -->
  <div class="relative w-full h-full overflow-hidden rounded-[28px] sm:rounded-[32px] bg-[#0E1117] flex flex-col">
    <!-- Unoccluded Screen -->
    <div class="relative w-full h-full overflow-hidden bg-[#0E1117]">
      <slot />
    </div>

    <!-- Bottom Home Indicator Bar -->
    <div class="absolute bottom-1.5 inset-x-0 flex justify-center z-20 pointer-events-none select-none">
      <div class="w-20 h-[2.5px] bg-white/20 rounded-full"></div>
    </div>
  </div>
</div>
