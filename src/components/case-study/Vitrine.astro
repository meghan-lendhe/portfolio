---
interface Props {
  padded?: boolean;
  class?: string;
}

const { padded = false, class: className = '' } = Astro.props;
---

<div class:list={[
  "w-full overflow-hidden bg-neutral-100/60 border border-neutral-200/80 rounded-xs",
  padded ? "flex items-center justify-center p-6 sm:p-10" : "",
  className
]}>
  <slot />
</div>

