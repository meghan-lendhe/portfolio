---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<!-- Architectural Broadsheet Divider (Cartier Horological Geometric Precision Colophon Notch) -->
<div
  class:list={["w-full my-20 md:my-32 flex items-center justify-center select-none pointer-events-none", className]}
  aria-hidden="true"
>
  <!-- Left Hairline Rule (Optical Taper toward Margins) -->
  <div class="flex-1 h-[1px] bg-gradient-to-r from-transparent via-neutral-300/80 to-neutral-300"></div>

  <!-- Center Cartier Precision Geometric Jewel Notch (100% Vector SVG: Zero Text, Zero Numbers) -->
  <div class="px-8 flex items-center shrink-0">
    <svg class="w-28 h-4 text-neutral-400" viewBox="0 0 112 16" fill="none">
      <!-- Left Swiss Horological Calibration -->
      <line x1="0" y1="8" x2="24" y2="8" stroke="currentColor" stroke-width="0.7" opacity="0.6" />
      <circle cx="32" cy="8" r="0.8" fill="currentColor" opacity="0.7" />
      <line x1="40" y1="5.5" x2="40" y2="10.5" stroke="currentColor" stroke-width="0.75" />
      <line x1="44" y1="8" x2="48" y2="8" stroke="currentColor" stroke-width="0.7" opacity="0.6" />

      <!-- Central Cartier Diamond Jewel (Beveled Rhombus & Amber Topaz Core) -->
      <g transform="translate(56, 8)">
        <!-- Outer Rhombus Frame -->
        <polygon points="0,-6 6,0 0,6 -6,0" stroke="#737373" stroke-width="0.8" fill="#FAF9F5" />
        <!-- Inner Amber Concentric Facet -->
        <polygon points="0,-3.5 3.5,0 0,3.5 -3.5,0" stroke="#D97706" stroke-width="0.65" fill="none" opacity="0.9" />
        <!-- Micro Topaz Core Point -->
        <circle cx="0" cy="0" r="1.0" fill="#B45309" />
      </g>

      <!-- Right Swiss Horological Calibration -->
      <line x1="64" y1="8" x2="68" y2="8" stroke="currentColor" stroke-width="0.7" opacity="0.6" />
      <line x1="72" y1="5.5" x2="72" y2="10.5" stroke="currentColor" stroke-width="0.75" />
      <circle cx="80" cy="8" r="0.8" fill="currentColor" opacity="0.7" />
      <line x1="88" y1="8" x2="112" y2="8" stroke="currentColor" stroke-width="0.7" opacity="0.6" />
    </svg>
  </div>

  <!-- Right Hairline Rule (Optical Taper toward Margins) -->
  <div class="flex-1 h-[1px] bg-gradient-to-l from-transparent via-neutral-300/80 to-neutral-300"></div>
</div>
