---
interface Props {
  theme?: 'light' | 'dark';
}

const { theme = 'light' } = Astro.props;
const isDark = theme === 'dark';
---

<!-- LIVING HISTOLOGICAL FOLIO SUBSTRATE (Desktop Gutters >= 1240px: Quiet Broadsheet Margins) -->
<div class="hidden xl:block fixed inset-0 pointer-events-none select-none -z-10 overflow-hidden" aria-hidden="true">
  <canvas id="gutter-arbor-canvas" class="w-full h-full block"></canvas>
</div>

<script is:inline>
(function() {
  if (window.innerWidth < 1240) return;

  const canvas = document.getElementById('gutter-arbor-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  let width = 0;
  let height = 0;
  let dpr = 1;
  let gutterWidth = 0;
  let contentLeft = 0;
  let contentRight = 0;

  // Parallax and subtle cursor tracking (Zero scroll excitation)
  let scrollY = window.scrollY;
  const mouse = { x: -1000, y: -1000, active: false };

  window.addEventListener('scroll', () => {
    scrollY = window.scrollY;
  }, { passive: true });

  window.addEventListener('pointermove', (e) => {
    mouse.x = e.clientX;
    mouse.y = e.clientY;
    mouse.active = true;
  }, { passive: true });

  window.addEventListener('pointerleave', () => {
    mouse.active = false;
    mouse.x = -1000;
    mouse.y = -1000;
  }, { passive: true });

  // Cubic Bézier calculation
  function getCubicPoint(x0, y0, cp1x, cp1y, cp2x, cp2y, x1, y1, t) {
    const invT = 1 - t;
    const c0 = invT * invT * invT;
    const c1 = 3 * invT * invT * t;
    const c2 = 3 * invT * t * t;
    const c3 = t * t * t;
    return {
      x: c0 * x0 + c1 * cp1x + c2 * cp2x + c3 * x1,
      y: c0 * y0 + c1 * cp1y + c2 * cp2y + c3 * y1
    };
  }

  // Taut biological axon control points with gentle normal-vector bowing
  function getAxonControlPoints(fn, tn, a) {
    const dx = tn.x - fn.x;
    const dy = tn.y - fn.y;
    const d = Math.hypot(dx, dy) || 1;
    const nx = -dy / d;
    const ny = dx / d;

    return {
      cp1x: fn.x + dx * 0.35 + nx * a.bow1,
      cp1y: fn.y + dy * 0.35 + ny * a.bow1,
      cp2x: fn.x + dx * 0.65 + nx * a.bow2,
      cp2y: fn.y + dy * 0.65 + ny * a.bow2
    };
  }

  // 1. Soft Histological Soma & Dendritic Arbor Rendering (Authentic Ramón y Cajal Cytology)
  function drawSoftHistologicalSoma(ctx, x, y, r, angle, excitation, spike, type) {
    ctx.save();
    ctx.translate(x, y);
    ctx.rotate(angle);

    const grad = ctx.createRadialGradient(0, 0, r * 0.15, 0, 0, r * 2.4);

    if (spike > 0.05) {
      grad.addColorStop(0, `rgba(255, 255, 255, ${0.90 * spike})`);
      grad.addColorStop(0.25, `rgba(245, 158, 11, ${0.75 * spike})`);
      grad.addColorStop(0.65, `rgba(13, 148, 136, ${0.45 * spike})`);
      grad.addColorStop(1, 'rgba(13, 148, 136, 0)');
    } else if (excitation > 0.1) {
      grad.addColorStop(0, `rgba(217, 119, 6, ${0.30 + excitation * 0.35})`);
      grad.addColorStop(0.5, `rgba(245, 158, 11, ${0.16 + excitation * 0.25})`);
      grad.addColorStop(1, 'rgba(245, 158, 11, 0)');
    } else {
      // Quiet, serene sepia silver-nitrate tone
      grad.addColorStop(0, 'rgba(130, 118, 106, 0.15)');
      grad.addColorStop(0.6, 'rgba(155, 143, 132, 0.04)');
      grad.addColorStop(1, 'rgba(155, 143, 132, 0)');
    }

    ctx.fillStyle = grad;
    ctx.beginPath();
    if (type === 'pyramidal') {
      ctx.moveTo(0, -r * 1.6);
      ctx.quadraticCurveTo(r * 1.3, r * 0.3, r * 0.9, r * 1.2);
      ctx.quadraticCurveTo(0, r * 1.5, -r * 0.9, r * 1.2);
      ctx.quadraticCurveTo(-r * 1.3, r * 0.3, 0, -r * 1.6);
    } else if (type === 'bipolar') {
      ctx.ellipse(0, 0, r * 0.75, r * 1.6, 0, 0, Math.PI * 2);
    } else {
      ctx.arc(0, 0, r * 1.3, 0, Math.PI * 2);
    }
    ctx.fill();

    // Nucleus
    const nucleusR = Math.max(1.1, r * 0.36);
    ctx.beginPath();
    ctx.arc(0, 0, nucleusR, 0, Math.PI * 2);
    if (spike > 0.05) {
      ctx.fillStyle = `rgba(255, 255, 255, ${0.90 * spike})`;
    } else if (excitation > 0.1) {
      ctx.fillStyle = `rgba(217, 119, 6, ${0.45 + excitation * 0.30})`;
    } else {
      ctx.fillStyle = 'rgba(95, 84, 74, 0.22)';
    }
    ctx.fill();

    // Delicate dendritic arbor with Cajal gemmules (dendritic spines)
    ctx.beginPath();
    if (type === 'pyramidal') {
      // Apical dendritic trunk
      ctx.moveTo(0, -r * 1.2);
      ctx.quadraticCurveTo(r * 0.25, -r * 2.2, 0, -r * 3.4);
      
      // Apical gemmules / dendritic spines
      ctx.moveTo(-0.4, -r * 1.8); ctx.lineTo(-r * 0.65, -r * 1.95);
      ctx.moveTo(0.4, -r * 2.4);  ctx.lineTo(r * 0.65, -r * 2.55);
      ctx.moveTo(-0.4, -r * 2.9); ctx.lineTo(-r * 0.60, -r * 3.05);

      // Terminal apical bifurcation
      ctx.moveTo(0, -r * 3.4);
      ctx.quadraticCurveTo(-r * 0.55, -r * 4.1, -r * 0.95, -r * 4.7);
      ctx.moveTo(0, -r * 3.4);
      ctx.quadraticCurveTo(r * 0.55, -r * 4.1, r * 0.95, -r * 4.7);

      // Basal dendritic skirt
      ctx.moveTo(-r * 0.8, r * 1.0);
      ctx.quadraticCurveTo(-r * 1.5, r * 1.7, -r * 2.3, r * 2.4);
      ctx.moveTo(-r * 1.5, r * 1.7);
      ctx.lineTo(-r * 2.1, r * 1.4);

      ctx.moveTo(r * 0.8, r * 1.0);
      ctx.quadraticCurveTo(r * 1.5, r * 1.7, r * 2.3, r * 2.4);
      ctx.moveTo(r * 1.5, r * 1.7);
      ctx.lineTo(r * 2.1, r * 1.4);
    } else if (type === 'bipolar') {
      ctx.moveTo(0, -r * 1.4);
      ctx.quadraticCurveTo(r * 0.35, -r * 2.4, 0, -r * 3.5);
      ctx.moveTo(-0.4, -r * 2.2); ctx.lineTo(-r * 0.55, -r * 2.35);

      ctx.moveTo(0, r * 1.4);
      ctx.quadraticCurveTo(-r * 0.35, r * 2.4, 0, r * 3.5);
      ctx.moveTo(0.4, r * 2.2); ctx.lineTo(r * 0.55, r * 2.35);
    } else {
      // Stellate / Multipolar radiating arbor
      const branches = 4;
      for (let b = 0; b < branches; b++) {
        const ba = (b * Math.PI * 2) / branches;
        const sx = Math.cos(ba) * r * 0.9;
        const sy = Math.sin(ba) * r * 0.9;
        const mx = Math.cos(ba + 0.25) * r * 2.0;
        const my = Math.sin(ba + 0.25) * r * 2.0;
        const ex = Math.cos(ba - 0.12) * r * 3.1;
        const ey = Math.sin(ba - 0.12) * r * 3.1;
        ctx.moveTo(sx, sy);
        ctx.quadraticCurveTo(mx, my, ex, ey);

        // Micro-twig on branch
        ctx.moveTo(mx, my);
        ctx.lineTo(mx + Math.cos(ba + 0.8) * r * 0.9, my + Math.sin(ba + 0.8) * r * 0.9);
      }
    }

    ctx.strokeStyle = spike > 0.05
      ? `rgba(13, 148, 136, ${0.45 + spike * 0.4})`
      : (excitation > 0.1 ? `rgba(217, 119, 6, ${0.20 + excitation * 0.35})` : 'rgba(145, 135, 125, 0.10)');
    ctx.lineWidth = 0.55;
    ctx.stroke();

    ctx.restore();
  }

  // 2. Histological Network Generator (Isolated Micro-Plexus Islands with Generous Breathing Room)
  const leftMesh = { neurons: [], axons: [], terminalBranches: [], pulses: [], nextPulse: 0 };
  const rightMesh = { neurons: [], axons: [], terminalBranches: [], pulses: [], nextPulse: 0 };

  function buildGutterNetwork(side, gutterW, contentBoundX, totalDocHeight) {
    const isLeft = side === 'left';
    const neurons = [];
    const axons = [];
    const terminalBranches = [];
    const pulses = [];

    const innerPadding = 24;
    const outerPadding = 20;
    const minX = isLeft ? outerPadding : contentBoundX + innerPadding;
    const maxX = isLeft ? contentBoundX - innerPadding : width - outerPadding;
    const channelW = Math.max(30, maxX - minX);

    // Balanced organic spacing between constellations: 115px to 190px
    let currentY = 120 + Math.random() * 60;
    let neuronId = 0;
    const clusters = [];

    // Distinct architectural archetypes for rich morphological variety
    const archetypePool = [
      'horizontal_bridge',   // 2 cells bridging sideways across the channel
      'triangular_triad',    // 3 cells forming a 2D triangular polygon
      'pyramidal_satellite', // 1 dominant pyramidal cell with satellite interneuron
      'vertical_tandem',     // 2 slender cells aligned vertically
      'solitary_specimen'    // 1 iconic solitary neuron with full dendritic arbor
    ];

    while (currentY < totalDocHeight - 120) {
      // Pick archetype with weighted variety
      const roll = Math.random();
      const archetype = roll < 0.26 ? 'horizontal_bridge' :
                        roll < 0.52 ? 'triangular_triad' :
                        roll < 0.74 ? 'pyramidal_satellite' :
                        roll < 0.88 ? 'vertical_tandem' : 'solitary_specimen';

      const clusterNeurons = [];
      const clusterAxonsToCreate = [];

      // Randomized horizontal anchor across the breadth of the gutter channel
      const clusterCenterX = minX + (0.18 + Math.random() * 0.64) * channelW;

      if (archetype === 'horizontal_bridge') {
        // Archetype 1: Wide horizontal bridge (2 cells across channel)
        const spread = 22 + Math.random() * 24;
        const x1 = Math.max(minX + 8, Math.min(maxX - 8, clusterCenterX - spread));
        const x2 = Math.max(minX + 8, Math.min(maxX - 8, clusterCenterX + spread));
        const y1 = currentY + (Math.random() - 0.5) * 12;
        const y2 = currentY + 14 + (Math.random() - 0.5) * 14;

        const n1 = makeNeuron(x1, y1, 'stellate', 3.8, isLeft ? -Math.PI * 0.45 : -Math.PI * 0.55);
        const n2 = makeNeuron(x2, y2, 'pyramidal', 4.6, isLeft ? -Math.PI * 0.50 : -Math.PI * 0.50);
        clusterNeurons.push(n1, n2);
        clusterAxonsToCreate.push([n1, n2, false]);

      } else if (archetype === 'triangular_triad') {
        // Archetype 2: 2D Triangular Triad (3 cells forming an organic triangle)
        const apexX = Math.max(minX + 8, Math.min(maxX - 8, clusterCenterX + (Math.random() - 0.5) * 16));
        const apexY = currentY;

        const leftSpread = 20 + Math.random() * 20;
        const rightSpread = 20 + Math.random() * 20;
        const leftX = Math.max(minX + 8, Math.min(maxX - 8, clusterCenterX - leftSpread));
        const rightX = Math.max(minX + 8, Math.min(maxX - 8, clusterCenterX + rightSpread));
        const baseY = currentY + 38 + Math.random() * 16;
        const leftY = baseY + (Math.random() - 0.5) * 12;
        const rightY = baseY + 6 + (Math.random() - 0.5) * 12;

        const apexN = makeNeuron(apexX, apexY, 'pyramidal', 4.8, isLeft ? -Math.PI * 0.48 : -Math.PI * 0.52);
        const leftN = makeNeuron(leftX, leftY, 'stellate', 3.6, -Math.PI * 0.5);
        const rightN = makeNeuron(rightX, rightY, 'bipolar', 3.2, -Math.PI * 0.5);

        clusterNeurons.push(apexN, leftN, rightN);
        clusterAxonsToCreate.push([apexN, leftN, false]);
        clusterAxonsToCreate.push([apexN, rightN, false]);
        if (Math.random() < 0.35) {
          clusterAxonsToCreate.push([leftN, rightN, true]);
        }

      } else if (archetype === 'pyramidal_satellite') {
        // Archetype 3: Monumental Pyramidal Cell + Small Basal Satellite Interneuron
        const pyrX = Math.max(minX + 8, Math.min(maxX - 8, clusterCenterX));
        const pyrY = currentY;

        const offsetDir = Math.random() > 0.5 ? 1 : -1;
        const satX = Math.max(minX + 8, Math.min(maxX - 8, pyrX + offsetDir * (22 + Math.random() * 16)));
        const satY = pyrY + 32 + Math.random() * 14;

        const pyrN = makeNeuron(pyrX, pyrY, 'pyramidal', 5.2, isLeft ? -Math.PI * 0.48 : -Math.PI * 0.52);
        const satN = makeNeuron(satX, satY, 'stellate', 3.0, -Math.PI * 0.5);

        clusterNeurons.push(pyrN, satN);
        clusterAxonsToCreate.push([pyrN, satN, false]);

      } else if (archetype === 'vertical_tandem') {
        // Archetype 4: Slender Vertical Tandem (2 vertically aligned cells)
        const x1 = Math.max(minX + 8, Math.min(maxX - 8, clusterCenterX + (Math.random() - 0.5) * 10));
        const y1 = currentY;
        const x2 = Math.max(minX + 8, Math.min(maxX - 8, clusterCenterX + (Math.random() - 0.5) * 14));
        const y2 = currentY + 46 + Math.random() * 16;

        const n1 = makeNeuron(x1, y1, 'bipolar', 3.4, isLeft ? -Math.PI * 0.46 : -Math.PI * 0.54);
        const n2 = makeNeuron(x2, y2, 'pyramidal', 4.4, isLeft ? -Math.PI * 0.48 : -Math.PI * 0.52);

        clusterNeurons.push(n1, n2);
        clusterAxonsToCreate.push([n1, n2, false]);

      } else {
        // Archetype 5: Solitary Iconic Specimen (single large neuron with maximum breathing room)
        const x = Math.max(minX + 8, Math.min(maxX - 8, clusterCenterX));
        const y = currentY;
        const type = Math.random() < 0.65 ? 'pyramidal' : 'stellate';
        const n = makeNeuron(x, y, type, 5.0, isLeft ? -Math.PI * 0.48 : -Math.PI * 0.52);
        clusterNeurons.push(n);
      }

      function makeNeuron(docX, docY, type, radius, angle) {
        return {
          id: `${side}-${neuronId++}`,
          clusterIndex: clusters.length,
          type: type,
          side: side,
          docX: docX,
          docY: docY,
          x: docX,
          y: docY,
          angle: angle,
          driftPhase: Math.random() * Math.PI * 2,
          driftSpeed: 0.00025 + Math.random() * 0.00035,
          driftRadius: 1.2 + Math.random() * 1.6,
          radius: radius,
          potential: 0.0,
          spikeEnergy: 0.0,
          refractory: 0
        };
      }

      if (clusterNeurons.length > 0) {
        clusterNeurons.forEach(n => neurons.push(n));
        clusters.push({ neurons: clusterNeurons, archetype: archetype, axonsToCreate: clusterAxonsToCreate });

        // Calculate actual vertical footprint of this specific cluster
        const minY = Math.min(...clusterNeurons.map(n => n.docY));
        const maxY = Math.max(...clusterNeurons.map(n => n.docY));
        const clusterSpan = Math.max(20, maxY - minY);

        // Organic negative space to next cluster: 115px to 190px of serene porcelain
        currentY += clusterSpan + 115 + Math.random() * 75;
      } else {
        currentY += 140;
      }
    }

    function createAxon(from, to, isCollateral = false) {
      const dx = to.docX - from.docX;
      const dy = to.docY - from.docY;
      const d = Math.hypot(dx, dy) || 1;
      const sign = Math.random() > 0.5 ? 1 : -1;
      
      // Taut, delicate biological normal-vector bowing
      const bow = sign * (3.5 + Math.random() * Math.min(d * 0.07, 5.0));
      const bow1 = bow;
      const bow2 = bow * (0.85 + (Math.random() - 0.5) * 0.2);

      const boutons = [];
      const numBoutons = 1 + Math.floor(Math.random() * 2);
      for (let b = 0; b < numBoutons; b++) {
        boutons.push({
          t: 0.30 + Math.random() * 0.40,
          radius: 1.1 + Math.random() * 0.25
        });
      }

      axons.push({
        id: `ax-${from.id}-${to.id}`,
        fromId: from.id,
        toId: to.id,
        bow1: bow1,
        bow2: bow2,
        boutons: boutons,
        isCollateral: isCollateral
      });
    }

    function createTerminalBranch(neuron) {
      const angle = (neuron.angle + Math.PI + (Math.random() - 0.5) * 0.7);
      const len = 24 + Math.random() * 18;
      
      const dx1 = Math.cos(angle) * (len * 0.55);
      const dy1 = Math.sin(angle) * (len * 0.55);
      const dx2 = Math.cos(angle + (Math.random() - 0.5) * 0.3) * len;
      const dy2 = Math.sin(angle + (Math.random() - 0.5) * 0.3) * len;

      terminalBranches.push({
        neuronId: neuron.id,
        dx1: dx1,
        dy1: dy1,
        dx2: dx2,
        dy2: dy2,
        twigs: [
          {
            dx: dx2 + Math.cos(angle - 0.45) * 7.5,
            dy: dy2 + Math.sin(angle - 0.45) * 7.5,
            boutonR: 1.15
          },
          {
            dx: dx2 + Math.cos(angle + 0.45) * 7.5,
            dy: dy2 + Math.sin(angle + 0.45) * 7.5,
            boutonR: 1.15
          }
        ]
      });
    }

    // Connect neurons strictly according to each cluster's architectural archetype
    // Zero inter-cluster connections: clusters remain autonomous, floating specimen islands
    clusters.forEach((cl) => {
      cl.axonsToCreate.forEach(([from, to, isCollateral]) => {
        createAxon(from, to, isCollateral);
      });

      // 1 free-ending terminal branch bouquet per cluster
      if (cl.neurons.length > 0) {
        createTerminalBranch(cl.neurons[0]);
      }
    });

    return {
      neurons,
      axons,
      terminalBranches,
      pulses,
      nextPulse: performance.now() + 4000 + Math.random() * 4000
    };
  }

  let cachedDocHeight = 0;

  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    width = window.innerWidth;
    height = window.innerHeight;
    canvas.width = width * dpr;
    canvas.height = height * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    const contentMaxW = Math.min(width, 1120);
    gutterWidth = Math.max(60, (width - contentMaxW) / 2);
    contentLeft = (width - contentMaxW) / 2;
    contentRight = width - contentLeft;

    if (gutterWidth >= 70) {
      cachedDocHeight = Math.max(
        document.documentElement.scrollHeight,
        document.body.scrollHeight,
        height * 2
      );

      const leftNet = buildGutterNetwork('left', gutterWidth, contentLeft, cachedDocHeight);
      leftMesh.neurons = leftNet.neurons;
      leftMesh.axons = leftNet.axons;
      leftMesh.terminalBranches = leftNet.terminalBranches;
      leftMesh.pulses = leftNet.pulses;
      leftMesh.nextPulse = leftNet.nextPulse;

      const rightNet = buildGutterNetwork('right', gutterWidth, contentRight, cachedDocHeight);
      rightMesh.neurons = rightNet.neurons;
      rightMesh.axons = rightNet.axons;
      rightMesh.terminalBranches = rightNet.terminalBranches;
      rightMesh.pulses = rightNet.pulses;
      rightMesh.nextPulse = rightNet.nextPulse + 2500;
    } else {
      leftMesh.neurons.length = 0;
      leftMesh.axons.length = 0;
      leftMesh.terminalBranches.length = 0;
      rightMesh.neurons.length = 0;
      rightMesh.axons.length = 0;
      rightMesh.terminalBranches.length = 0;
    }
  }

  // Trigger Sinuous Action Potential Wave
  function triggerGutterWave(mesh, axon) {
    if (!axon) return;
    mesh.pulses.push({
      fromId: axon.fromId,
      toId: axon.toId,
      axon: axon,
      progress: 0.0,
      speed: 0.020 + Math.random() * 0.008,
      energy: 0.85
    });
  }

  window.addEventListener('resize', resize, { passive: true });
  window.addEventListener('load', () => {
    const curH = Math.max(document.documentElement.scrollHeight, document.body.scrollHeight, height * 2);
    if (Math.abs(curH - cachedDocHeight) > 180) {
      resize();
    }
  }, { passive: true });

  resize();

  let time = 0;

  // Render loop
  function render(now) {
    ctx.clearRect(0, 0, width, height);

    time += 0.005;
    const currentScrollY = window.scrollY;

    if (gutterWidth >= 70) {
      // 1. Index Hero Suppression: Zero gutter arbor in index hero
      const heroEl = document.getElementById('hero') || document.getElementById('synaptic-field');
      let heroFade = 1.0;

      if (heroEl) {
        const heroRect = heroEl.getBoundingClientRect();
        if (heroRect.bottom > 0) {
          heroFade = 0;
        } else {
          // Smooth fade in once past the hero
          heroFade = Math.max(0, Math.min(1.0, -heroRect.bottom / 200));
        }
      }

      // If in index hero, suppress completely
      if (heroFade <= 0.001) {
        requestAnimationFrame(render);
        return;
      }

      ctx.save();
      ctx.globalAlpha = heroFade;

      // Render Left and Right Histological Meshes
      [leftMesh, rightMesh].forEach(mesh => {
        if (!mesh.neurons.length) return;

        const visibleNeuronMap = new Map();

        for (let i = 0; i < mesh.neurons.length; i++) {
          const n = mesh.neurons[i];
          n.driftPhase += n.driftSpeed;
          const driftX = Math.cos(n.driftPhase) * n.driftRadius;
          const driftY = Math.sin(n.driftPhase) * n.driftRadius;

          n.x = n.docX + driftX;
          n.y = n.docY - currentScrollY + driftY;

          // Culling window [-120, height + 120]
          if (n.y >= -120 && n.y <= height + 120) {
            visibleNeuronMap.set(n.id, n);

            // Subtle cursor proximity (local membrane depolarization only when nearby)
            if (mouse.active) {
              const dist = Math.hypot(mouse.x - n.x, mouse.y - n.y);
              if (dist < 110) {
                const stimulus = Math.pow(1 - dist / 110, 2) * 0.02;
                n.potential = Math.min(1.0, n.potential + stimulus);
                if (dist < 42 && n.refractory <= 0) {
                  const connectedAxon = mesh.axons.find(a => a.fromId === n.id || a.toId === n.id);
                  if (connectedAxon) {
                    triggerGutterWave(mesh, connectedAxon);
                  }
                  n.refractory = 240;
                }
              }
            }

            if (n.refractory > 0) n.refractory--;
            n.potential *= 0.985;
            if (n.spikeEnergy > 0) n.spikeEnergy *= 0.90;
          }
        }

        // Spontaneous Calm Conduction Wave (Infrequent: every 6 to 12 seconds)
        if (now > mesh.nextPulse) {
          const visibleAxons = [];
          for (let a = 0; a < mesh.axons.length; a++) {
            const ax = mesh.axons[a];
            const fn = visibleNeuronMap.get(ax.fromId);
            const tn = visibleNeuronMap.get(ax.toId);
            if (fn && tn && fn.y >= -20 && fn.y <= height + 20) {
              visibleAxons.push(ax);
            }
          }
          if (visibleAxons.length > 0) {
            const randomAxon = visibleAxons[Math.floor(Math.random() * visibleAxons.length)];
            triggerGutterWave(mesh, randomAxon);
          }
          mesh.nextPulse = now + 6500 + Math.random() * 6500;
        }

        // A. Render Taut Curvilinear Axons
        mesh.axons.forEach(a => {
          const fn = visibleNeuronMap.get(a.fromId);
          const tn = visibleNeuronMap.get(a.toId);
          if (!fn || !tn) return;

          const cp = getAxonControlPoints(fn, tn, a);
          a.cp = cp;

          const activeCharge = Math.max(fn.potential, tn.potential);

          ctx.beginPath();
          ctx.moveTo(fn.x, fn.y);
          ctx.bezierCurveTo(cp.cp1x, cp.cp1y, cp.cp2x, cp.cp2y, tn.x, tn.y);

          // Quiet resting ink stroke
          if (activeCharge > 0.15) {
            ctx.strokeStyle = `rgba(217, 119, 6, ${0.14 + activeCharge * 0.35})`;
            ctx.lineWidth = 0.8 + activeCharge * 0.3;
          } else {
            ctx.strokeStyle = a.isCollateral ? 'rgba(155, 145, 135, 0.08)' : 'rgba(145, 135, 125, 0.12)';
            ctx.lineWidth = a.isCollateral ? 0.50 : 0.65;
          }
          ctx.stroke();

          // Render micro synaptic boutons along axon
          for (let b = 0; b < a.boutons.length; b++) {
            const bt = a.boutons[b].t;
            const bPt = getCubicPoint(fn.x, fn.y, cp.cp1x, cp.cp1y, cp.cp2x, cp.cp2y, tn.x, tn.y, bt);

            let boutonPulse = 0;
            for (let p = 0; p < mesh.pulses.length; p++) {
              const pulse = mesh.pulses[p];
              if (pulse.axon === a) {
                const distToBouton = Math.abs(pulse.progress - bt);
                if (distToBouton < 0.16) {
                  boutonPulse = Math.max(boutonPulse, (1 - distToBouton / 0.16) * pulse.energy);
                }
              }
            }

            ctx.beginPath();
            ctx.arc(bPt.x, bPt.y, a.boutons[b].radius, 0, Math.PI * 2);

            if (boutonPulse > 0.05) {
              ctx.fillStyle = `rgba(13, 148, 136, ${0.30 + boutonPulse * 0.55})`;
            } else if (activeCharge > 0.15) {
              ctx.fillStyle = `rgba(217, 119, 6, ${0.22 + activeCharge * 0.35})`;
            } else {
              ctx.fillStyle = 'rgba(150, 140, 130, 0.13)';
            }
            ctx.fill();
          }
        });

        // B. Render Free-Ending Terminal Axonal Arborizations
        mesh.terminalBranches.forEach(tb => {
          const fn = visibleNeuronMap.get(tb.neuronId);
          if (!fn) return;

          const tipX = fn.x + tb.dx2;
          const tipY = fn.y + tb.dy2;
          const midX = fn.x + tb.dx1;
          const midY = fn.y + tb.dy1;

          ctx.beginPath();
          ctx.moveTo(fn.x, fn.y);
          ctx.quadraticCurveTo(midX, midY, tipX, tipY);

          if (fn.potential > 0.15) {
            ctx.strokeStyle = `rgba(217, 119, 6, ${0.14 + fn.potential * 0.30})`;
            ctx.lineWidth = 0.75;
          } else {
            ctx.strokeStyle = 'rgba(155, 145, 135, 0.09)';
            ctx.lineWidth = 0.52;
          }
          ctx.stroke();

          // Terminal Twigs and Boutons
          tb.twigs.forEach(tw => {
            const bx = fn.x + tw.dx;
            const by = fn.y + tw.dy;

            ctx.beginPath();
            ctx.moveTo(tipX, tipY);
            ctx.lineTo(bx, by);
            ctx.strokeStyle = fn.potential > 0.15
              ? `rgba(217, 119, 6, ${0.16 + fn.potential * 0.25})`
              : 'rgba(155, 145, 135, 0.09)';
            ctx.lineWidth = 0.46;
            ctx.stroke();

            ctx.beginPath();
            ctx.arc(bx, by, tw.boutonR, 0, Math.PI * 2);
            if (fn.spikeEnergy > 0.1) {
              ctx.fillStyle = `rgba(13, 148, 136, ${0.35 + fn.spikeEnergy * 0.5})`;
            } else if (fn.potential > 0.15) {
              ctx.fillStyle = `rgba(217, 119, 6, ${0.22 + fn.potential * 0.30})`;
            } else {
              ctx.fillStyle = 'rgba(150, 140, 130, 0.13)';
            }
            ctx.fill();
          });
        });

        // C. Render Somas & Dendritic Spines
        visibleNeuronMap.forEach(n => {
          if (n.y < -80 || n.y > height + 80) return;
          drawSoftHistologicalSoma(ctx, n.x, n.y, n.radius, n.angle, n.potential, n.spikeEnergy, n.type);
        });

        // D. Render Traveling Axonal Conduction Waves (Serene, Tapered Emerald Wave)
        for (let p = mesh.pulses.length - 1; p >= 0; p--) {
          const pulse = mesh.pulses[p];
          pulse.progress += pulse.speed;

          const fn = visibleNeuronMap.get(pulse.fromId);
          const tn = visibleNeuronMap.get(pulse.toId);
          const cp = pulse.axon.cp;

          if (!fn || !tn || !cp) {
            mesh.pulses.splice(p, 1);
            continue;
          }

          const waveLen = 0.30;
          const headT = Math.min(1.0, pulse.progress);
          const tailT = Math.max(0.0, pulse.progress - waveLen);

          if (headT > tailT) {
            const steps = 12;
            let prev = null;
            for (let s = 0; s <= steps; s++) {
              const fraction = s / steps;
              const t = tailT + (headT - tailT) * fraction;
              const pt = getCubicPoint(fn.x, fn.y, cp.cp1x, cp.cp1y, cp.cp2x, cp.cp2y, tn.x, tn.y, t);

              if (prev) {
                const segAlpha = Math.pow(fraction, 1.5) * 0.75 * pulse.energy;
                ctx.beginPath();
                ctx.moveTo(prev.x, prev.y);
                ctx.lineTo(pt.x, pt.y);
                ctx.strokeStyle = `rgba(13, 148, 136, ${segAlpha})`;
                ctx.lineWidth = 0.70 + fraction * 0.70;
                ctx.stroke();
              }
              prev = pt;
            }
          }

          if (pulse.progress >= 1.0) {
            const target = visibleNeuronMap.get(pulse.toId);
            if (target) {
              target.potential = Math.min(1.0, target.potential + 0.35 * pulse.energy);
              target.spikeEnergy = 0.60 * pulse.energy;
            }
            mesh.pulses.splice(p, 1);
          }
        }
      });

      ctx.restore();
    }

    requestAnimationFrame(render);
  }

  requestAnimationFrame(render);
})();
</script>
