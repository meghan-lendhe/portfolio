---
interface Props {
  theme?: 'light' | 'dark';
}

const { theme = 'light' } = Astro.props;
const isDark = theme === 'dark';
---

<!-- LIVING HISTOLOGICAL FOLIO SUBSTRATE (Desktop Gutters >= 1240px — Unified with Hero Cytology) -->
<div class="hidden xl:block fixed inset-0 pointer-events-none select-none -z-10 overflow-hidden" aria-hidden="true">
  <canvas id="gutter-arbor-canvas" class="w-full h-full block"></canvas>
</div>

<script is:inline>
(function() {
  if (window.innerWidth < 1240) return;

  const canvas = document.getElementById('gutter-arbor-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  let width = 0;
  let height = 0;
  let dpr = 1;
  let gutterWidth = 0;
  let contentLeft = 0;
  let contentRight = 0;

  // Parallax and cursor tracking
  let scrollY = window.scrollY;
  let targetScrollY = window.scrollY;
  const mouse = { x: -1000, y: -1000, active: false };

  window.addEventListener('scroll', () => {
    targetScrollY = window.scrollY;
  }, { passive: true });

  window.addEventListener('pointermove', (e) => {
    mouse.x = e.clientX;
    mouse.y = e.clientY;
    mouse.active = true;
  }, { passive: true });

  window.addEventListener('pointerleave', () => {
    mouse.active = false;
    mouse.x = -1000;
    mouse.y = -1000;
  }, { passive: true });

  // Cubic Bézier calculation (Exact same formula as hero)
  function getCubicPoint(x0, y0, cp1x, cp1y, cp2x, cp2y, x1, y1, t) {
    const invT = 1 - t;
    const c0 = invT * invT * invT;
    const c1 = 3 * invT * invT * t;
    const c2 = 3 * invT * t * t;
    const c3 = t * t * t;
    return {
      x: c0 * x0 + c1 * cp1x + c2 * cp2x + c3 * x1,
      y: c0 * y0 + c1 * cp1y + c2 * cp2y + c3 * y1
    };
  }

  // Taut biological axon control points with gentle normal-vector bowing (Never opposing S-curves)
  function getAxonControlPoints(fn, tn, a) {
    const dx = tn.x - fn.x;
    const dy = tn.y - fn.y;
    const d = Math.hypot(dx, dy) || 1;
    const nx = -dy / d;
    const ny = dx / d;

    return {
      cp1x: fn.x + dx * 0.35 + nx * a.bow1,
      cp1y: fn.y + dy * 0.35 + ny * a.bow1,
      cp2x: fn.x + dx * 0.65 + nx * a.bow2,
      cp2y: fn.y + dy * 0.65 + ny * a.bow2
    };
  }

  // 1. Soft Histological Soma & Dendritic Arbor Rendering (Authentic Ramón y Cajal Cytology)
  function drawSoftHistologicalSoma(ctx, x, y, r, angle, excitation, spike, type) {
    ctx.save();
    ctx.translate(x, y);
    ctx.rotate(angle);

    const grad = ctx.createRadialGradient(0, 0, r * 0.15, 0, 0, r * 2.4);

    if (spike > 0.05) {
      grad.addColorStop(0, `rgba(255, 255, 255, ${0.95 * spike})`);
      grad.addColorStop(0.25, `rgba(245, 158, 11, ${0.85 * spike})`);
      grad.addColorStop(0.65, `rgba(13, 148, 136, ${0.45 * spike})`);
      grad.addColorStop(1, 'rgba(13, 148, 136, 0)');
    } else if (excitation > 0.1) {
      grad.addColorStop(0, `rgba(217, 119, 6, ${0.35 + excitation * 0.45})`);
      grad.addColorStop(0.5, `rgba(245, 158, 11, ${0.18 + excitation * 0.3})`);
      grad.addColorStop(1, 'rgba(245, 158, 11, 0)');
    } else {
      // Resting cytology (matched to index hero)
      grad.addColorStop(0, 'rgba(130, 120, 110, 0.11)');
      grad.addColorStop(0.6, 'rgba(175, 165, 155, 0.035)');
      grad.addColorStop(1, 'rgba(175, 165, 155, 0)');
    }

    ctx.fillStyle = grad;
    ctx.beginPath();
    if (type === 'pyramidal') {
      ctx.moveTo(0, -r * 1.6);
      ctx.quadraticCurveTo(r * 1.3, r * 0.3, r * 0.9, r * 1.2);
      ctx.quadraticCurveTo(0, r * 1.5, -r * 0.9, r * 1.2);
      ctx.quadraticCurveTo(-r * 1.3, r * 0.3, 0, -r * 1.6);
    } else if (type === 'bipolar') {
      ctx.ellipse(0, 0, r * 0.75, r * 1.6, 0, 0, Math.PI * 2);
    } else {
      ctx.arc(0, 0, r * 1.3, 0, Math.PI * 2);
    }
    ctx.fill();

    // Nucleus
    const nucleusR = Math.max(1.1, r * 0.36);
    ctx.beginPath();
    ctx.arc(0, 0, nucleusR, 0, Math.PI * 2);
    if (spike > 0.05) {
      ctx.fillStyle = `rgba(255, 255, 255, ${0.95 * spike})`;
    } else if (excitation > 0.1) {
      ctx.fillStyle = `rgba(217, 119, 6, ${0.5 + excitation * 0.35})`;
    } else {
      ctx.fillStyle = 'rgba(110, 100, 92, 0.15)';
    }
    ctx.fill();

    // Delicate dendritic arbor with Cajal gemmules (dendritic spines)
    ctx.beginPath();
    if (type === 'pyramidal') {
      // Apical dendritic trunk
      ctx.moveTo(0, -r * 1.2);
      ctx.quadraticCurveTo(r * 0.25, -r * 2.2, 0, -r * 3.4);
      
      // Apical gemmules / dendritic spines (micro-spines along shaft)
      ctx.moveTo(-0.4, -r * 1.8); ctx.lineTo(-r * 0.65, -r * 1.95);
      ctx.moveTo(0.4, -r * 2.4);  ctx.lineTo(r * 0.65, -r * 2.55);
      ctx.moveTo(-0.4, -r * 2.9); ctx.lineTo(-r * 0.60, -r * 3.05);

      // Terminal apical bifurcation
      ctx.moveTo(0, -r * 3.4);
      ctx.quadraticCurveTo(-r * 0.55, -r * 4.1, -r * 0.95, -r * 4.7);
      ctx.moveTo(0, -r * 3.4);
      ctx.quadraticCurveTo(r * 0.55, -r * 4.1, r * 0.95, -r * 4.7);

      // Basal dendritic skirt
      ctx.moveTo(-r * 0.8, r * 1.0);
      ctx.quadraticCurveTo(-r * 1.5, r * 1.7, -r * 2.3, r * 2.4);
      ctx.moveTo(-r * 1.5, r * 1.7);
      ctx.lineTo(-r * 2.1, r * 1.4);

      ctx.moveTo(r * 0.8, r * 1.0);
      ctx.quadraticCurveTo(r * 1.5, r * 1.7, r * 2.3, r * 2.4);
      ctx.moveTo(r * 1.5, r * 1.7);
      ctx.lineTo(r * 2.1, r * 1.4);
    } else if (type === 'bipolar') {
      // Superior and inferior poles with fine spines
      ctx.moveTo(0, -r * 1.4);
      ctx.quadraticCurveTo(r * 0.35, -r * 2.4, 0, -r * 3.5);
      ctx.moveTo(-0.4, -r * 2.2); ctx.lineTo(-r * 0.55, -r * 2.35);

      ctx.moveTo(0, r * 1.4);
      ctx.quadraticCurveTo(-r * 0.35, r * 2.4, 0, r * 3.5);
      ctx.moveTo(0.4, r * 2.2); ctx.lineTo(r * 0.55, r * 2.35);
    } else {
      // Stellate / Multipolar radiating arbor
      const branches = 4;
      for (let b = 0; b < branches; b++) {
        const ba = (b * Math.PI * 2) / branches;
        const sx = Math.cos(ba) * r * 0.9;
        const sy = Math.sin(ba) * r * 0.9;
        const mx = Math.cos(ba + 0.25) * r * 2.0;
        const my = Math.sin(ba + 0.25) * r * 2.0;
        const ex = Math.cos(ba - 0.12) * r * 3.1;
        const ey = Math.sin(ba - 0.12) * r * 3.1;
        ctx.moveTo(sx, sy);
        ctx.quadraticCurveTo(mx, my, ex, ey);

        // Micro-twig on branch
        ctx.moveTo(mx, my);
        ctx.lineTo(mx + Math.cos(ba + 0.8) * r * 0.9, my + Math.sin(ba + 0.8) * r * 0.9);
      }
    }

    ctx.strokeStyle = spike > 0.05
      ? `rgba(13, 148, 136, ${0.45 + spike * 0.4})`
      : (excitation > 0.1 ? `rgba(217, 119, 6, ${0.18 + excitation * 0.4})` : 'rgba(165, 155, 145, 0.06)');
    ctx.lineWidth = 0.55;
    ctx.stroke();

    ctx.restore();
  }

  // 2. Histological Constellation Generator for Side Gutters (Micro-Plexuses with Breathing Room)
  const leftMesh = { neurons: [], axons: [], terminalBranches: [], pulses: [], nextPulse: 0 };
  const rightMesh = { neurons: [], axons: [], terminalBranches: [], pulses: [], nextPulse: 0 };
  const gutterSparks = [];

  function buildGutterNetwork(side, gutterW, contentBoundX, totalDocHeight) {
    const isLeft = side === 'left';
    const neurons = [];
    const axons = [];
    const terminalBranches = [];
    const pulses = [];

    const innerPadding = 26;
    const outerPadding = 22;
    const minX = isLeft ? outerPadding : contentBoundX + innerPadding;
    const maxX = isLeft ? contentBoundX - innerPadding : width - outerPadding;
    const channelW = Math.max(30, maxX - minX);

    // Spacing between histological micro-plexuses (clusters)
    // Generous breathing room of 180-280px between constellations
    let currentY = 130 + Math.random() * 50;
    let neuronId = 0;
    const clusters = [];

    while (currentY < totalDocHeight - 160) {
      // 2 or 3 neurons per constellation
      const clusterSize = Math.random() < 0.65 ? 2 : 3;
      const clusterNeurons = [];

      // Center X of constellation
      const clusterCenterX = minX + (0.22 + Math.random() * 0.56) * channelW;

      for (let k = 0; k < clusterSize; k++) {
        // Taut vertical offset: 38-68px between sibling cells within the cluster
        const docY = currentY + k * (42 + Math.random() * 26) + (Math.random() - 0.5) * 14;
        if (docY >= totalDocHeight - 80) break;

        // Clustered organic horizontal placement
        const docX = Math.max(minX + 6, Math.min(maxX - 6, clusterCenterX + (Math.random() - 0.5) * 32));

        const rand = Math.random();
        const type = rand < 0.50 ? 'pyramidal' : (rand < 0.82 ? 'stellate' : 'bipolar');

        let angle = -Math.PI * 0.5 + (Math.random() - 0.5) * 0.45;
        if (type === 'pyramidal') {
          angle = isLeft ? -Math.PI * 0.48 : -Math.PI * 0.52;
        }

        const neuron = {
          id: `${side}-${neuronId++}`,
          clusterIndex: clusters.length,
          type: type,
          side: side,
          docX: docX,
          docY: docY,
          x: docX,
          y: docY,
          angle: angle,
          driftPhase: Math.random() * Math.PI * 2,
          driftSpeed: 0.00025 + Math.random() * 0.00035,
          driftRadius: 1.2 + Math.random() * 1.8,
          radius: type === 'pyramidal' ? 4.4 : (type === 'stellate' ? 3.5 : 2.9),
          potential: 0.0,
          spikeEnergy: 0.0,
          refractory: 0
        };

        neurons.push(neuron);
        clusterNeurons.push(neuron);
      }

      if (clusterNeurons.length > 0) {
        clusters.push(clusterNeurons);
      }

      // Natural histological breathing room before the next cluster: 180-280px
      currentY += (clusterSize * 48) + 180 + Math.random() * 100;
    }

    function createAxon(from, to, isCollateral = false) {
      const dx = to.docX - from.docX;
      const dy = to.docY - from.docY;
      const d = Math.hypot(dx, dy) || 1;
      const sign = Math.random() > 0.5 ? 1 : -1;
      
      // Taut, delicate biological bow along the perpendicular normal vector:
      // only 3.5 to 7.5px deflection! (Never wild 35px S-curves)
      const bow = sign * (3.5 + Math.random() * Math.min(d * 0.07, 5.0));
      const bow1 = bow;
      const bow2 = bow * (0.85 + (Math.random() - 0.5) * 0.2); // SAME SIGN!

      const boutons = [];
      const numBoutons = 1 + Math.floor(Math.random() * 2);
      for (let b = 0; b < numBoutons; b++) {
        boutons.push({
          t: 0.30 + Math.random() * 0.40,
          radius: 1.05 + Math.random() * 0.35
        });
      }

      axons.push({
        id: `ax-${from.id}-${to.id}`,
        fromId: from.id,
        toId: to.id,
        bow1: bow1,
        bow2: bow2,
        boutons: boutons,
        isCollateral: isCollateral
      });
    }

    function createTerminalBranch(neuron) {
      // Radiating terminal branch ending in synaptic bouton bouquet
      const angle = (neuron.angle + Math.PI + (Math.random() - 0.5) * 0.7);
      const len = 24 + Math.random() * 20;
      
      const dx1 = Math.cos(angle) * (len * 0.55);
      const dy1 = Math.sin(angle) * (len * 0.55);
      const dx2 = Math.cos(angle + (Math.random() - 0.5) * 0.3) * len;
      const dy2 = Math.sin(angle + (Math.random() - 0.5) * 0.3) * len;

      terminalBranches.push({
        neuronId: neuron.id,
        dx1: dx1,
        dy1: dy1,
        dx2: dx2,
        dy2: dy2,
        twigs: [
          {
            dx: dx2 + Math.cos(angle - 0.45) * 7.5,
            dy: dy2 + Math.sin(angle - 0.45) * 7.5,
            boutonR: 1.15
          },
          {
            dx: dx2 + Math.cos(angle + 0.45) * 7.5,
            dy: dy2 + Math.sin(angle + 0.45) * 7.5,
            boutonR: 1.15
          }
        ]
      });
    }

    // Connect neurons strictly within each micro-plexus, with occasional inter-cluster bridge
    clusters.forEach((cl, clIdx) => {
      if (cl.length === 2) {
        createAxon(cl[0], cl[1], false);
      } else if (cl.length >= 3) {
        createAxon(cl[0], cl[1], false);
        createAxon(cl[1], cl[2], false);
        if (Math.random() < 0.35) {
          createAxon(cl[0], cl[2], true);
        }
      }

      // Free-ending terminal arborization with synaptic bouton bouquet
      const rootNeuron = cl[Math.floor(Math.random() * cl.length)];
      createTerminalBranch(rootNeuron);

      // Sparse inter-cluster projection: only ~30% of clusters send an ascending/descending fiber
      if (clIdx < clusters.length - 1 && Math.random() < 0.30) {
        const nextCl = clusters[clIdx + 1];
        const fromN = cl[cl.length - 1];
        const toN = nextCl[0];
        const dist = Math.hypot(toN.docX - fromN.docX, toN.docY - fromN.docY);
        if (dist < 320) {
          createAxon(fromN, toN, true);
        }
      }
    });

    return {
      neurons,
      axons,
      terminalBranches,
      pulses,
      nextPulse: performance.now() + 2000 + Math.random() * 4000
    };
  }

  // 3. Bioluminescent Drift Spores (Subtle & Quiet)
  function createSpore(side, initial = false) {
    const isLeft = side === 'left';
    const minX = isLeft ? 16 : contentRight + 20;
    const maxX = isLeft ? contentLeft - 20 : width - 16;
    const rangeX = Math.max(10, maxX - minX);

    return {
      side: side,
      x: minX + Math.random() * rangeX,
      y: initial ? Math.random() * height : height + 10 + Math.random() * 40,
      vx: (Math.random() - 0.5) * 0.18,
      vy: -0.20 - Math.random() * 0.22,
      wobbleSpeed: 0.009 + Math.random() * 0.010,
      wobbleAmp: 0.4 + Math.random() * 0.5,
      wobblePhase: Math.random() * Math.PI * 2,
      life: initial ? Math.floor(Math.random() * 400) : 0,
      maxLife: 480 + Math.random() * 280,
      radius: 1.1 + Math.random() * 1.2
    };
  }

  let cachedDocHeight = 0;

  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    width = window.innerWidth;
    height = window.innerHeight;
    canvas.width = width * dpr;
    canvas.height = height * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    const contentMaxW = Math.min(width, 1120);
    gutterWidth = Math.max(60, (width - contentMaxW) / 2);
    contentLeft = (width - contentMaxW) / 2;
    contentRight = width - contentLeft;

    if (gutterWidth >= 70) {
      cachedDocHeight = Math.max(
        document.documentElement.scrollHeight,
        document.body.scrollHeight,
        height * 2
      );

      const leftNet = buildGutterNetwork('left', gutterWidth, contentLeft, cachedDocHeight);
      leftMesh.neurons = leftNet.neurons;
      leftMesh.axons = leftNet.axons;
      leftMesh.terminalBranches = leftNet.terminalBranches;
      leftMesh.pulses = leftNet.pulses;
      leftMesh.nextPulse = leftNet.nextPulse;

      const rightNet = buildGutterNetwork('right', gutterWidth, contentRight, cachedDocHeight);
      rightMesh.neurons = rightNet.neurons;
      rightMesh.axons = rightNet.axons;
      rightMesh.terminalBranches = rightNet.terminalBranches;
      rightMesh.pulses = rightNet.pulses;
      rightMesh.nextPulse = rightNet.nextPulse;

      gutterSparks.length = 0;
      for (let i = 0; i < 4; i++) {
        gutterSparks.push(createSpore('left', true));
        gutterSparks.push(createSpore('right', true));
      }
    } else {
      leftMesh.neurons.length = 0;
      leftMesh.axons.length = 0;
      leftMesh.terminalBranches.length = 0;
      rightMesh.neurons.length = 0;
      rightMesh.axons.length = 0;
      rightMesh.terminalBranches.length = 0;
      gutterSparks.length = 0;
    }
  }

  // Trigger Sinuous Action Potential Wave (Exact Hero Conduction Physics)
  function triggerGutterWave(mesh, axon) {
    if (!axon) return;
    mesh.pulses.push({
      fromId: axon.fromId,
      toId: axon.toId,
      axon: axon,
      progress: 0.0,
      speed: 0.022 + Math.random() * 0.010,
      energy: 0.95
    });
  }

  window.addEventListener('resize', resize, { passive: true });
  window.addEventListener('load', () => {
    const curH = Math.max(document.documentElement.scrollHeight, document.body.scrollHeight, height * 2);
    if (Math.abs(curH - cachedDocHeight) > 200) {
      resize();
    }
  }, { passive: true });

  resize();

  let time = 0;

  // Render loop
  function render(now) {
    ctx.clearRect(0, 0, width, height);

    time += 0.005;
    const currentScrollY = window.scrollY;

    if (gutterWidth >= 70) {
      // Check if index hero is present and visible (never compete with hero's own synaptic field)
      const heroEl = document.getElementById('hero') || document.getElementById('synaptic-field');
      let heroFade = 1.0;

      if (heroEl) {
        const heroRect = heroEl.getBoundingClientRect();
        if (heroRect.bottom > 0) {
          heroFade = 0;
        } else {
          heroFade = Math.max(0, Math.min(1.0, -heroRect.bottom / 200));
        }
      }

      if (heroFade <= 0.001) {
        requestAnimationFrame(render);
        return;
      }

      ctx.save();
      ctx.globalAlpha = heroFade;

      // Render Left and Right Histological Meshes
      [leftMesh, rightMesh].forEach(mesh => {
        if (!mesh.neurons.length) return;

        // 1. Update positions anchored to document coordinates with natural scroll & drift
        // Viewport culling: only keep active map of neurons in/near viewport
        const visibleNeuronMap = new Map();

        for (let i = 0; i < mesh.neurons.length; i++) {
          const n = mesh.neurons[i];
          n.driftPhase += n.driftSpeed;
          const driftX = Math.cos(n.driftPhase) * n.driftRadius;
          const driftY = Math.sin(n.driftPhase) * n.driftRadius;

          n.x = n.docX + driftX;
          n.y = n.docY - currentScrollY + driftY;

          // Culling window [-120, height + 120]
          if (n.y >= -120 && n.y <= height + 120) {
            visibleNeuronMap.set(n.id, n);

            // Cursor proximity (membrane depolarization)
            if (mouse.active) {
              const dist = Math.hypot(mouse.x - n.x, mouse.y - n.y);
              if (dist < 120) {
                const stimulus = Math.pow(1 - dist / 120, 2) * 0.02;
                n.potential = Math.min(1.0, n.potential + stimulus);
                if (dist < 45 && n.refractory <= 0) {
                  const connectedAxon = mesh.axons.find(a => a.fromId === n.id || a.toId === n.id);
                  if (connectedAxon) {
                    triggerGutterWave(mesh, connectedAxon);
                  }
                  n.refractory = 250;
                }
              }
            }

            if (n.refractory > 0) n.refractory--;
            n.potential *= 0.985;
            if (n.spikeEnergy > 0) n.spikeEnergy *= 0.90;
          }
        }

        // Spontaneous Serene Conduction Wave among currently visible axons
        if (now > mesh.nextPulse) {
          const visibleAxons = [];
          for (let a = 0; a < mesh.axons.length; a++) {
            const ax = mesh.axons[a];
            const fn = visibleNeuronMap.get(ax.fromId);
            const tn = visibleNeuronMap.get(ax.toId);
            if (fn && tn && fn.y >= -30 && fn.y <= height + 30) {
              visibleAxons.push(ax);
            }
          }
          if (visibleAxons.length > 0) {
            const randomAxon = visibleAxons[Math.floor(Math.random() * visibleAxons.length)];
            triggerGutterWave(mesh, randomAxon);
          }
          mesh.nextPulse = now + 5000 + Math.random() * 7000;
        }

        // A. Render Taut Curvilinear Axons (Gentle normal-vector bowing; no S-curves)
        mesh.axons.forEach(a => {
          const fn = visibleNeuronMap.get(a.fromId);
          const tn = visibleNeuronMap.get(a.toId);
          if (!fn || !tn) return;

          const cp = getAxonControlPoints(fn, tn, a);
          a.cp = cp;

          const activeCharge = Math.max(fn.potential, tn.potential);

          ctx.beginPath();
          ctx.moveTo(fn.x, fn.y);
          ctx.bezierCurveTo(cp.cp1x, cp.cp1y, cp.cp2x, cp.cp2y, tn.x, tn.y);

          // Resting axon stroke matched to index hero (0.075)
          if (activeCharge > 0.15) {
            ctx.strokeStyle = `rgba(217, 119, 6, ${0.12 + activeCharge * 0.35})`;
            ctx.lineWidth = 0.8 + activeCharge * 0.3;
          } else {
            ctx.strokeStyle = a.isCollateral ? 'rgba(175, 165, 155, 0.05)' : 'rgba(170, 160, 150, 0.075)';
            ctx.lineWidth = a.isCollateral ? 0.45 : 0.6;
          }
          ctx.stroke();

          // Render micro synaptic boutons along axon
          for (let b = 0; b < a.boutons.length; b++) {
            const bt = a.boutons[b].t;
            const bPt = getCubicPoint(fn.x, fn.y, cp.cp1x, cp.cp1y, cp.cp2x, cp.cp2y, tn.x, tn.y, bt);

            // Bouton excitation check
            let boutonPulse = 0;
            for (let p = 0; p < mesh.pulses.length; p++) {
              const pulse = mesh.pulses[p];
              if (pulse.axon === a) {
                const distToBouton = Math.abs(pulse.progress - bt);
                if (distToBouton < 0.16) {
                  boutonPulse = Math.max(boutonPulse, (1 - distToBouton / 0.16) * pulse.energy);
                }
              }
            }

            ctx.beginPath();
            ctx.arc(bPt.x, bPt.y, a.boutons[b].radius, 0, Math.PI * 2);

            if (boutonPulse > 0.05) {
              ctx.fillStyle = `rgba(13, 148, 136, ${0.25 + boutonPulse * 0.6})`;
            } else if (activeCharge > 0.15) {
              ctx.fillStyle = `rgba(217, 119, 6, ${0.20 + activeCharge * 0.35})`;
            } else {
              ctx.fillStyle = 'rgba(170, 162, 154, 0.08)';
            }
            ctx.fill();
          }
        });

        // B. Render Free-Ending Terminal Axonal Arborizations (Cajal Synaptic Bouquets)
        mesh.terminalBranches.forEach(tb => {
          const fn = visibleNeuronMap.get(tb.neuronId);
          if (!fn) return;

          const tipX = fn.x + tb.dx2;
          const tipY = fn.y + tb.dy2;
          const midX = fn.x + tb.dx1;
          const midY = fn.y + tb.dy1;

          ctx.beginPath();
          ctx.moveTo(fn.x, fn.y);
          ctx.quadraticCurveTo(midX, midY, tipX, tipY);

          if (fn.potential > 0.15) {
            ctx.strokeStyle = `rgba(217, 119, 6, ${0.12 + fn.potential * 0.30})`;
            ctx.lineWidth = 0.75;
          } else {
            ctx.strokeStyle = 'rgba(175, 165, 155, 0.055)';
            ctx.lineWidth = 0.50;
          }
          ctx.stroke();

          // Terminal Twigs and Boutons
          tb.twigs.forEach(tw => {
            const bx = fn.x + tw.dx;
            const by = fn.y + tw.dy;

            ctx.beginPath();
            ctx.moveTo(tipX, tipY);
            ctx.lineTo(bx, by);
            ctx.strokeStyle = fn.potential > 0.15
              ? `rgba(217, 119, 6, ${0.15 + fn.potential * 0.25})`
              : 'rgba(175, 165, 155, 0.055)';
            ctx.lineWidth = 0.45;
            ctx.stroke();

            // Terminal synaptic bouton
            ctx.beginPath();
            ctx.arc(bx, by, tw.boutonR, 0, Math.PI * 2);
            if (fn.spikeEnergy > 0.1) {
              ctx.fillStyle = `rgba(13, 148, 136, ${0.30 + fn.spikeEnergy * 0.5})`;
            } else if (fn.potential > 0.15) {
              ctx.fillStyle = `rgba(217, 119, 6, ${0.20 + fn.potential * 0.30})`;
            } else {
              ctx.fillStyle = 'rgba(170, 162, 154, 0.08)';
            }
            ctx.fill();
          });
        });

        // C. Render Somas & Dendritic Spines (Exact Hero Cytology)
        visibleNeuronMap.forEach(n => {
          if (n.y < -80 || n.y > height + 80) return;
          drawSoftHistologicalSoma(ctx, n.x, n.y, n.radius, n.angle, n.potential, n.spikeEnergy, n.type);
        });

        // D. Render Traveling Axonal Conduction Waves (Exact Hero 12-Segment Tapered Emerald Wave)
        for (let p = mesh.pulses.length - 1; p >= 0; p--) {
          const pulse = mesh.pulses[p];
          pulse.progress += pulse.speed;

          const fn = visibleNeuronMap.get(pulse.fromId);
          const tn = visibleNeuronMap.get(pulse.toId);
          const cp = pulse.axon.cp;

          if (!fn || !tn || !cp) {
            mesh.pulses.splice(p, 1);
            continue;
          }

          const waveLen = 0.30;
          const headT = Math.min(1.0, pulse.progress);
          const tailT = Math.max(0.0, pulse.progress - waveLen);

          if (headT > tailT) {
            const steps = 12;
            let prev = null;
            for (let s = 0; s <= steps; s++) {
              const fraction = s / steps;
              const t = tailT + (headT - tailT) * fraction;
              const pt = getCubicPoint(fn.x, fn.y, cp.cp1x, cp.cp1y, cp.cp2x, cp.cp2y, tn.x, tn.y, t);

              if (prev) {
                const segAlpha = Math.pow(fraction, 1.6) * 0.80 * pulse.energy;
                ctx.beginPath();
                ctx.moveTo(prev.x, prev.y);
                ctx.lineTo(pt.x, pt.y);
                // Emerald fluid conduction wave (identical to hero)
                ctx.strokeStyle = `rgba(13, 148, 136, ${segAlpha})`;
                ctx.lineWidth = 0.7 + fraction * 0.75;
                ctx.stroke();
              }
              prev = pt;
            }
          }

          if (pulse.progress >= 1.0) {
            const target = visibleNeuronMap.get(pulse.toId);
            if (target) {
              target.potential = Math.min(1.0, target.potential + 0.4 * pulse.energy);
              target.spikeEnergy = 0.65 * pulse.energy;
            }
            mesh.pulses.splice(p, 1);
          }
        }
      });

      // 3. Render Bioluminescent Spores (Subtle & Quiet)
      for (let i = gutterSparks.length - 1; i >= 0; i--) {
        const s = gutterSparks[i];
        s.life++;
        s.wobblePhase += s.wobbleSpeed;
        s.x += s.vx + Math.sin(s.wobblePhase) * s.wobbleAmp;
        s.y += s.vy;

        if (s.side === 'left' && s.x > contentLeft - 16) {
          s.x = contentLeft - 16;
          s.vx = -Math.abs(s.vx);
        } else if (s.side === 'right' && s.x < contentRight + 16) {
          s.x = contentRight + 16;
          s.vx = Math.abs(s.vx);
        }

        const progress = s.life / s.maxLife;
        const alpha = Math.sin(progress * Math.PI) * 0.28;

        if (alpha > 0.01) {
          ctx.beginPath();
          ctx.arc(s.x, s.y, s.radius, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(13, 148, 136, ${alpha})`;
          ctx.fill();

          ctx.beginPath();
          ctx.arc(s.x, s.y, s.radius * 2.8, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(13, 148, 136, ${alpha * 0.14})`;
          ctx.fill();
        }

        if (s.life >= s.maxLife || s.y < -20) {
          gutterSparks.splice(i, 1);
          gutterSparks.push(createSpore(s.side, false));
        }
      }

      ctx.restore();
    }

    requestAnimationFrame(render);
  }

  requestAnimationFrame(render);
})();
</script>
