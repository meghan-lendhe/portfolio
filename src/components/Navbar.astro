---
interface Props {
  theme?: 'light' | 'dark';
}

const { theme = 'light' } = Astro.props;
---

<!-- Monograph Masthead Corner Folio -->
<header class="fixed inset-x-0 top-6 z-40 pointer-events-none px-6 md:px-10">
  <div class="mx-auto flex max-w-page items-center justify-between">
    <!-- Top Left: Cajal Colophon Seal (Motif 1) & Identity -->
    <a
      href="/"
      class="pointer-events-auto group flex items-center gap-3 rounded-full border border-neutral-200/80 bg-[#FAF9F5]/90 backdrop-blur-md px-3.5 py-2 shadow-[0_2px_8px_rgba(0,0,0,0.03)] transition-all duration-200 hover:border-neutral-300 hover:text-amber-700 focus-visible:outline-2 focus-visible:outline-amber-700"
    >
      <!-- Cajal Pyramidal Neuron Motif 1 Vignette with Active Bouton Pulse -->
      <svg viewBox="0 0 32 32" class="size-4 shrink-0 text-neutral-800 group-hover:text-amber-700 transition-colors" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
        <path d="M16 2v10M16 12l-5 6h10l-5-6ZM11 18l-4 8M21 18l4 8M16 18v12M14 26h4" />
        <circle cx="16" cy="14" r="1.5" class="fill-current group-hover:fill-amber-600 transition-colors" />
      </svg>
      <span class="font-mono text-[10px] tracking-[0.28em] uppercase text-neutral-900 group-hover:text-amber-700 transition-colors">
        Meghan Lendhe
      </span>
    </a>

    <!-- Top Right: Minimalist Editorial Menu Trigger -->
    <button
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="folio-drawer"
      aria-label="Open menu"
      class="pointer-events-auto group flex items-center gap-3 rounded-full border border-neutral-200/80 bg-[#FAF9F5]/90 backdrop-blur-md px-4 py-2 font-mono text-[10px] tracking-widest uppercase text-neutral-900 shadow-[0_2px_8px_rgba(0,0,0,0.03)] transition-all duration-200 hover:border-neutral-300 hover:text-amber-700 focus-visible:outline-2 focus-visible:outline-amber-700"
    >
      <span>Menu</span>
      <div class="flex flex-col gap-1 w-3.5" aria-hidden="true">
        <span class="h-px w-full bg-current transition-transform"></span>
        <span class="h-px w-2.5 ml-auto bg-current transition-transform group-hover:w-full"></span>
      </div>
    </button>
  </div>

  <!-- Editorial Monograph Drawer -->
  <div
    id="folio-drawer"
    hidden
    class="pointer-events-auto fixed inset-0 z-50 flex justify-end bg-neutral-950/20 backdrop-blur-sm transition-opacity duration-300"
  >
    <div class="relative flex h-full w-full max-w-lg flex-col justify-between border-l border-neutral-200 bg-[#FAF9F5] p-8 sm:p-12 shadow-2xl overflow-y-auto">
      
      <!-- Drawer Header with Minimal Close Button -->
      <div class="flex items-center justify-end pb-4 border-b border-neutral-200/60">
        <button
          type="button"
          data-menu-close
          aria-label="Close menu"
          class="group flex items-center gap-2 font-mono text-[10px] tracking-widest uppercase text-neutral-600 hover:text-amber-800 transition-colors focus-visible:outline-2 focus-visible:outline-amber-800"
        >
          <span>Close</span>
          <span class="text-neutral-400 group-hover:text-amber-800 transition-colors font-mono text-sm leading-none">×</span>
        </button>
      </div>

      <!-- Navigation Links with Subtitle One-Liners -->
      <nav aria-label="Portfolio navigation" class="my-auto py-6">
        <div class="flex flex-col gap-6">
          <a
            href="/"
            data-menu-link
            class="group flex flex-col transition-luxury group-hover:translate-x-1"
          >
            <span class="font-serif text-2xl sm:text-3xl font-normal text-neutral-950 group-hover:text-amber-800 transition-colors">Overview</span>
            <span class="font-sans text-xs text-neutral-600 font-normal mt-0.5">Product design &amp; NeuroHCI research</span>
          </a>

          <a
            href="/vitals"
            data-menu-link
            class="group flex flex-col transition-luxury group-hover:translate-x-1"
          >
            <span class="font-serif text-2xl sm:text-3xl font-normal text-neutral-950 group-hover:text-amber-800 transition-colors">Vitals</span>
            <span class="font-sans text-xs text-neutral-600 font-normal mt-0.5">Emergency digital medical ID onboarding</span>
          </a>

          <a
            href="/bulkmagic"
            data-menu-link
            class="group flex flex-col transition-luxury group-hover:translate-x-1"
          >
            <span class="font-serif text-2xl sm:text-3xl font-normal text-neutral-950 group-hover:text-amber-800 transition-colors">BulkMagic</span>
            <span class="font-sans text-xs text-neutral-600 font-normal mt-0.5">Adaptive compliance onboarding sprint &amp; proof of concept</span>
          </a>

          <a
            href="/omara"
            data-menu-link
            class="group flex flex-col transition-luxury group-hover:translate-x-1"
          >
            <span class="font-serif text-2xl sm:text-3xl font-normal text-neutral-950 group-hover:text-amber-800 transition-colors">Omara Technologies</span>
            <span class="font-sans text-xs text-neutral-600 font-normal mt-0.5">GovTech welfare systems &amp; design automation tooling</span>
          </a>
        </div>
      </nav>

      <!-- Drawer Footer Contact Details: Direction A (Intent Micro-Prose & Pure Typography) -->
      <div class="border-t border-neutral-200 pt-6 space-y-3.5">
        <p class="font-sans text-xs text-neutral-600 font-normal leading-relaxed">
          Open for product design roles &amp; research collaborations.
        </p>
        <div>
          <a
            href="mailto:meghanlendhe@gmail.com"
            class="action-potential-link group inline-flex items-center gap-2 pb-1 font-serif text-xl sm:text-2xl font-normal text-neutral-950 hover:text-amber-800 transition-luxury"
          >
            <span>meghanlendhe@gmail.com</span>
            <span class="text-xs font-mono text-neutral-400 group-hover:text-amber-800 group-hover:translate-x-1 transition-luxury">→</span>
          </a>
        </div>
        <div class="flex items-center justify-between text-xs font-mono text-neutral-600 pt-0.5">
          <a
            href="https://www.linkedin.com/in/meghanlendhe/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1 text-neutral-600 hover:text-amber-800 transition-colors font-medium"
          >
            <span>LinkedIn</span>
            <span class="text-neutral-400">↗</span>
          </a>
          <span class="text-[10px] text-neutral-400 uppercase tracking-widest font-medium">Mumbai, India</span>
        </div>
      </div>
    </div>
  </div>
</header>

<script is:inline>
(function() {
  const toggleBtn = document.querySelector('[data-menu-toggle]');
  const closeBtn = document.querySelector('[data-menu-close]');
  const drawer = document.getElementById('folio-drawer');

  function openDrawer() {
    if (drawer) {
      drawer.hidden = false;
      toggleBtn && toggleBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      if (window.NeuroAudio) window.NeuroAudio.playMallet(0.028);
    }
  }

  function closeDrawer() {
    if (drawer) {
      drawer.hidden = true;
      toggleBtn && toggleBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      if (window.NeuroAudio) window.NeuroAudio.playMallet(0.022);
    }
  }

  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', () => {
      if (drawer.hidden) openDrawer();
      else closeDrawer();
    });
  }

  if (closeBtn) {
    closeBtn.addEventListener('click', closeDrawer);
  }

  if (drawer) {
    drawer.addEventListener('click', (e) => {
      if (e.target === drawer) closeDrawer();
    });
  }

  document.querySelectorAll('[data-menu-link]').forEach(link => {
    link.addEventListener('click', () => {
      if (window.NeuroAudio) window.NeuroAudio.playCelesta(587.33, 0.035);
      closeDrawer();
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer && !drawer.hidden) {
      closeDrawer();
      toggleBtn && toggleBtn.focus();
    }
  });
})();
</script>
